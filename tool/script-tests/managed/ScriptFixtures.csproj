<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../script/VulkanLearn.Runtime/VulkanLearn.Runtime.csproj"/>
    <Compile Condition="'$(VulkanLearnSourceItems)' == ''"
             Include="$(VulkanLearnResourceRoot)/Common/**/*.cs;$(VulkanLearnResourceRoot)/Maps/**/*.cs"
             Exclude="**/bin/**;**/obj/**;**/Generated/**;**/.git/**"
             Link="Gameplay/%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>
  <Import Project="$(VulkanLearnSourceItems)" Condition="'$(VulkanLearnSourceItems)' != ''" />
  <!-- GunOutlineDemo.blueprint.cs still targets the retired MaterialInstance/GetMaterial API.
       Exclude it until the resource asset is repaired; otherwise the whole fixture build fails. -->
  <ItemGroup>
    <Compile Remove="$(VulkanLearnResourceRoot)/Common/Blueprints/GunOutlineDemo.blueprint.cs" />
  </ItemGroup>
</Project>
