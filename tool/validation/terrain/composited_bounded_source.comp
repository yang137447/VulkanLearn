#version 450
#extension GL_GOOGLE_include_directive : require
#define main ProductionBakeMain
#include "bounded-production.glsl"
#undef main
#define dFdx(value) vec2(0)
#define dFdy(value) vec2(0)
#include "materialFunction/mf_terrainCompositedVT.glsl"
#undef dFdx
#undef dFdy
#include "materialFunction/terrainHeightAtlas.glsl"
#include "composited_height_source_reference.glsl"

layout(set=0,binding=13) uniform sampler2DArray testPageTable;
layout(set=0,binding=14) uniform sampler2DArray testAlbedo;
layout(set=0,binding=15) uniform sampler2DArray testNormal;
layout(set=0,binding=16) uniform sampler2DArray testOrm;
layout(set=0,binding=17) uniform sampler2DArray testHeight;
layout(set=0,binding=18) uniform sampler2D testHeightMap;

void SourceTexel(ivec2 texel, vec2 extent, out vec3 colour, out vec3 normal, out vec3 orm)
{
    colour=vec3(0); normal=vec3(0); orm=vec3(0);
    for(int row=0;row<4;++row)
        for(int column=0;column<4;++column)
        {
            vec2 uv=clamp((vec2(texel)+(vec2(column,row)+0.5)/4.0)/extent,0.0,1.0);
            vec3 sourceColour,sourceNormal,sourceOrm;
            EvaluateBase(uv,1.0/(extent*4.0),sourceColour,sourceNormal,sourceOrm);
            colour+=sourceColour/16.0;
            normal+=sourceNormal/16.0;
            orm+=vec3(sourceOrm.r,sourceOrm.g*sourceOrm.g,sourceOrm.b)/16.0;
        }
    normal=normalize(normal);
    orm.g=sqrt(orm.g);
}

void SourceMip(vec2 uv, int mip, out vec3 colour, out vec3 normal, out vec3 orm)
{
    vec2 extent=vec2(256,128)/exp2(float(mip));
    vec2 position=clamp(uv*extent,vec2(0.5),extent-0.5)-0.5;
    ivec2 base=ivec2(floor(position));
    vec2 blend=fract(position);
    colour=vec3(0); normal=vec3(0); orm=vec3(0);
    for(int row=0;row<2;++row)
        for(int column=0;column<2;++column)
        {
            vec3 sourceColour,sourceNormal,sourceOrm;
            SourceTexel(base+ivec2(column,row),extent,sourceColour,sourceNormal,sourceOrm);
            float weight=(column==0?1.0-blend.x:blend.x)*(row==0?1.0-blend.y:blend.y);
            colour+=sourceColour*weight;
            normal+=sourceNormal*weight;
            orm+=sourceOrm*weight;
        }
    normal=normalize(normal);
}

void main()
{
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(pixel,uvec2(136))))return;
    vec2 uv=(vec2(pixel)-3.5)/128.0;
    if(pixel.y<32u)
        uv.x=0.5+(float(pixel.x)-67.5)/32768.0;
    float target=float(pixel.y%5u)*0.25;
    TerrainCompositedVTResult actual=MF_TerrainCompositedVTAtMip(
        testPageTable,testAlbedo,testNormal,testOrm,uv,vec2(256,128),1.0,
        0.0,0.0,mat3(1),target);
    vec3 lowColour,lowNormal,lowOrm,highColour,highNormal,highOrm;
    SourceMip(uv,0,lowColour,lowNormal,lowOrm);
    SourceMip(uv,1,highColour,highNormal,highOrm);
    vec3 referenceColour=mix(lowColour,highColour,target);
    vec3 referenceNormal=normalize(mix(lowNormal,highNormal,target));
    vec3 referenceOrm=mix(lowOrm,highOrm,target);
    uint texel=pixel.y*136u+pixel.x;
    outputPage.words[texel]=packUnorm4x8(vec4(TerrainCompositedLinearToSrgb(actual.albedo.rgb),actual.valid));
    outputPage.words[TexelCount+texel]=packUnorm4x8(vec4(actual.normalWorld*0.5+0.5,1));
    outputPage.words[2u*TexelCount+texel]=packUnorm4x8(vec4(actual.orm.rgb,1));
    outputPage.words[3u*TexelCount+texel]=packUnorm4x8(vec4(TerrainCompositedLinearToSrgb(referenceColour),1));
    outputPage.words[4u*TexelCount+texel]=packUnorm4x8(vec4(referenceNormal*0.5+0.5,1));
    outputPage.words[5u*TexelCount+texel]=packUnorm4x8(vec4(referenceOrm,1));
    uint globalLayer=pixel.x%2u==0u?13u:207u;
    uint slice=pixel.x%2u==0u?0u:1u;
    vec2 heightUv=(vec2(pixel)-4.0)/64.0;
    if(pixel.y<16u)heightUv=vec2(0.5+(float(pixel.x)-67.5)/65536.0,0.5);
    if(pixel.y>=16u&&pixel.y<32u)heightUv=vec2((float(pixel.x)-67.5)/65536.0,1.0);
    outputPage.words[6u*TexelCount+texel]=floatBitsToUint(
        SampleTerrainHeightAtlas(testHeight,testHeightMap,globalLayer,heightUv));
    outputPage.words[7u*TexelCount+texel]=floatBitsToUint(
        TestSourceBilinear(layerHeight,heightUv,int(slice),2));
    outputPage.words[8u*TexelCount+texel]=floatBitsToUint(
        textureLod(layerHeight,vec3(heightUv,float(slice)),2.0).r);
    outputPage.words[9u*TexelCount+texel]=floatBitsToUint(heightUv.x);
    outputPage.words[10u*TexelCount+texel]=floatBitsToUint(heightUv.y);
}
