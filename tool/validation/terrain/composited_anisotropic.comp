#version 450
#extension GL_GOOGLE_include_directive : require
#define dFdx(value) vec2(0.0)
#define dFdy(value) vec2(0.0)
#include "materialFunction/mf_terrainCompositedVT.glsl"
#include "materialFunction/terrainCompositedFeedback.glsl"
#undef dFdx
#undef dFdy

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 1) buffer Output { uint words[]; } outputPage;
layout(set = 0, binding = 13) uniform sampler2DArray testPageTable;
layout(set = 0, binding = 14) uniform sampler2DArray testAlbedo;
layout(set = 0, binding = 15) uniform sampler2DArray testNormal;
layout(set = 0, binding = 16) uniform sampler2DArray testOrm;

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, uvec2(136))))
        return;
    const vec2 gradientX[12] = vec2[12](
        vec2(0), vec2(2, 0), vec2(8, 0), vec2(1, 0),
        vec2(5.65685425), vec2(5, 0), vec2(128, 0), vec2(8, 0),
        vec2(2, 0), vec2(-4, 0), vec2(0, 4), vec2(0.25, 0));
    const vec2 gradientY[12] = vec2[12](
        vec2(0), vec2(0, 2), vec2(0, 1), vec2(0, 8),
        vec2(-0.70710678, 0.70710678), vec2(5, 1), vec2(0, 0.25), vec2(0, 1.41421356),
        vec2(0, 1), vec2(0, -1), vec2(-1, 0), vec2(0, 0.125));
    vec2 uv = vec2(0.5 + (float(pixel.x) - 67.5) / 32768.0, 0.37);
    if (pixel.x % 3u == 1u)
        uv.x = (float(pixel.x) - 67.5) / 32768.0;
    if (pixel.x % 3u == 2u)
        uv.x = 1.0 + (float(pixel.x) - 67.5) / 32768.0;
    vec2 resolution = vec2(256, 128);
    vec2 uvDx = gradientX[pixel.y % 12u] / resolution;
    vec2 uvDy = gradientY[pixel.y % 12u] / resolution;
    TerrainCompositedFootprint footprint =
        TerrainCompositedFootprintFromGradients(uvDx, uvDy, resolution, 1.0);
    TerrainCompositedFootprint feedback = TerrainCompositedFeedbackFootprintFromGradients(
        uvDx * 15.0, uvDy * 8.4375, resolution, 1.0, vec2(15, 8.4375));
    float repeatMode = pixel.y >= 68u ? 1.0 : 0.0;
    TerrainCompositedVTResult actual = MF_TerrainCompositedVTAtFootprint(
        testPageTable, testAlbedo, testNormal, testOrm, uv, resolution, 1.0,
        repeatMode, 0.0, mat3(1), footprint);
    float oldMip = clamp(log2(max(length(gradientX[pixel.y % 12u]),
        length(gradientY[pixel.y % 12u]))), 0.0, 1.0);
    TerrainCompositedVTResult isotropic = MF_TerrainCompositedVTAtMip(
        testPageTable, testAlbedo, testNormal, testOrm, uv, resolution, 1.0,
        repeatMode, 0.0, mat3(1), oldMip);
    uint texel = pixel.y * 136u + pixel.x;
    const uint plane = 18496u;
    outputPage.words[texel] = packUnorm4x8(actual.albedo);
    outputPage.words[plane + texel] = packUnorm4x8(vec4(actual.normalWorld * 0.5 + 0.5, 1));
    outputPage.words[2u * plane + texel] = packUnorm4x8(actual.orm);
    outputPage.words[3u * plane + texel] = floatBitsToUint(footprint.targetMip);
    outputPage.words[4u * plane + texel] = floatBitsToUint(float(footprint.tapCount));
    outputPage.words[5u * plane + texel] = floatBitsToUint(footprint.majorUv.x);
    outputPage.words[6u * plane + texel] = floatBitsToUint(footprint.majorUv.y);
    outputPage.words[7u * plane + texel] = floatBitsToUint(feedback.targetMip);
    outputPage.words[8u * plane + texel] = floatBitsToUint(actual.valid);
    outputPage.words[9u * plane + texel] = packUnorm4x8(isotropic.albedo);
    outputPage.words[10u * plane + texel] = floatBitsToUint(float(feedback.tapCount));
}
