#version 450
#extension GL_GOOGLE_include_directive : require

#include "materialFunction/terrainCompositedEvaluation.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, set = 0, binding = 1) buffer Output
{
    uint words[];
} outputPage;
layout(set = 0, binding = 7) uniform sampler2DArray layerAlbedo;
layout(set = 0, binding = 8) uniform sampler2DArray layerNormal;
layout(set = 0, binding = 9) uniform sampler2DArray layerOrm;
layout(set = 0, binding = 12) uniform sampler2DArray layerHeight;

const float Distances[9] = float[9](
    0.0, 7.999, 8.0, 8.001, 26.5, 44.999, 45.0, 45.001, 100.0);

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, uvec2(136))))
        return;
    const float strength = pixel.x % 2u == 0u ? 3.0 : 0.0;
    const bool usePage = true;
    const float fade = 1.0;
    float weights[4] = float[4](
        0.2 + float(pixel.x) / 135.0 * 0.6,
        0.8 - float(pixel.x) / 135.0 * 0.6, 0.0, 0.0);
    float scores[4] = float[4](0.0, 0.0, -1.0e9, -1.0e9);
    if (strength > 0.0)
    {
        for (int layer = 0; layer < 2; ++layer)
        {
            const float height = textureLod(
                layerHeight, vec3(0.5, 0.5, float(layer)), 3.0).r;
            scores[layer] = TerrainCompositedHeightScore(
                height, 1.0, strength, fade, weights[layer]);
        }
        TerrainCompositedHeightWeights(scores, weights);
    }
    vec4 albedo = vec4(0);
    vec4 orm = vec4(0);
    vec3 normal = vec3(0);
    for (int layer = 0; layer < 2; ++layer)
    {
        const vec3 uv = vec3(0.5, 0.5, float(layer));
        TerrainCompositedAccumulate(
            albedo, orm, normal, textureLod(layerAlbedo, uv, 0.0),
            textureLod(layerOrm, uv, 0.0),
            textureLod(layerNormal, uv, 0.0).xyz * 2.0 - 1.0,
            vec3(0, 1, 0), vec4(1, 0, 0, 1), weights[layer]);
    }
    const uint texel = pixel.y * 136u + pixel.x;
    outputPage.words[texel] = packUnorm4x8(vec4(
        TerrainCompositedLinearToSrgb(albedo.rgb), usePage ? 1.0 : 0.0));
    outputPage.words[18496u + texel] = packUnorm4x8(vec4(
        TerrainCompositedNormal(normal, vec3(0, 1, 0)) * 0.5 + 0.5, 1));
    outputPage.words[36992u + texel] = packUnorm4x8(vec4(orm.rgb, 1));
}
