{
  "schema": "vulkanlearn-deps-manifest/v1",
  "manifestVersion": 1,
  "updated": "2026-11-11",
  "purpose": "Machine-wide third-party dependency prefix for VulkanLearn (single-machine, no CI registry).",
  "policy": {
    "sourceKinds": [
      "vendored",
      "fetchcontent",
      "system"
    ],
    "prefixLayout": "D:\\YYBWorkSpace\\VulkanLearn-deps\\<toolchain-id>\\<config>",
    "toolchainIdFormat": "win64-mingw-<gcc-version>-<crt>",
    "lockFile": "ThirdParty/deps.lock",
    "stampFile": "<prefix>/deps-stamp.json",
    "manifestHashInPrefixPath": false,
    "notes": [
      "The prefix stamp consumes ThirdParty/deps.lock (manifest hash, option-set hash, patch-set hash), not the manifest path.",
      "Do not embed the manifest hash in the prefix path; a path hash orphans the prefix on every manifest edit.",
      "resolvedOptions is evidence captured from build-game/CMakeCache.txt on 2026-11-11; it is not a second source of truth.",
      "superbuildRequired records the option table D3 must force when the dependency is built as a root ExternalProject."
    ]
  },
  "superbuildScope": [
    "SDL3",
    "Assimp",
    "OpenEXR",
    "RmlUi",
    "FreeType",
    "Jolt"
  ],
  "featureOptions": [
    {
      "name": "VULKANLEARN_BUILD_ANIMATION_TOOLS",
      "default": "OFF",
      "affects": [
        {
          "dependency": "Assimp",
          "options": {
            "ASSIMP_NO_EXPORT": "OFF",
            "ASSIMP_BUILD_ALL_EXPORTERS_BY_DEFAULT": "OFF",
            "ASSIMP_BUILD_FBX_EXPORTER": "ON"
          }
        }
      ]
    }
