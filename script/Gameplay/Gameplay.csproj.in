<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Gameplay</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VulkanLearnResourceRoot Condition="'$(VulkanLearnResourceRoot)' == ''">@VL_RESOURCE_ROOT_XML@</VulkanLearnResourceRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/.git/**;**/Generated/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="@VL_RUNTIME_PROJECT_XML@" />
  </ItemGroup>
  <ItemGroup Condition="'$(VulkanLearnSourceItems)' == ''">
    <Compile Include="$(VulkanLearnResourceRoot)/Common/**/*.cs;$(VulkanLearnResourceRoot)/Maps/**/*.cs"
             Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>
  <Import Project="$(VulkanLearnSourceItems)" Condition="'$(VulkanLearnSourceItems)' != ''" />
  <!--
    GunOutlineDemo depends on the per-actor MaterialInstance API that still lives
    on codex/gun-outline. Keep the asset in the resource tree, but do not feed
    its orphaned source to this branch's assembly. Set
    -p:VulkanLearnEnableGunOutlineDemo=true after that API merges.
  -->
  <ItemGroup Condition="'$(VulkanLearnEnableGunOutlineDemo)' != 'true'">
    <Compile Remove="$(VulkanLearnResourceRoot)/Common/Blueprints/GunOutlineDemo.blueprint.cs" />
  </ItemGroup>
</Project>
