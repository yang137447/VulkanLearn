{
    "configHelp": {
        "formatSupport": [
            "A2B10G10R10_UNORM_PACK32",
            "R8G8B8A8_SRGB",
            "R8G8B8A8_UNORM",
            "R16G16B16A16_SFLOAT",
            "D16_UNORM",
            "D32_SFLOAT",
            "D24_UNORM_S8_UINT"
        ],
        "usageSupport": [
            "colorAttachment",
            "depthStencilAttachment",
            "sampled",
            "present",
            "transferSrc",
            "transferDst",
            "storage"
        ],
        "loadOpSupport": [
            "clear",
            "load",
            "dontCare"
        ],
        "storeOpSupport": [
            "store",
            "dontCare"
        ],
        "depthCompareOpSupport": [
            "less",
            "lessOrEqual",
            "equal",
            "greater",
            "greaterOrEqual",
            "always"
        ],
        "stencilCompareOpSupport": [
            "never",
            "less",
            "equal",
            "lessOrEqual",
            "greater",
            "notEqual",
            "greaterOrEqual",
            "always"
        ],
        "stencilOpSupport": [
            "keep",
            "zero",
            "replace",
            "incrementAndClamp",
            "decrementAndClamp",
            "invert",
            "incrementAndWrap",
            "decrementAndWrap"
        ],
        "pipelineState": {
            "useVertexInput": "是否使用模型顶点输入。fullscreen/postprocess/sky 这类 pass 通常为 false。",
            "depthTestEnable": "是否开启深度测试。",
            "depthWriteEnable": "是否写入深度。",
            "depthCompareOp": "深度比较函数，取值见 depthCompareOpSupport。",
            "stencil": "可选硬件 stencil 状态。front/back 共用同一组值；未声明时 testEnable=false，旧 pass 状态不变。字段为 testEnable、writeMask、compareMask、reference、compareOp、failOp、depthFailOp、passOp。启用 stencil 的 pass 必须输出 D24_UNORM_S8_UINT 或 D32_SFLOAT_S8_UINT 附件。"
        },
        "pass": {
            "type": "必填 pass 行为类型。当前支持 shadow、localShadow、geometry、forwardOpaque、forwardTransparent、postProcess、editorGrid、autoExposure、decalStencil、decal、particle、distortion；name 只作为唯一身份、缓存 key 和调试标签。"
        },
        "resource": {
            "type": "可选资源类型。默认 texture2D；CSM shadowMap 使用 texture2DArray。",
            "arrayLayers": "texture2DArray 的物理数组层数。CSM 将它作为最大级联容量；场景 directionalLight.shadow.dynamicShadowCascades 决定活动级联数。",
            "clearColor": "可选四分量颜色清除值；未提供时沿用颜色附件默认灰底 0.2,0.2,0.2,1。"
        },
        "output": {
            "resource": "当前 pass 输出的逻辑资源名。",
            "layer": "可选输出数组层。默认 0；CSM shadowCascadeN 使用它选择 shadowMap 的目标层。",
            "loadOp": "attachment 开始时的加载策略。",
            "storeOp": "attachment 结束时的保存策略。",
            "stencilLoadOp": "带 stencil 分量附件的 stencil 加载策略；默认 dontCare。",
            "stencilStoreOp": "带 stencil 分量附件的 stencil 保存策略；默认 dontCare。"
        }
    },
