{
    "formatSupport": [
        "R8G8B8A8_SRGB",
        "R8G8B8A8_UNORM",
        "R16G16B16A16_SFLOAT",
        "D16_UNORM",
        "D32_SFLOAT",
        "D24_UNORM_S8_UINT"
    ],
    "usageSupport": [
        "colorAttachment",
        "depthStencilAttachment",
        "sampled",
        "present",
        "transferSrc",
        "transferDst"
    ],
    "resources":[
        {
            "name": "shadowMap",
            "format": "D32_SFLOAT",
            "widthSize": 2048,
            "heightSize": 2048,
            "usage": ["depthStencilAttachment", "sampled", "transferSrc", "transferDst"]
        },
        {
            "name": "swapChain",
            "format": "R8G8B8A8_SRGB",
            "widthScale": 1.0,
            "heightScale": 1.0,
            "usage": ["colorAttachment", "present"]
        },
        {
            "name": "offscreenColor",
            "format": "R16G16B16A16_SFLOAT",
            "widthScale": 1.0,
            "heightScale": 1.0,
            "usage": ["colorAttachment", "sampled"]
        },
        {
            "name": "sceneColor",
            "format": "R16G16B16A16_SFLOAT",
            "widthScale": 1.0,
            "heightScale": 1.0,
            "usage": ["colorAttachment", "sampled"]
        },
        {
            "name": "bloomDownSample1",
            "format": "R16G16B16A16_SFLOAT",
            "widthScale": 0.5,
            "heightScale": 0.5,
            "usage": ["colorAttachment", "sampled"]
        },
        {
            "name": "bloomDownSample2",
            "format": "R16G16B16A16_SFLOAT",
            "widthScale": 0.25,
            "heightScale": 0.25,
            "usage": ["colorAttachment", "sampled"]
        },
        {
            "name": "bloomUpSample1",
            "format": "R16G16B16A16_SFLOAT",
            "widthScale": 0.5,
            "heightScale": 0.5,
            "usage": ["colorAttachment", "sampled"]
        },
        
        {
            "name": "sceneDepth",
            "format": "D32_SFLOAT",
            "widthScale": 1.0,
            "heightScale": 1.0,
            "usage": ["depthStencilAttachment", "sampled"]
        }
    ],
    "passes":[
        {
            "name": "shadow",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/MI_shadow.json",
            "input": [
            ],
            "output":[
                {
                    "resource": "shadowMap"
                }
            ]
        },
        {
            "name": "geometry",
            "needMsaa": true,
            "input": [
                {
                    "resource": "shadowMap"
                }
            ],
            "output":[
                {
                    "resource": "offscreenColor"
                },
                {
                    "resource": "sceneDepth"
                }
            ]
        },
        {
            "name": "postProcess",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/pass/MI_postProcess.json",
            "bIsPostProcess": true,
            "input": [
                {
                    "resource": "offscreenColor"
                }
            ],
            "output":[
                {
                    "resource": "sceneColor"
                }
            ]
        }
        ,
        {
            "name": "bloomPrefilter",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/pass/MI_bloomPrefilter.json",
            "bIsPostProcess": true,
            "input": [
                {
                    "resource": "sceneColor"
                }
            ],
            "output":[
                {
                    "resource": "bloomDownSample1"
                }
            ]
        },
        {
            "name": "bloomDownsample",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/pass/MI_bloomDownsample.json",
            "bIsPostProcess": true,
            "input": [
                {
                    "resource": "bloomDownSample1"
                }
            ],
            "output":[
                {
                    "resource": "bloomDownSample2"
                }
            ]
        },
        {
            "name": "bloomUpsample",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/pass/MI_bloomUpsample.json",
            "bIsPostProcess": true,
            "input": [
                {
                    "resource": "bloomDownSample2"
                }
            ],
            "output":[
                {
                    "resource": "bloomUpSample1"
                }
            ]
        },
        {
            "name": "toneMapping",
            "needCreateMaterial": true,
            "materialInstancePath": "materials/pass/MI_toneMapping.json",
            "bIsPostProcess": true,
            "input": [
                {
                    "resource": "sceneColor"
                },
                {
                    "resource": "bloomUpSample1"
                }
            ],
            "output":[
                {
                    "resource": "swapChain"
                }
            ]
        }
    ]
}
