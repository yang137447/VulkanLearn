<rml>
    <head>
        <title>VulkanLearn Editor</title>
        <link type="text/rcss" href="widgets/editor-widgets.rcss"/>
        <link type="text/rcss" href="editor-workspace.rcss"/>
    </head>
    <body>
        <div id="editor-toolbar">
            <div id="editor-menubar">
                <div class="menu-root" id="menu-file">
                    <button class="menu-title" id="menu-file-title" data-action="menu-open" data-menu="file">File</button>
                    <div class="menu-popup" id="menu-file-popup">
                        <button class="menu-item" id="menu-file-save" data-action="save-all"><span class="menu-check"></span><span class="menu-label">Save...</span></button>
                        <button class="menu-item" id="menu-file-revert" data-action="revert"><span class="menu-check"></span><span class="menu-label">Revert</span></button>
                        <button class="menu-item" id="menu-file-reload" data-action="reload"><span class="menu-check"></span><span class="menu-label">Reload</span></button>
                        <div class="menu-separator"></div>
                        <div class="menu-entry" id="menu-file-open-level">
                            <button class="menu-item" id="menu-file-open-level-title"><span class="menu-check"></span><span class="menu-label">Open Level</span><span class="menu-arrow">&#9656;</span></button>
                            <div class="menu-popup menu-submenu" id="menu-file-levels"></div>
                        </div>
                        <div class="menu-separator"></div>
                        <button class="menu-item" id="menu-file-exit" data-action="exit-editor"><span class="menu-check"></span><span class="menu-label">Exit</span></button>
                    </div>
                </div>
                <div class="menu-root" id="menu-edit">
                    <button class="menu-title" id="menu-edit-title" data-action="menu-open" data-menu="edit">Edit</button>
                    <div class="menu-popup" id="menu-edit-popup">
                        <button class="menu-item" id="menu-edit-reset" data-action="reset-all"><span class="menu-check"></span><span class="menu-label">Reset All</span></button>
                        <button class="menu-item" id="menu-edit-validate" data-action="validate"><span class="menu-check"></span><span class="menu-label">Validate</span></button>
                        <div class="menu-separator"></div>
                        <button class="menu-item disabled" id="menu-edit-undo" data-action="scene-undo" disabled="disabled"><span class="menu-check"></span><span class="menu-label">Undo</span></button>
                        <button class="menu-item disabled" id="menu-edit-redo" data-action="scene-redo" disabled="disabled"><span class="menu-check"></span><span class="menu-label">Redo</span></button>
                        <div class="menu-separator"></div>
                        <button class="menu-item" id="menu-script-compile" data-action="script-compile"><span class="menu-check"></span><span class="menu-label">Compile C#</span></button>
                        <button class="menu-item" id="menu-script-auto" data-action="script-auto"><span class="menu-check"></span><span class="menu-label">Auto Compile C#</span></button>
                    </div>
                </div>
                <div class="menu-root" id="menu-window">
                    <button class="menu-title" id="menu-window-title" data-action="menu-open" data-menu="window">Window</button>
                    <div class="menu-popup" id="menu-window-popup">
                        <div id="menu-window-panels"></div>
                        <div class="menu-separator"></div>
                        <button class="menu-item" id="menu-window-reset" data-action="menu-reset-layout"><span class="menu-check"></span><span class="menu-label">Reset Layout</span></button>
                        <button class="menu-item" id="menu-window-restore" data-action="menu-restore-layout"><span class="menu-check"></span><span class="menu-label">Restore Saved Layout</span></button>
                    </div>
                </div>
                <div class="menu-root" id="menu-help">
                    <button class="menu-title" id="menu-help-title" data-action="menu-open" data-menu="help">Help</button>
                    <div class="menu-popup" id="menu-help-popup">
                        <button class="menu-item" id="menu-help-about" data-action="about-open"><span class="menu-check"></span><span class="menu-label">About</span></button>
                    </div>
                </div>
            </div>
            <h1>VulkanLearn</h1>
            <!-- 保存图标打开统一文件确认，不直接写盘。 -->
            <div class="toolbar-spacer"></div>
            <button id="script-play" class="browser-icon" data-action="script-control" data-value="1" title="Play"><img src="icons/play.png"/></button>
            <button id="script-pause" class="browser-icon" data-action="script-control" data-value="2" title="Pause"><img src="icons/pause.png"/></button>
            <button id="script-stop" class="browser-icon" data-action="script-control" data-value="0" title="Stop"><img src="icons/stop.png"/></button>
            <button id="script-reload" class="browser-icon" data-action="script-reload" title="Reload C# assembly"><img src="icons/refresh.png"/></button>
            <button id="script-compile" class="browser-icon" data-action="script-compile" title="Compile C# and reload"><img src="icons/blueprint.png"/></button>
            <label id="script-time-label" for="script-time-scale" title="Time Scale">Time</label>
            <input id="script-time-scale" type="text" value="1" data-action="script-time-scale" title="Time Scale (0-100)"/>
            <button id="workspace-save" data-action="save-all" title="Save Modified Assets"><img src="icons/save.png"/></button>
            <button id="workspace-reset" data-action="workspace-reset">Reset Layout</button>
            <button data-action="immersive-view" title="Immersive Mode">Immersive Mode</button>
        </div>

        <div id="editor-content">
            <div id="dock-shell"></div>
            <div id="dock-preview"></div>
            <div id="dock-parking">
                <div id="dock-dynamic-tabs"></div>
                <button id="workspace-viewport-tab" data-workspace-panel="viewport">Viewport</button>
                <button id="workspace-outliner-tab" data-workspace-panel="outliner">Scene Outliner</button>
                <button id="workspace-details-tab" data-workspace-panel="details">Details</button>
                <button id="workspace-content-tab" data-workspace-panel="content" data-action="workspace-content">Content Browser</button>
                <button id="workspace-renderer-tab" data-workspace-panel="renderer" data-action="workspace-renderer">Renderer</button>
                <button id="workspace-log-tab" data-workspace-panel="log">Log</button>
                <button id="workspace-resource-tab" data-workspace-panel="resource" title="Asset Editor">
                    <img id="workspace-resource-icon" src="icons/file-box.png"/>
                    <span id="workspace-resource-label">Asset Editor</span>
                </button>
                <div id="editor-viewport-surface">
                    <img id="editor-viewport-image" src="vl://scene-viewport"/>
                    <div id="viewport-actor-overlay">
                        <div id="viewport-actor-lines"></div>
                        <div id="viewport-actor-icons"></div>
                    </div>
                    <!-- 角落坐标轴指示器：纯 UI 叠层，不参与场景渲染图，也不参与深度。
                         它表达的是**相机当前朝向**（三根杆由相机正交基投影而来），
                         因此与场景里世界原点处的真实三轴是两件不同的东西：
                         那三根会被场景几何遮挡、远看只有约 1px 宽；
                         这里的三根固定大小、始终可见。放左下角：与左上的视口工具条同侧但不同端，不重叠。 -->
                    <div id="viewport-motion-status"></div>
                    <div id="viewport-motion-matching">
                        <div id="motion-matching-title"></div>
                        <div id="motion-matching-database" class="motion-matching-meta"></div>
                        <div class="motion-query-heading">
                            <div id="motion-matching-query" class="motion-matching-meta"></div>
                            <button id="motion-query-toggle" data-action="motion-query-toggle"><img src="icons/list.png"/><span id="motion-query-hint" class="motion-query-hint">Query channels</span></button>
                        </div>
                        <div id="motion-matching-decision" class="motion-matching-meta"></div>
                        <div class="motion-timeline">
                            <button id="motion-timeline-play" class="browser-icon" data-action="motion-timeline-play" title="Play controlled animation"><img src="icons/play.png"/></button>
                            <button id="motion-timeline-pause" class="browser-icon" data-action="motion-timeline-pause" title="Pause controlled animation"><img src="icons/pause.png"/></button>
                            <input id="motion-timeline-seek" type="range" min="0" max="1" step="0.001" value="0" data-action="motion-timeline-seek"/>
                            <span id="motion-timeline-status"></span>
                        </div>
                        <div class="motion-timeline motion-replay-row">
                            <label class="motion-replay-toggle"><input id="motion-replay" type="checkbox" data-action="motion-replay"/><span>Replay</span></label>
                            <input id="motion-replay-seek" type="range" min="0" max="1" step="1" value="0" data-action="motion-replay-seek"/>
                            <span id="motion-replay-status"></span>
                        </div>
                        <div id="motion-matching-cost-labels" class="motion-candidate-costs motion-cost-labels"><span>Trajectory</span><span>Pose</span><span>Policy</span><span>Total</span></div>
                        <div id="motion-matching-rows"></div>
                        <div id="motion-query-details">
                            <div id="motion-query-database" class="motion-query-identity"></div>
                            <div id="motion-query-payload" class="motion-query-identity"></div>
                            <div id="motion-query-component" class="motion-query-identity"></div>
                            <div id="motion-query-channels"></div>
                        </div>
                    </div>
                    <div id="viewport-axis-indicator">
                        <div class="viewport-axis-bar" id="viewport-axis-bar-x"></div>
                        <div class="viewport-axis-bar" id="viewport-axis-bar-y"></div>
                        <div class="viewport-axis-bar" id="viewport-axis-bar-z"></div>
                        <span class="viewport-axis-label" id="viewport-axis-label-x">X</span>
                        <span class="viewport-axis-label" id="viewport-axis-label-y">Y</span>
                        <span class="viewport-axis-label" id="viewport-axis-label-z">Z</span>
                    </div>
                    <div id="viewport-toolbar">
                        <button class="browser-icon" id="viewport-actor-visuals" data-action="viewport-actor-visuals" title="Show light and camera helpers"><img src="icons/eye.png"/></button>
                        <label class="motion-debug-toggle"><input id="viewport-motion-debug" type="checkbox" data-action="motion-debug"/><span id="viewport-motion-label">Motion</span></label>
                        <div class="menu-root" id="menu-debug-draw">
                            <button class="browser-icon menu-title" id="viewport-debug-draw" data-action="menu-open" data-menu="debug-draw" title="Draw Debug"><img src="icons/mesh.png"/></button>
                            <div class="menu-popup" id="debug-draw-popup">
                                <label class="debug-draw-check"><input id="debug-draw-enabled" type="checkbox" data-action="debug-draw-enabled"/><span>Draw Debug</span></label>
                                <select id="debug-draw-owner" data-action="debug-draw-owner"><option value="">All Owners</option></select>
                                <div id="debug-draw-categories"></div>
                                <div class="debug-draw-footer"><span id="debug-draw-count"></span><button class="browser-icon" id="debug-draw-clear" data-action="debug-draw-clear" title="Clear debug drawings"><img src="icons/trash.png"/></button></div>
                            </div>
                        </div>
                        <div class="viewport-tool-group" id="viewport-transform-tools">
                            <button class="viewport-tool" id="viewport-tool-select" data-action="viewport-tool" data-tool="select" title="Select tool">Select</button>
                            <button class="viewport-tool" id="viewport-tool-move" data-action="viewport-tool" data-tool="move" title="Move mode - viewport gizmo is unavailable">Move</button>
                            <button class="viewport-tool" id="viewport-tool-rotate" data-action="viewport-tool" data-tool="rotate" title="Rotate mode - viewport gizmo is unavailable">Rotate</button>
                            <button class="viewport-tool" id="viewport-tool-scale" data-action="viewport-tool" data-tool="scale" title="Scale mode - viewport gizmo is unavailable">Scale</button>
                        </div>
                        <div class="viewport-tool-group" id="viewport-transform-space">
                            <button class="viewport-tool" id="viewport-space-world" data-action="viewport-space" data-space="world" title="World space - presentation only, the renderer does not read it">World</button>
                            <button class="viewport-tool" id="viewport-space-local" data-action="viewport-space" data-space="local" title="Local space - presentation only, the renderer does not read it">Local</button>
                        </div>
                        <div class="viewport-tool-group menu-root" id="menu-view">
                          <button class="menu-title" id="viewport-view-title" data-action="menu-open" data-menu="view">Lit v</button>
                          <div class="menu-popup" id="viewport-view-mode">
                            <button class="viewport-tool" id="viewport-view-lit" data-action="viewport-view-mode" data-mode="0" title="Lit: full shading (debug view 0)">Lit</button>
                            <button class="viewport-tool" id="viewport-view-unlit" data-action="viewport-view-mode" data-mode="1" title="Unlit: base color debug view (debug view 1)">Unlit</button>
                            <button class="viewport-tool disabled" id="viewport-view-wireframe" disabled="disabled" title="Wireframe is not implemented: this renderer has no wireframe raster mode and no wireframe debug view.">Wireframe</button>
                            <div class="menu-separator"></div>
                            <div class="menu-entry">
                              <button class="menu-item"><span class="menu-check"></span><span class="menu-label">Buffer Visualization</span><span class="menu-arrow">&gt;</span></button>
                              <div class="menu-popup menu-submenu" id="viewport-buffer-modes"></div>
                            </div>
                          </div>
                        </div>
                    </div>
                </div>
            <div id="editor-navigation" class="dock-panel">
                <div class="outliner-filterbar">
                    <div class="browser-search">
                        <img src="icons/search.png"/>
                        <input id="outliner-search" type="text" data-action="outliner-search" value="" placeholder="Search actors"/>
                    </div>
                    <select id="outliner-type" data-action="outliner-type">
                        <option value="all">All Actors</option><option value="directionalLight">Directional Lights</option>
                        <option value="pointLight">Point Lights</option>
                        <option value="spotLight">Spot Lights</option><option value="squareAreaLight">Square Area Lights</option>
                        <option value="camera">Cameras</option><option value="environment">Environments</option>
                        <option value="windProfile">SpeedTree Wind Profiles</option>
                        <option value="mesh">Meshes</option>
                        <option value="blueprintInstance">Blueprint Instances</option>
                    </select>
                    <select id="outliner-sort" data-action="outliner-sort">
                        <option value="name-asc">Name A-Z</option><option value="name-desc">Name Z-A</option>
                    </select>
                </div>
                <div id="script-placement">
                    <div class="script-placement-row"><label>Mode</label><select id="script-placement-mode" data-action="script-placement-mode"><option value="place">Place instance</option><option value="create">Create Blueprint Asset</option></select></div>
                    <div id="script-existing-class-row" class="script-placement-row"><label>Class</label><select id="script-class" title="C# gameplay class"></select></div>
                    <div class="script-placement-row"><label>Name</label><input id="script-name" type="text" value="Blueprint" placeholder="Blueprint name"/></div>
                    <div id="script-placement-mesh-row" class="script-placement-row"><label>Mesh</label><input id="script-mesh" type="text" value="" placeholder="Mesh asset path (optional)"/></div>
                    <div id="script-new-path-row" class="script-placement-row"><label>Asset</label><input id="script-new-path" type="text" value="Common/Blueprints/BP_my_blueprint.json" placeholder="Common/Blueprints/BP_my_blueprint.json"/></div>
                    <button id="script-add" class="browser-icon" data-action="script-add" title="Place C# instance"><img src="icons/plus.png"/></button>
                </div>
                <p id="script-feedback" class="notice"></p>
                <div id="scene-models" class="scroll-box"></div>
                <div id="outliner-empty" class="muted">No actors in the active world.</div>
                <div class="outliner-footer"><div id="outliner-count"></div><button id="script-placement-toggle" class="browser-icon" data-action="script-placement-toggle" title="Create or place Blueprint"><img src="icons/plus.png"/></button></div>
            </div>
            <div id="editor-inspector" class="dock-panel">
                <div class="inspector-body">
                    <div id="material-instance-details">
                    <div id="actor-details-content"></div>
                    <div id="material-slots-section">
                        <h3>Material Slots</h3>
                        <div id="material-slots" class="scroll-box"></div>
                    </div>
                    </div>
                    <div id="json-inspector">
                        <div class="json-header">
                            <h3 id="json-title"></h3><span class="json-readonly">Read Only</span>
                            <button class="browser-icon" data-action="json-close" title="Material Details"><img src="icons/arrow-left.png"/></button>
                        </div>
                        <p id="json-kind"></p>
                        <p id="json-path"></p>
                        <p id="json-description"></p>
                        <p id="json-status" class="notice"></p>
                        <input id="json-search" type="text" data-action="json-search" value=""/>
                        <div id="json-fields"></div>
                        <div class="json-pager">
                            <button id="json-prev" class="browser-icon" data-action="json-prev" title="Previous Fields"><img src="icons/arrow-left.png"/></button>
                            <span id="json-page"></span>
                            <button id="json-next" class="browser-icon" data-action="json-next" title="Next Fields"><img src="icons/arrow-right.png"/></button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="content-browser-page" class="dock-panel">
                <div class="browser-toolbar">
                    <button id="browser-sources-toggle" class="browser-icon" data-action="browser-sources-toggle" title="Sources">
                        <img src="icons/panel-left.png"/><span class="browser-tooltip">Sources</span>
                    </button>
                    <button id="browser-back" class="browser-icon" data-action="browser-back" title="Back">
                        <img src="icons/arrow-left.png"/><span class="browser-tooltip">Back</span>
                    </button>
                    <button id="browser-forward" class="browser-icon" data-action="browser-forward" title="Forward">
                        <img src="icons/arrow-right.png"/><span class="browser-tooltip">Forward</span>
                    </button>
                    <button id="browser-up" class="browser-icon" data-action="browser-up" title="Parent Folder">
                        <img src="icons/arrow-up.png"/><span class="browser-tooltip">Parent Folder</span>
                    </button>
                    <button id="browser-refresh" class="browser-icon" data-action="browser-refresh" title="Refresh Assets">
                        <img src="icons/refresh.png"/><span class="browser-tooltip">Refresh Assets</span>
                    </button>
                    <div id="asset-breadcrumbs"></div>
                    <button id="browser-grid" class="browser-icon" data-action="browser-grid" title="Tiles">
                        <img src="icons/layout-grid.png"/><span class="browser-tooltip">Tiles</span>
                    </button>
                    <button id="browser-list" class="browser-icon" data-action="browser-list" title="List">
                        <img src="icons/list.png"/><span class="browser-tooltip">List</span>
                    </button>
                </div>
                <div class="browser-filterbar">
                    <div class="browser-search">
                        <img src="icons/search.png"/>
                        <input id="asset-search" type="text" data-action="asset-search" value="" placeholder="Search assets"/>
                    </div>
                    <select id="browser-type" data-action="browser-type">
                        <option value="all">All Assets</option><option value="material">Materials</option>
                        <option value="blueprint">Blueprints</option>
                        <option value="csharp">C# Blueprint Classes</option>
                        <option value="mesh">Meshes</option><option value="scene">Levels</option>
                        <option value="texture">Textures</option><option value="terrain">Terrains</option>
                    </select>
                    <label class="browser-recursive-label"><input id="browser-recursive" type="checkbox" data-action="browser-recursive" checked="checked"/><span>Subfolders</span></label>
                    <select id="browser-sort" data-action="browser-sort">
                        <option value="name-asc">Name A-Z</option><option value="name-desc">Name Z-A</option>
                    </select>
                    <select id="browser-size" data-action="browser-size">
                        <option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option>
                    </select>
                </div>
                <div class="browser-body">
                    <div id="browser-sources-panel">
                        <div class="browser-source-heading">Sources</div>
                        <div id="asset-sources"></div>
                    </div>
                    <div class="browser-assets">
                        <div id="asset-list"></div>
                        <div id="asset-empty"></div>
                    </div>
                </div>
                <div class="browser-footer">
                    <div id="asset-count"></div>
                    <div id="browser-selection"></div>
                </div>
            </div>
            <div id="renderer-page" class="dock-panel">
                <div class="renderer-settings">
                    <div class="renderer-settings-column">
                        <div class="segmented">
                            <button id="mode-realtime" data-action="offline-mode" data-value="0">Realtime</button>
                            <button id="mode-offline" data-action="offline-mode" data-value="1">Offline</button>
                        </div>
                        <div class="property-row"><label>Samples</label><input id="offline-samples" type="text" data-action="offline-setting" data-field="samples" value="32"/></div>
                        <div class="property-row"><label>Bounces</label><input id="offline-bounces" type="text" data-action="offline-setting" data-field="bounces" value="2"/></div>
                        <div class="property-row"><label>Light Samples</label><input id="offline-lightSamples" type="text" data-action="offline-setting" data-field="lightSamples" value="1"/></div>
                        <div class="property-row"><label>Seed</label><input id="offline-seed" type="text" data-action="offline-setting" data-field="seed" value="0"/></div>
                    </div>
                    <div class="renderer-settings-column">
                        <div class="property-row"><label>AOV</label><select id="offline-aov" data-action="offline-aov"><option value="0">Combined</option><option value="1">Direct</option><option value="2">Indirect</option></select></div>
                        <div class="property-row"><label>Exposure</label><input id="offline-exposure" type="text" data-action="offline-exposure" value="1"/></div>
                        <div class="command-row">
                            <button id="offline-pause" data-action="offline-control" data-value="0">Pause</button>
                            <button id="offline-resume" data-action="offline-control" data-value="1">Resume</button>
                            <button id="offline-stop" data-action="offline-control" data-value="2">Stop</button>
                        </div>
                        <div class="command-row">
                            <button id="offline-restart" data-action="offline-control" data-value="3">Restart</button>
                            <button id="offline-export" data-action="offline-export">Export</button>
                        </div>
                        <p id="offline-status"></p>
                        <p id="offline-notice" class="notice"></p>
                    </div>
                </div>
            </div>
            <div id="log-page" class="dock-panel">
                <div class="log-tabs">
                    <button id="log-output-tab" class="selected" data-action="log-output">Output</button>
                    <button id="log-scripts-tab" data-action="log-scripts">Scripts</button>
                </div>
                <div id="log-output">
                    <div class="log-toolbar">
                        <select id="log-severity" data-action="log-severity" title="Severity">
                            <option value="all">All levels</option><option value="debug">Debug</option>
                            <option value="info">Info</option><option value="warning">Warning</option>
                            <option value="error">Error</option>
                        </select>
                        <input id="log-source" type="text" data-action="log-source" placeholder="Source" title="Filter source"/>
                        <input id="log-search" type="text" data-action="log-search" placeholder="Search" title="Search messages and file paths"/>
                        <label class="log-follow"><input id="log-autoscroll" type="checkbox" data-action="log-autoscroll" checked="checked"/><span>Auto-scroll</span></label>
                        <button id="log-clear" class="browser-icon" data-action="log-clear" title="Clear Output">
                            <img src="icons/trash.png"/><span class="browser-tooltip">Clear Output</span>
                        </button>
                    </div>
                    <div id="log-scroll"><div id="log-rows"></div></div>
                    <div id="log-count" class="log-footer"></div>
                </div>
                <div id="log-scripts">
                    <div class="log-toolbar">
                        <input id="log-scripts-search" type="text" data-action="log-scripts-search" placeholder="Blueprint or component" title="Filter script objects"/>
                        <button id="log-scripts-prev" class="browser-icon" data-action="log-scripts-prev" title="Previous script page"><img src="icons/arrow-left.png"/></button>
                        <span id="log-scripts-page"></span>
                        <button id="log-scripts-next" class="browser-icon" data-action="log-scripts-next" title="Next script page"><img src="icons/arrow-right.png"/></button>
                    </div>
                    <pre id="log-scripts-summary"></pre>
                    <div id="log-scripts-rows"></div>
                </div>
            </div>
            <div id="material-editor" class="dock-panel">
                <div class="material-editor-toolbar">
                    <button id="material-frame" class="browser-icon" data-action="material-frame" title="Frame Preview Ball">
                        <img src="icons/camera.png"/><span class="browser-tooltip">Frame Preview Ball</span>
                    </button>
                    <h3 id="document-title">Material Instance</h3>
                    <div class="toolbar-spacer"></div>
                    <button id="material-save" data-action="save" title="Save Material Instance">Save</button>
                    <button id="apply-preview" data-action="apply-preview">Apply Preview</button>
                    <button id="restore-preview" data-action="restore-preview">Restore Baseline</button>
                </div>
                <div id="material-editor-body">
                    <div id="material-preview-surface">
                        <img id="material-preview-image" src="vl://scene-viewport"/>
                        <p id="material-preview-status" class="muted"></p>
                    </div>
                    <div id="material-properties" class="inspector-body">
                    <p id="document-status" class="muted"></p>
                    <div id="details-content"></div>
                    </div>
                </div>
            </div>
            <div id="resource-editor">
                <div id="resource-editor-toolbar">
                    <div id="resource-texture-tools" class="resource-model-tools">
                        <button id="resource-texture-fit" class="browser-icon" data-action="resource-texture-fit" title="Fit Image">
                            <img src="icons/camera.png"/><span class="browser-tooltip">Fit Image</span>
                        </button>
                    </div>
                    <div id="resource-model-tools" class="resource-model-tools">
                        <button id="resource-frame" class="browser-icon" data-action="resource-frame" title="Frame Model">
                            <img src="icons/camera.png"/><span class="browser-tooltip">Frame Model</span>
                        </button>
                        <button id="resource-tool-select" class="viewport-tool" data-action="resource-tool" data-tool="select" title="Select model tool">Select</button>
                        <button id="resource-tool-move" class="viewport-tool" data-action="resource-tool" data-tool="move" title="Move model tool">Move</button>
                        <button id="resource-tool-rotate" class="viewport-tool" data-action="resource-tool" data-tool="rotate" title="Rotate model tool">Rotate</button>
                        <button id="resource-tool-scale" class="viewport-tool" data-action="resource-tool" data-tool="scale" title="Scale model tool">Scale</button>
                        <button id="resource-space-world" class="viewport-tool" data-action="resource-space" data-space="world" title="World space">World</button>
                        <button id="resource-space-local" class="viewport-tool" data-action="resource-space" data-space="local" title="Local space">Local</button>
                    </div>
                    <div class="toolbar-spacer"></div>
                    <button id="resource-reload" class="browser-icon" data-action="resource-reload" title="Reload JSON">
                        <img src="icons/refresh.png"/><span class="browser-tooltip">Reload JSON</span>
                    </button>
                    <button id="blueprint-asset-save" class="browser-icon" data-action="blueprint-asset-save" title="Save Blueprint">
                        <img src="icons/save.png"/>
                    </button>
                    <button id="blueprint-asset-revert" class="browser-icon" data-action="blueprint-asset-revert" title="Revert Blueprint Draft">
                        <img src="icons/refresh.png"/>
                    </button>
                    <button id="resource-close" class="browser-icon" data-action="resource-close" title="Close Asset">
                        <img src="icons/arrow-left.png"/><span class="browser-tooltip">Close Asset</span>
                    </button>
                </div>
                <div id="resource-editor-body">
                    <div id="blueprint-asset-editor"></div>
                    <div id="resource-preview-panel">
                        <div class="resource-panel-heading">
                            <h2 id="resource-preview-title"></h2>
                            <span id="resource-preview-kind"></span>
                        </div>
                        <div id="resource-animation-tools">
                            <button id="resource-animation-play" class="browser-icon" data-action="animation-play" title="Play animation"><img src="icons/play.png"/></button>
                            <button id="resource-animation-pause" class="browser-icon" data-action="animation-pause" title="Pause animation"><img src="icons/pause.png"/></button>
                            <select id="resource-animation-clip" data-action="animation-clip"></select>
                            <input id="resource-animation-time" type="range" min="0" max="1" step="0.001" value="0" data-action="animation-time"/>
                            <span id="resource-animation-status"></span>
                        </div>
                        <div id="resource-preview-surface">
                            <img id="resource-preview-image" src="vl://scene-viewport"/>
                            <img id="resource-texture-image"/>
                            <img id="resource-preview-icon" src="icons/mesh.png"/>
                            <h3 id="resource-preview-status"></h3>
                            <p id="resource-preview-path"></p>
                        </div>
                    </div>
                    <div id="resource-details-panel">
                        <div class="inspector-body">
                            <div id="resource-model-info">
                                <h3>Model Information</h3>
                                <p id="resource-model-name"></p>
                                <p id="resource-model-path"></p>
                                <p id="resource-model-status"></p>
                                <p id="resource-model-fields"></p>
                                <p id="resource-model-description"></p>
                            </div>
                            <div id="resource-motion-features">
                                <h3>Motion Features</h3>
                                <p id="resource-motion-status"></p>
                                <div id="resource-motion-values"></div>
                            </div>
                            <div id="resource-json-inspector">
                                <div class="json-header">
                                    <h3 id="resource-json-title"></h3><span class="json-readonly">Read Only</span>
                                </div>
                                <p id="resource-json-kind"></p>
                                <p id="resource-json-path"></p>
                                <p id="resource-json-description"></p>
                                <p id="resource-json-status" class="notice"></p>
                                <input id="resource-json-search" type="text" data-action="resource-json-search" value=""/>
                                <div id="resource-json-fields"></div>
                                <div class="json-pager">
                                    <button id="resource-json-prev" class="browser-icon" data-action="resource-json-prev" title="Previous Fields"><img src="icons/arrow-left.png"/></button>
                                    <span id="resource-json-page"></span>
                                    <button id="resource-json-next" class="browser-icon" data-action="resource-json-next" title="Next Fields"><img src="icons/arrow-right.png"/></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
        <div id="dock-drag-shield"></div>
        <div id="editor-status"><p id="editor-notice"></p></div>

        <div id="close-dialog">
            <div class="dialog">
                <h2>Unsaved Changes</h2>
                <p id="close-document-name"></p>
                <p id="close-document-status" class="notice"></p>
                <div class="command-row">
                    <button id="close-save" data-action="close-save">Save</button>
                    <button id="close-discard" data-action="close-discard">Discard</button>
                    <button data-action="close-cancel">Cancel</button>
                </div>
            </div>
        </div>

        <div id="save-dialog">
            <div class="dialog save-dialog">
                <h2>Save Content</h2>
                <div class="save-heading"><span>Asset</span><span>Status</span></div>
                <div id="save-document-list"></div>
                <p id="save-document-status" class="notice"></p>
                <div class="command-row">
                    <button id="save-select-all" data-action="save-select-all">Select All</button>
                    <button id="save-confirm" data-action="save-confirm">Save Selected</button>
                    <button id="save-cancel" data-action="save-cancel">Cancel</button>
                </div>
            </div>
        </div>

        <!-- 鼠标右键上下文菜单：全工作区只有这一个弹层，位置与条目在每次调用时由面板写入，
             它自己不保存目标。放在根节点（与 #close-dialog / #about-dialog 同级）而不是
             #editor-toolbar 内部：工具条是动作条，它的按钮统计不该被一个浮层改变；
             也不放在 #editor-content 里，那里的 overflow 会裁掉靠近边缘的菜单。
             条目复用 .menu-item 叶控件，容器不复用 .menu-popup：后者的显示依赖
             .menu-root.open 祖先，本弹层没有菜单栏父节点。 -->
        <div id="editor-context-menu">
            <div class="context-menu-title" id="editor-context-menu-title"></div>
            <div id="editor-context-menu-items"></div>
        </div>

        <div id="about-dialog">
            <div class="dialog about-dialog">
                <h2>VulkanLearn Editor</h2>
                <p>The editor workspace is rendered by RmlUi: layout, input, focus and painting all go through the RmlUi document, not a second UI toolkit.</p>
                <p>Workspace layout (dock tree, split ratios, floating panels and hidden panels) is stored at:</p>
                <p id="about-layout-path">%LOCALAPPDATA%/VulkanLearn/Editor/workspace-v1.json</p>
                <div class="command-row">
                    <button id="about-close" data-action="about-close">Close</button>
                </div>
            </div>
        </div>
    </body>
</rml>
