body {
    font-family: "Segoe UI";
    font-size: 13px;
    color: #e7e7e9;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    background-color: #19191c;
}
#editor-toolbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    background-color: #28282c;
    border-bottom-width: 1px;
    border-bottom-color: #49494f;
    pointer-events: auto;
    /* 菜单弹层要盖住下面的停靠区，但仍低于脏关闭弹窗（50）。 */
    z-index: 40;
}
#editor-toolbar h1 { margin-right: 16px; }
#editor-toolbar button { margin-right: 5px; }
#script-time-label { margin-right: 4px; flex-shrink: 0; }
#script-time-scale { width: 50px; height: 24px; box-sizing: border-box; margin-right: 8px; flex-shrink: 0; }
.toolbar-spacer { flex: 1; }
/* 窄停靠区允许表单自身滚动，保留底部关闭入口，不能把提交按钮挤到 Details 上。 */
#script-placement { display: none; padding: 4px 8px; flex-shrink: 1; min-height: 0; overflow: auto; }
.script-placement-row { display: flex; align-items: center; margin-bottom: 2px; }
#script-placement select, #script-placement input {
    display: block; flex: 1; min-width: 0; box-sizing: border-box; height: 27px;
}
#script-placement label { width: 42px; flex-shrink: 0; font-size: 11px; color: #babac2; }
#script-feedback { margin: 2px 0; }
#script-play, #script-pause, #script-stop { flex-shrink: 0; }
#script-placement-toggle { margin-left: auto; height: 18px; width: 22px; padding: 1px; min-height: 0; }
#script-placement-toggle img { width: 14px; height: 14px; }
#editor-menubar { display: flex; flex-shrink: 0; align-items: center; margin-right: 10px; }
.menu-root { position: relative; flex-shrink: 0; }
.menu-title {
    margin-right: 0;
    padding: 4px 9px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    min-height: 0;
}
.menu-root.open > .menu-title { background-color: #2a665b; }
.menu-popup {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 190px;
    padding: 3px 0;
    box-sizing: border-box;
    background-color: #28282c;
    border-width: 1px;
    border-color: #6e6e76;
    z-index: 41;
}
.menu-root.open > .menu-popup { display: block; }
.menu-entry { position: relative; }
.menu-item {
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    margin-right: 0;
    padding: 5px 10px 5px 4px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    text-align: left;
    min-height: 0;
    white-space: nowrap;
}
.menu-item:hover { background-color: #35594e; }
.menu-item.disabled { background-color: transparent; }
.menu-check { flex-shrink: 0; width: 16px; color: #8fd3bb; text-align: center; }
.menu-label { flex: 1; min-width: 0; }
.menu-arrow { flex-shrink: 0; margin-left: 12px; color: #b0b0b8; }
.menu-separator { display: block; height: 1px; margin: 3px 0; background-color: #49494f; }
.menu-submenu { top: -4px; left: 100%; }
.menu-entry:hover > .menu-popup { display: block; }
/* 右键上下文菜单：left/top 由面板按右键坐标写入，条目复用 .menu-item 样式。
   显示不依赖 .menu-root.open（本弹层没有菜单栏父节点），因此用自身 class 控制。
   根节点的 body 是 pointer-events: none，所以这里必须显式收回指针事件。 */
#editor-context-menu {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    min-width: 190px;
    padding: 3px 0;
    box-sizing: border-box;
    background-color: #28282c;
    border-width: 1px;
    border-color: #6e6e76;
    pointer-events: auto;
    /* 盖住停靠壳与浏览器 tooltip（45），仍低于脏关闭与 About 弹窗（50）。 */
    z-index: 46;
}
#editor-context-menu.open { display: block; }
.context-menu-title {
    padding: 4px 10px;
    margin-bottom: 3px;
    color: #b0b0b8;
    white-space: nowrap;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: #49494f;
}
#about-dialog {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #0000008c;
    pointer-events: auto;
    z-index: 50;
}
.about-dialog { left: 30%; top: 30%; width: 40%; }
.about-dialog p { margin-bottom: 9px; white-space: normal; }
#about-layout-path { color: #98b9e8; word-break: break-all; }
#editor-content {
    position: absolute;
    top: 41px;
    left: 0;
    right: 0;
    bottom: 25px;
    pointer-events: auto;
    overflow: hidden;
}
#dock-parking { display: none; }
#dock-shell { width: 100%; height: 100%; }
.dock-stack {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #303034;
}
.dock-stack.floating {
    border-width: 1px;
    border-color: #7b7b84;
    background-color: #303034;
}
.workspace-tabs {
    display: flex;
    flex-shrink: 0;
    height: 32px;
    overflow: auto;
    background-color: #222225;
    border-bottom-width: 1px;
    border-bottom-color: #49494f;
}
.workspace-tabs button {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 4px 12px;
    min-width: 70px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}
.workspace-tabs button.selected, .workspace-tabs .document-tab.selected {
    background-color: #353539;
    border-bottom-width: 2px;
    border-bottom-color: #62a58d;
}
#workspace-resource-tab { max-width: 240px; }
#workspace-resource-icon { flex-shrink: 0; width: 16px; height: 16px; margin-right: 6px; }
#workspace-resource-tab img { flex-shrink: 0; width: 16px; height: 16px; margin-right: 6px; }
#dock-dynamic-tabs img { flex-shrink: 0; width: 16px; height: 16px; margin-right: 6px; }
/* 静态占位保留校验用 id；动态资产标签使用 class。图标不压缩，文字单行截断。 */
.workspace-tabs button img { flex-shrink: 0; width: 16px; height: 16px; margin-right: 6px; }
.workspace-tabs button span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#workspace-resource-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.dock-body {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    overflow: hidden;
}
.dock-panel {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
}
#editor-navigation { background-color: #2d2d31; }
/* 大纲过滤栏与统计栏与 Content Browser 用同一套尺寸约定，不引入第二套工具条样式。 */
.outliner-filterbar {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    box-sizing: border-box;
    min-height: 31px;
    padding: 2px 5px;
    background-color: #252528;
    border-bottom-width: 1px;
    border-bottom-color: #39393e;
}
#outliner-type { width: 42%; flex-shrink: 0; }
/* 排序控件与 Content Browser 的 #browser-sort 同一套尺寸；过滤栏不换行，
   因此这里把搜索框的最小宽度收紧，保证三个控件在窄的右列里也不会被裁掉。 */
#outliner-sort { width: 86px; height: 24px; box-sizing: border-box; font-size: 11px; margin-left: 6px; flex-shrink: 0; }
.outliner-filterbar .browser-search { min-width: 84px; }
#outliner-empty { display: none; padding: 7px 9px; }
.outliner-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    box-sizing: border-box;
    height: 22px;
    padding: 3px 9px;
    font-size: 10px;
    color: #cacacf;
    border-top-width: 1px;
    border-top-color: #39393e;
}
/* 树行的图标与文本同属 list-item 按钮，点击靶面保持一个。
   这里保持 list-item 的块级/行内默认布局（而不是 flex）：分组行只有纯文本，
   RmlUi 的 flex 布局不会给裸文本子节点排版，分组标题会整行不可见。 */
.tree-row .list-item img.row-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    vertical-align: middle;
}
.tree-row.group-row .list-item { color: #a6c6ba; font-weight: bold; }
/* 虚拟化要求树行等高：显式行高 + 不换行把分组行（粗体，自然行高更矮）、actor 行与
   缩进的槽行拉成同一个高度；长名称按省略号裁剪，而不是把一行撑成两行。
   行高一变，spacer 高度就与真实内容不符，滚动位置会在滚动/排序后漂移。 */
#scene-models .tree-row { height: 30px; }
#scene-models .tree-row .list-item {
    line-height: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
/* 逐 actor 可见性开关（行尾眼睛）。它是行的 flex 兄弟节点而不是绝对定位：
   与 document-tab 的关闭按钮同一做法，既能被指针命中，也因为行高由 RCSS 固定
   为 30px 而不会把行撑高（spacer 高度依赖这条 30px）。
   图标必须显式给宽高：14px 的 .row-icon 规则只作用于 .list-item 里的图标，
   flex 子项若不给尺寸会按 PNG 原生 32px 参与布局并被按钮裁掉。 */
.tree-row .tree-trailing {
    display: block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 0;
    margin-left: 4px;
    min-height: 0;
    border-width: 0;
    background-color: transparent;
    opacity: 0.55;
}
.tree-row .tree-trailing img {
    display: block;
    width: 14px;
    height: 14px;
    margin: 2px auto 0;
}
.tree-row .tree-trailing:hover { opacity: 1; }
/* 隐藏态用"暗图标 + 暗标签"双重表达：只靠 14px 的图标形状区分在窄行里不够明显，
   而颜色与不透明度都是像素可回读的，能被验证据此断言。 */
.tree-row.hidden-row .tree-trailing { opacity: 0.9; }
.tree-row.hidden-row .list-item { color: #7c7c85; }
.tree-row.hidden-row .list-item img.row-icon { opacity: 0.45; }
#scene-models { flex: 1; min-height: 0; padding: 4px 7px; overflow: auto; }

#viewport-actor-overlay {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    overflow: hidden; pointer-events: none;
    /* 负偏移图标不一定增加 scroll extent；RmlUi 的 auto clip 因此可能不裁，必须强制裁剪。 */
    clip: always;
}
#viewport-actor-lines, #viewport-actor-icons {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    pointer-events: none;
}
.actor-visual-line {
    position: absolute; left: 0; top: 0; width: 1px; height: 1px;
    visibility: hidden; background-color: #f4d35e;
    transform-origin: 0px 0px; pointer-events: none;
}
.actor-visual-icon {
    position: absolute; left: 0; top: 0; width: 24px; height: 24px; padding: 3px;
    visibility: hidden;
    box-sizing: border-box;
    border: 1px #8d8d92; background-color: #242428cc; pointer-events: auto;
}
.actor-visual-icon.selected { border-color: #f4d35e; background-color: #665722dd; }
.actor-visual-icon img { width: 16px; height: 16px; }
.actor-property-row .horizontal-box { width: 68%; flex-shrink: 0; min-width: 0; }
.actor-property-row .property-row { align-items: center; }
.actor-property-row .component input { height: 24px; }
.actor-property-row .component label { display: block; }
/* 未挂载行的高度补偿：只占高度，不接收指针，也不参与树的点击寻址。 */
.outliner-spacer { display: block; width: 100%; pointer-events: none; }
#material-slots { max-height: 90px; overflow: auto; }
.inspector-body { flex: 1; min-height: 0; overflow: auto; padding: 0 10px 10px; }
/* 只读资产信息叠在图像上，不参与视口尺寸计算；子元素也不拦截相机或拾取输入。 */
.asset-viewport-info {
    position: absolute; left: 8px; top: 8px; width: 560px; max-width: 92%; box-sizing: border-box;
    padding: 4px 6px; background-color: #141416c9; color: #c4c4cc;
    font-size: 11px; line-height: 14px; pointer-events: none; z-index: 1;
}
.asset-viewport-info * { pointer-events: none; }
.asset-viewport-info h2, .asset-viewport-info h3 {
    font-size: 12px; line-height: 16px; margin: 0 0 2px; color: #ededf0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.asset-viewport-info p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-viewport-info .notice { white-space: normal; word-break: break-all; }
.workspace-asset-tab { width: 240px; max-width: 260px; height: 31px; box-sizing: border-box; }
.workspace-tabs .workspace-asset-tab .tab-close { width: 22px; padding: 0; margin-left: 5px; text-align: center; }
#material-editor { flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
#material-editor-body { display: flex; flex: 1; min-height: 0; min-width: 0; }
#material-preview-surface { position: relative; flex: 1; min-width: 0; overflow: hidden; clip: always; background-color: #141416; }
#material-preview-image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#material-properties { flex: none; width: 46%; min-width: 260px; box-sizing: border-box; border-left: 1px #424247; }
.material-editor-toolbar { display: flex; align-items: center; flex-wrap: wrap; flex-shrink: 0; padding: 6px 10px; border-bottom: 1px #424247; }
.material-editor-toolbar button { margin-left: 4px; }
.preview-commands { margin: 8px 0; }
#details-content .property-row select { width: 44%; }
#details-content .property-row button { margin-left: 4px; padding: 2px 4px; }
#content-browser-page { background-color: #202023; }
.asset-kind-blueprint { drag: clone; }
.asset-kind-blueprint:drag { opacity: 0.7; }
.script-overridden { border-color: #d9b765; }
.script-composite-property { width: 100%; min-width: 0; }
.script-composite { width: 100%; min-width: 0; }
.script-composite-head { display: flex; align-items: center; min-height: 28px; min-width: 0; }
.script-composite-count { flex: 1; min-width: 0; white-space: normal; font-size: 11px; }
.script-composite-head input { width: 72px; min-width: 0; height: 24px; }
.script-composite-body { padding-left: 8px; border-left: 1px #49494f; margin-left: 8px; }
.script-composite-body .property-row { flex-wrap: wrap; }
.script-composite-body .property-row > label { min-width: 48px; }
.browser-toolbar, .browser-filterbar {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 2px 5px;
    border-bottom-width: 1px;
    border-bottom-color: #39393e;
}
.browser-toolbar { height: 32px; background-color: #29292d; }
.browser-filterbar { min-height: 31px; flex-wrap: wrap; background-color: #252528; }
.browser-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
    width: 26px;
    height: 26px;
    min-height: 0;
    padding: 4px;
    margin-right: 2px;
    border-width: 0;
    background-color: transparent;
}
.browser-icon img { width: 18px; height: 18px; }
.browser-icon.disabled img { opacity: 0.35; }
.browser-tooltip {
    display: none;
    position: absolute;
    top: 27px;
    left: 0;
    width: 104px;
    padding: 5px 7px;
    color: #eeeeef;
    background-color: #121214;
    border-width: 1px;
    border-color: #6e6e76;
    font-size: 11px;
    pointer-events: none;
    z-index: 45;
}
.browser-icon:hover .browser-tooltip { display: block; }
#browser-list .browser-tooltip, #browser-grid .browser-tooltip { left: -80px; }
#asset-breadcrumbs {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
    overflow: auto;
    white-space: nowrap;
    margin: 0 6px;
}
.browser-crumb {
    flex-shrink: 0;
    min-height: 0;
    padding: 4px;
    border-width: 0;
    background-color: transparent;
    font-size: 11px;
}
.browser-crumb-separator { color: #939399; padding: 0 2px; }
.browser-search { display: flex; align-items: center; flex: 1; min-width: 120px; }
.browser-search img { width: 15px; height: 15px; flex-shrink: 0; margin: 0 5px; }
#asset-search {
    flex: 1;
    min-width: 0;
    height: 24px;
    box-sizing: border-box;
    padding: 3px 6px;
}
.browser-recursive-label { display: flex; align-items: center; flex-shrink: 0; font-size: 11px; margin: 0 7px; }
.browser-recursive-label span { white-space: nowrap; }
#browser-recursive { flex-shrink: 0; width: 13px; height: 13px; min-width: 0; padding: 0; box-sizing: border-box; margin-right: 4px; }
#browser-recursive:checked { background-color: #386557; border-color: #6cbba1; decorator: image(icons/check.png); }
#browser-sort { width: 86px; height: 24px; box-sizing: border-box; font-size: 11px; margin-right: 5px; }
#browser-size { width: 66px; height: 24px; box-sizing: border-box; font-size: 11px; }
#browser-type { flex-shrink: 0; width: 100px; height: 24px; box-sizing: border-box; font-size: 11px; margin-left: 6px; }
.browser-body { display: flex; flex: 1; min-height: 0; min-width: 0; overflow: hidden; }
#browser-sources-panel {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 23%;
    min-width: 112px;
    max-width: 190px;
    box-sizing: border-box;
    border-right-width: 1px;
    border-right-color: #424247;
    background-color: #242427;
}
.browser-source-heading {
    flex-shrink: 0;
    height: 23px;
    box-sizing: border-box;
    padding: 4px 9px;
    color: #b4b4bb;
    font-size: 11px;
}
#asset-sources { flex: 1; min-height: 0; overflow: auto; padding: 0 3px 4px; }
.browser-folder-row { display: flex; align-items: center; box-sizing: border-box; height: 24px; }
.browser-folder-toggle {
    flex-shrink: 0;
    width: 17px;
    height: 22px;
    min-height: 0;
    padding: 2px;
    border-width: 0;
    background-color: transparent;
}
.browser-folder-name {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
    height: 24px;
    min-height: 0;
    padding: 3px 4px;
    border-width: 0;
    background-color: transparent;
    box-sizing: border-box;
    font-size: 11px;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
}
.browser-folder-name img { flex-shrink: 0; width: 15px; height: 15px; margin-right: 5px; }
.browser-folder-name span { min-width: 0; overflow: hidden; }
.browser-assets { position: relative; display: flex; flex: 1; min-width: 0; min-height: 0; }
#asset-list {
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    padding: 6px;
    box-sizing: border-box;
}
#asset-list.browser-grid-view { display: flex; flex-direction: row; flex-wrap: wrap; align-content: flex-start; align-items: flex-start; }
.asset-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    align-items: stretch;
    box-sizing: border-box;
    width: 92px;
    height: 116px;
    padding: 4px;
    margin: 0 5px 6px 0;
    text-align: left;
    overflow: hidden;
    border-width: 1px;
    border-color: transparent;
    border-radius: 2px;
    background-color: #2b2b2f;
}
.asset-tile:hover { border-color: #7d7d84; background-color: #38383d; }
.asset-tile.selected { border-color: #6cbba1; background-color: #29493f; }
.asset-preview { flex-shrink: 0; }
.asset-tile .asset-preview { width: 60px; height: 60px; align-self: center; }
.asset-name { display: block; min-width: 0; white-space: normal; overflow: hidden; word-break: break-all; }
.asset-tile .asset-name { height: 28px; min-height: 28px; flex-shrink: 0; line-height: 13px; font-size: 11px; margin-top: 3px; text-decoration: none; }
.asset-kind { display: block; color: #acacb4; font-size: 9px; white-space: nowrap; overflow: hidden; }
.asset-tile .asset-kind { flex-shrink: 0; height: 11px; border-top-width: 2px; border-top-color: #65a594; line-height: 11px; }
.asset-type-badge { display: none; position: absolute; top: 5px; left: 5px; width: 15px; height: 15px; background-color: #262629; }
.asset-tile.has-thumbnail .asset-type-badge { display: block; }
.asset-kind-mesh .asset-kind, .asset-kind.asset-kind-mesh { border-top-color: #5cb8c6; }
.asset-kind-scene .asset-kind, .asset-kind.asset-kind-scene { border-top-color: #659de3; }
.asset-kind-texture .asset-kind, .asset-kind.asset-kind-texture { border-top-color: #cd7e9d; }
.asset-kind-terrain .asset-kind, .asset-kind.asset-kind-terrain { border-top-color: #c9ae68; }
.browser-spacer { display: block; flex-basis: 100%; width: 100%; flex-shrink: 0; pointer-events: none; }
.asset-dirty { position: absolute; top: 4px; right: 6px; font-size: 14px; color: #ebcb80; }
.browser-size-medium .asset-tile { width: 116px; height: 142px; }
.browser-size-medium .asset-tile .asset-preview { width: 84px; height: 84px; }
.browser-size-large .asset-tile { width: 140px; height: 166px; }
.browser-size-large .asset-tile .asset-preview { width: 108px; height: 108px; }
#asset-list.browser-list-view { display: block; }
.asset-row {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    height: 29px;
    min-height: 0;
    padding: 4px 6px;
    margin-bottom: 1px;
    text-align: left;
    background-color: transparent;
    border-width: 0;
}
.asset-row .asset-preview { width: 19px; height: 19px; margin-right: 7px; }
.asset-row .asset-name { flex: 1; white-space: nowrap; font-size: 11px; }
.asset-row .asset-kind { width: 94px; margin-left: 8px; }
.asset-row .asset-dirty { position: relative; top: 0; right: 0; margin-left: 6px; }
#asset-empty {
    position: absolute;
    top: 16px;
    left: 10px;
    right: 10px;
    font-size: 12px;
    color: #a5a5ad;
    pointer-events: none;
}
.browser-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    box-sizing: border-box;
    height: 22px;
    padding: 3px 9px;
    font-size: 10px;
    border-top-width: 1px;
    border-top-color: #39393e;
    background-color: #252528;
}
#asset-count { flex-shrink: 0; color: #cacacf; margin-right: 12px; }
#browser-selection { flex: 1; min-width: 0; color: #9d9da6; white-space: nowrap; overflow: hidden; }
#json-inspector { display: none; }
.json-header { display: flex; align-items: center; }
#json-title { flex: 1; min-width: 0; white-space: normal; word-break: break-all; font-size: 13px; margin: 0; border-width: 0; }
.json-readonly { flex-shrink: 0; font-size: 10px; color: #b0b0b8; margin: 0 5px; }
#json-kind { color: #78b7cb; font-size: 11px; margin: 5px 0; }
#json-path, #json-description { font-size: 11px; white-space: normal; word-break: break-all; margin: 5px 0; }
#json-path { color: #a2a2ad; }
#json-search { width: 100%; height: 25px; box-sizing: border-box; margin: 5px 0; }
.json-field { display: flex; align-items: flex-start; padding: 5px 0; border-bottom-width: 1px; border-bottom-color: #414146; font-size: 11px; }
.json-field-key { display: flex; align-items: flex-start; flex-shrink: 0; width: 45%; min-width: 0; box-sizing: border-box; }
.json-field-key span { min-width: 0; white-space: normal; word-break: break-all; }
.json-field-value { flex: 1; min-width: 0; white-space: normal; word-break: break-all; padding-left: 7px; }
.json-string { color: #a4c9ac; }
.json-number { color: #98b9e8; }
.json-boolean { color: #d3b277; }
.json-null, .json-object, .json-array { color: #a1a1aa; }
.json-expand, .json-indent { flex-shrink: 0; width: 15px; height: 16px; min-height: 0; padding: 0; border-width: 0; background-color: transparent; }
.json-expand img { width: 13px; height: 13px; }
.json-expand.expanded img { transform: rotate(90deg); }
.json-pager { display: flex; align-items: center; justify-content: center; margin: 8px 0; }
#json-page { font-size: 11px; color: #b5b5bd; margin: 0 10px; }
#renderer-page { overflow: auto; padding: 4px 10px; }
#log-page { background-color: #242428; }
.log-tabs { display: flex; flex-shrink: 0; min-height: 26px; background-color: #2d2d31; }
.log-tabs button { min-height: 24px; padding: 2px 12px; border-width: 0 0 2px 0; border-color: transparent; background-color: transparent; }
.log-tabs button.selected { border-color: #8fbcba; color: #f0f0f2; }
#log-output, #log-scripts { flex: 1; min-height: 0; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
#log-scripts { display: none; }
.log-toolbar { display: flex; flex-wrap: wrap; align-items: center; flex-shrink: 0; min-height: 32px; padding: 2px 5px; box-sizing: border-box; background-color: #2d2d31; }
.log-toolbar input[type=text] { min-width: 60px; width: 100px; margin-right: 5px; }
#log-search, #log-scripts-search { flex: 1; min-width: 90px; }
#log-severity { width: 94px; margin-right: 5px; }
.log-follow { display: flex; align-items: center; flex-shrink: 0; font-size: 11px; margin-right: 5px; }
.log-follow span { margin-left: 4px; white-space: nowrap; }
#log-autoscroll { width: 14px; height: 14px; min-width: 14px; min-height: 14px; padding: 0; margin: 0; border-width: 1px; border-color: #7c7c86; background-color: #1c1c20; }
#log-autoscroll:checked { background-color: #8fbcba; border-color: #c3dfdc; }
#log-scroll { flex: 1; min-height: 0; min-width: 0; overflow: auto; }
#log-rows { min-width: 0; }
.log-row { display: flex; height: 24px; min-height: 24px; max-height: 24px; line-height: 24px; box-sizing: border-box; overflow: hidden; font-size: 11px; color: #d1d1d8; border-bottom-width: 1px; border-color: #303034; }
.log-time, .log-level, .log-origin, .log-message { display: block; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 5px; }
.log-time { width: 82px; color: #90909a; }
.log-level { width: 58px; }
.log-origin { width: 90px; color: #96bbb8; }
.log-message { flex: 4; }
.log-warning { color: #e7c57e; }
.log-error { color: #f29e9e; }
.log-debug { color: #9d9da8; }
.log-spacer { display: block; flex-shrink: 0; margin: 0; padding: 0; }
.log-footer { flex-shrink: 0; font-size: 11px; line-height: 22px; padding: 0 7px; color: #9d9da8; background-color: #2d2d31; }
#log-scripts-summary { flex-shrink: 0; font-size: 11px; line-height: 18px; margin: 0; padding: 4px 7px; max-height: 100px; overflow: auto; white-space: pre-wrap; }
#log-scripts-rows { flex: 1; min-height: 0; min-width: 0; overflow: auto; }
.log-script-row { min-height: 24px; line-height: 24px; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 7px; border-bottom-width: 1px; border-color: #303034; }
#log-scripts-page { font-size: 11px; margin: 0 5px; }
/* Performance 页：摘要区 + 固定表头 + 可滚动 pass 行。
   条形宽度只用 class 表达（5% 一档），不写内联 style；精确百分比在行文本里。 */
#performance-page { background-color: #242428; padding: 8px 10px; }
.performance-summary { display: flex; flex-wrap: wrap; flex-shrink: 0; }
.performance-metric { display: flex; flex-direction: column; min-width: 118px; margin-right: 24px; padding: 2px 0; }
.performance-metric-label { font-size: 11px; line-height: 15px; color: #90909a; }
.performance-metric-value { font-size: 20px; line-height: 26px; color: #f0f0f2; }
.performance-status { flex-shrink: 0; font-size: 11px; line-height: 16px; margin: 6px 0; color: #b5b5bd; }
.performance-table-header, .performance-row { display: flex; align-items: center; box-sizing: border-box; height: 24px; min-height: 24px; font-size: 11px; border-bottom-width: 1px; border-color: #303034; }
.performance-table-header { flex-shrink: 0; color: #90909a; background-color: #2d2d31; }
.performance-passes { flex: 1; min-width: 0; min-height: 0; overflow: auto; }
.performance-pass-name { flex: 3; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 6px; }
.performance-pass-ms { width: 76px; flex-shrink: 0; text-align: right; padding: 0 6px; color: #d1d1d8; }
.performance-pass-percent { width: 64px; flex-shrink: 0; text-align: right; padding: 0 6px; color: #b5b5bd; }
.performance-pass-bar-cell { flex: 3; min-width: 0; height: 24px; box-sizing: border-box; padding: 8px 6px; }
.performance-bar-fill { display: block; height: 8px; background-color: #62a58d; }
.performance-bar-0 { width: 0%; }
.performance-bar-5 { width: 5%; }
.performance-bar-10 { width: 10%; }
.performance-bar-15 { width: 15%; }
.performance-bar-20 { width: 20%; }
.performance-bar-25 { width: 25%; }
.performance-bar-30 { width: 30%; }
.performance-bar-35 { width: 35%; }
.performance-bar-40 { width: 40%; }
.performance-bar-45 { width: 45%; }
.performance-bar-50 { width: 50%; }
.performance-bar-55 { width: 55%; }
.performance-bar-60 { width: 60%; }
.performance-bar-65 { width: 65%; }
.performance-bar-70 { width: 70%; }
.performance-bar-75 { width: 75%; }
.performance-bar-80 { width: 80%; }
.performance-bar-85 { width: 85%; }
.performance-bar-90 { width: 90%; }
.performance-bar-95 { width: 95%; }
.performance-bar-100 { width: 100%; }
.renderer-settings { display: flex; }
.renderer-settings-column { width: 50%; min-width: 0; padding-right: 16px; box-sizing: border-box; }
.renderer-settings-column:last-child { padding-right: 0; }
#editor-viewport-surface {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: #101013;
}
#editor-viewport-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
/* 角落坐标轴指示器：左下角，固定尺寸。锚点是这个盒子的中心，三根杆从中心向外画。
   与左上的视口工具条同一侧但不同端（工具条 top:6px，这里 bottom:10px），因此不重叠。
   pointer-events 关掉：它是读数不是控件，点它不应该抢走视口的场景输入。 */
#viewport-axis-indicator {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 72px;
    height: 72px;
    z-index: 3;
    pointer-events: none;
}
/* 锚点：从锚点向右延伸的一根细杆，靠 transform 转到目标方向。
   transform-origin 必须在左端，否则杆会绕自身中心旋转、起点跟着跑。 */
.viewport-axis-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 2px;
    margin-top: -1px;
    transform-origin: 0 50%;
}
.viewport-axis-label {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 12px;
    margin-left: -5px;
    margin-top: -6px;
    font-size: 11px;
    line-height: 12px;
    text-align: center;
}
/* 轴色与世界原点处的三轴保持同一约定：X 红、Y 绿、Z 蓝。
   这里用不透明十六进制；半透明必须写 #RRGGBBAA（见组件文档的 RCSS 颜色格式约定）。 */
#viewport-axis-bar-x { background-color: #e42a1f; }
#viewport-axis-bar-y { background-color: #2fd93f; }
#viewport-axis-bar-z { background-color: #3a5cfa; }
#viewport-axis-label-x { color: #ff7a70; }
#viewport-axis-label-y { color: #7bef86; }
#viewport-axis-label-z { color: #8ba2ff; }
/* 视口工具条叠在场景图像上：它是编辑器 DOM，命中时不驱动相机或场景拾取。 */
#viewport-toolbar {
    position: absolute;
    top: 6px;
    left: 6px;
    display: flex;
    align-items: center;
    z-index: 3;
    pointer-events: auto;
}
.viewport-tool-group {
    display: flex;
    align-items: center;
    margin-right: 8px;
    padding: 2px;
    /* 视口工具条必须是不透明底色：当前 UI overlay 不合成半透明背景（见组件文档）。 */
    background-color: #242428;
    border-width: 1px;
    border-color: #4b4b50;
    border-radius: 3px;
}
.viewport-tool {
    min-width: 0;
    min-height: 0;
    margin-right: 2px;
    padding: 3px 8px;
    font-size: 11px;
    border-width: 0;
    border-radius: 2px;
    background-color: transparent;
}
.viewport-tool:last-child { margin-right: 0; }
.viewport-tool.active { background-color: #2a665b; color: #ffffff; }
.viewport-tool.disabled { color: #85858b; background-color: transparent; }
#viewport-view-mode > .viewport-tool { display: block; width: 100%; box-sizing: border-box; text-align: left; }
#viewport-buffer-modes { top: -66px; max-height: 240px; overflow: auto; }
#resource-editor {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    background-color: #202023;
    pointer-events: auto;
}
#resource-editor-toolbar {
    display: flex;
    align-items: center;
    height: 34px;
    box-sizing: border-box;
    padding: 2px 5px;
    background-color: #29292d;
    border-bottom-width: 1px;
    border-bottom-color: #49494f;
}
#resource-editor-body {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
}
#blueprint-asset-editor { display: none; position: relative; flex: 1; min-width: 0; min-height: 0; overflow: hidden; }
/* 参考骨架在 UI 内按同一厘米比例正交投影；取景/选骨不切换活动渲染 World。 */
#resource-editor.retarget-active #resource-editor-toolbar { position: absolute; top: 0; right: 0; width: 38px; height: 30px; background-color: transparent; border-width: 0; z-index: 2; }
#retarget-asset-editor { display: none; flex: 1; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; }
#retarget-editor-workspace { display: flex; flex: 1; min-width: 0; min-height: 0; }
#retarget-hierarchy-panel { display: flex; flex-direction: column; width: 18%; min-width: 160px; max-width: 230px; flex-shrink: 0; border-right: 1px #49494f; background-color: #252528; }
.retarget-panel-title { height: 26px; box-sizing: border-box; flex-shrink: 0; padding: 5px 8px; background-color: #303035; border-bottom: 1px #49494f; font-size: 12px; }
.retarget-hierarchy-tools { display: flex; padding: 3px 6px; flex-shrink: 0; }
#retarget-hierarchy { flex: 1; min-height: 0; overflow: auto; padding: 3px; }
#retarget-hierarchy .tree-row { height: 24px; min-width: 0; }
#retarget-hierarchy .list-item { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }
#retarget-hierarchy .retarget-unmapped .list-item { color: #96969e; pointer-events: none; }
#retarget-center { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; }
#retarget-sidebar { display: flex; flex-direction: column; width: 28%; min-width: 250px; max-width: 340px; flex-shrink: 0; min-height: 0; border-left: 1px #49494f; background-color: #252528; }
#retarget-details { max-height: 28%; flex-shrink: 0; overflow: auto; padding: 5px 8px; font-size: 11px; }
.retarget-detail-row { display: flex; min-width: 0; margin: 2px 0; }
.retarget-detail-row label { width: 58px; flex-shrink: 0; color: #9f9fa9; }
.retarget-detail-row span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#retarget-asset-browser { display: flex; flex-direction: column; height: 148px; max-height: 30%; min-height: 88px; flex-shrink: 0; border-top: 1px #49494f; }
#retarget-animation-assets { flex: 1; min-height: 0; overflow: auto; padding: 2px 4px; }
#retarget-animation-assets .list-item { display: flex; width: 100%; box-sizing: border-box; height: 26px; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#retarget-animation-workspace { display: none; flex: 1; flex-direction: column; min-width: 0; min-height: 0; }
#retarget-animation-tools { display: flex; align-items: center; flex-shrink: 0; height: 36px; box-sizing: border-box; padding: 4px 6px; border-top: 1px #49494f; background-color: #29292d; }
#retarget-animation-tools button { width: 26px; height: 26px; margin-right: 3px; }
#retarget-animation-clip { width: 100%; min-width: 0; height: 24px; box-sizing: border-box; flex-shrink: 0; font-size: 11px; }
#retarget-animation-time { flex: 1; min-width: 80px; height: 20px; padding: 0; margin: 0 6px; }
#retarget-animation-time slidertrack { display: block; height: 6px; margin-top: 7px; background-color: #3c3c43; }
#retarget-animation-time sliderbar { display: block; width: 8px; height: 18px; background-color: #bbbbc5; }
#retarget-animation-time sliderprogress { display: block; height: 6px; background-color: #2a665b; }
#retarget-animation-labels { position: absolute; display: flex; left: 0; right: 0; bottom: 8px; font-size: 11px; pointer-events: none; }
#retarget-animation-labels * { pointer-events: none; }
#retarget-animation-labels span { width: 50%; text-align: center; }
#retarget-preview-surface { position: relative; flex: 1; min-height: 120px; overflow: hidden; background-color: #141416; }
#retarget-preview-image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: none; }
.asset-viewport-info #retarget-status, .asset-viewport-info #retarget-reference-status,
.asset-viewport-info #retarget-measurement { white-space: normal; }
#retarget-animation-status { height: 14px; }
.retarget-toolbar { display: flex; flex-wrap: wrap; flex-shrink: 0; align-items: center; padding: 4px 6px; border-bottom: 1px #49494f; }
.retarget-mode-toolbar { padding-right: 78px; }
.retarget-toolbar select { flex: 1; min-width: 120px; max-width: 300px; height: 25px; font-size: 11px; }
/* 三栏各自滚动，映射或骨架列表增长不挤压中央预览。 */
.retarget-workspace { display: flex; flex: 1; min-width: 0; min-height: 0; }
.retarget-visual { display: flex; flex: 1; flex-direction: column; min-width: 80px; min-height: 0; background-color: #141416; }
#retarget-legend { display: flex; align-items: center; flex-shrink: 0; flex-wrap: wrap; padding: 4px 6px; font-size: 11px; }
#retarget-legend span { margin-right: 8px; }
#retarget-legend button { width: 24px; height: 24px; margin-right: 3px; }
#retarget-legend button.active { background-color: #344b45; }
#retarget-zoom { flex: 1; min-width: 40px; max-width: 80px; height: 16px; padding: 0; border-width: 0; background-color: transparent; margin-left: 4px; }
#retarget-zoom slidertrack { display: block; height: 6px; margin-top: 5px; background-color: #3c3c43; }
#retarget-zoom sliderbar { display: block; width: 8px; height: 14px; background-color: #bbbbc5; }
#retarget-zoom sliderprogress { display: block; height: 6px; background-color: #2a665b; }
.retarget-all-label { display: flex; align-items: center; flex-shrink: 0; margin-left: 6px; }
.retarget-all-label span { margin-right: 0; }
#retarget-all-bones { width: 13px; height: 13px; padding: 0; margin-right: 4px; }
#retarget-all-bones:checked { decorator: image(icons/check.png); background-color: #35594e; }
#retarget-surface { position: relative; flex: 1; min-height: 96px; overflow: hidden; clip: always; }
#retarget-lines { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
#retarget-selection { color: #ededf0; }
#retarget-measurement { color: #a9a9b5; }
.retarget-mapping { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 100px; }
.retarget-table-heading { display: flex; flex-shrink: 0; padding: 6px; font-size: 10px; background-color: #303035; }
.retarget-table-heading span { width: 22%; text-align: right; }
.retarget-table-heading span:first-child { width: 56%; text-align: left; }
#retarget-mappings { flex: 1; min-height: 0; overflow: auto; padding: 2px; }
.retarget-row { display: flex; width: 100%; height: 38px; min-height: 38px; min-width: 0; box-sizing: border-box; margin: 0; padding: 3px 4px; border-width: 0 0 1px; border-color: #333338; border-radius: 0; background-color: transparent; text-align: left; }
.retarget-row.selected { background-color: #344b45; }
.retarget-names { display: flex; flex-direction: column; width: 56%; min-width: 0; font-size: 10px; }
.retarget-names span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 15px; }
.retarget-metric { width: 22%; font-size: 10px; padding-top: 7px; text-align: right; }
.retarget-source { color: #69cee4; }
.retarget-target { color: #f1ba72; }
.retarget-line { position: absolute; height: 1px; transform-origin: 0px 0px; pointer-events: none; }
.retarget-line.retarget-source { background-color: #69cee4; }
.retarget-line.retarget-target { background-color: #f1ba72; }
.retarget-point { position: absolute; width: 6px; height: 6px; border-radius: 3px; pointer-events: none; }
.retarget-point.retarget-source { background-color: #69cee4; }
.retarget-point.retarget-target { background-color: #f1ba72; }
.retarget-point.selected { border: 2px #ffffff; margin-left: -2px; margin-top: -2px; }
.retarget-line.retarget-delta { background-color: #ffffff; height: 2px; }
.retarget-axis-x { color: #ed665e; background-color: #ed665e; }
.retarget-axis-y { color: #79d389; background-color: #79d389; }
.retarget-axis-z { color: #66aafa; background-color: #66aafa; }
#retarget-measurement span { background-color: transparent; }
.retarget-line.retarget-axis-x, .retarget-line.retarget-axis-y, .retarget-line.retarget-axis-z { height: 2px; }
.blueprint-asset-workspace { position: absolute; display: flex; top: 0; bottom: 0; left: 0; right: 0; min-height: 0; }
#blueprint-asset-components { display: flex; flex-direction: column; width: 20%; min-width: 152px; max-width: 230px; flex-shrink: 0; min-height: 0; border-right: 1px #49494f; box-sizing: border-box; background-color: #252528; }
.blueprint-asset-panel-title { height: 30px; flex-shrink: 0; padding: 7px 10px; box-sizing: border-box; background-color: #303035; border-bottom: 1px #49494f; font-size: 12px; }
.blueprint-asset-add-tools { display: flex; align-items: center; padding: 6px; flex-shrink: 0; }
.blueprint-asset-add-tools select { flex: 1; min-width: 0; margin-right: 5px; }
.blueprint-asset-mesh-path { padding: 0 6px 6px; flex-shrink: 0; }
.blueprint-asset-mesh-path label { display: block; margin-bottom: 3px; color: #aeb7b2; font-size: 11px; }
.blueprint-asset-mesh-path input { width: 100%; box-sizing: border-box; }
#blueprint-asset-component-tree { flex: 1; min-height: 0; overflow: auto; padding: 4px; }
#blueprint-asset-component-tree .tree-row { height: 28px; box-sizing: border-box; }
#blueprint-asset-component-tree .list-item { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#blueprint-asset-preview { display: flex; flex-direction: column; flex: 1; min-width: 80px; min-height: 0; background-color: #141416; }
.blueprint-asset-preview-toolbar { display: flex; align-items: center; height: 30px; flex-shrink: 0; padding-left: 8px; font-size: 12px; background-color: #303035; border-bottom: 1px #49494f; }
.blueprint-asset-preview-toolbar button { width: 26px; height: 26px; margin-left: 4px; }
#blueprint-asset-preview-surface { position: relative; flex: 1; min-height: 0; overflow: hidden; clip: always; }
#blueprint-asset-preview-image { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#blueprint-asset-gizmo-overlay {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    pointer-events: none; overflow: hidden; clip: always;
}
.blueprint-gizmo-line {
    position: absolute; left: 0; top: 0; width: 1px; height: 2px;
    transform-origin: 0px 0px; pointer-events: none; visibility: hidden;
}
.blueprint-gizmo-x { background-color: #ed665e; }
.blueprint-gizmo-y { background-color: #79d389; }
.blueprint-gizmo-z { background-color: #66aafa; }
.blueprint-gizmo-bounds { background-color: #f4d35e; height: 1px; }
.blueprint-gizmo-helper { background-color: #a5d6dc; height: 1px; }
.blueprint-snap-toolbar { display: flex; align-items: center; flex-shrink: 0; height: 26px; padding-left: 4px; background-color: #252529; }
.blueprint-snap-toolbar label { display: flex; align-items: center; flex-shrink: 0; font-size: 11px; width: 48px; }
.blueprint-snap-toolbar label span { white-space: nowrap; }
.blueprint-snap-toolbar input { width: 13px; height: 13px; margin-right: 3px; }
.blueprint-snap-toolbar select { flex: 1; min-width: 0; height: 22px; margin: 1px 2px; padding: 0px 2px; font-size: 11px; }
.blueprint-asset-preview-toolbar button.selected { background-color: #39665d; border-color: #8cafa4; }
#blueprint-asset-details { display: flex; flex-direction: column; width: 36%; min-width: 260px; max-width: 440px; flex-shrink: 0; min-height: 0; border-left: 1px #49494f; box-sizing: border-box; }
#blueprint-asset-details-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#blueprint-asset-details-scroll { padding: 8px 12px; box-sizing: border-box; }
#blueprint-asset-editor .property-row > label { width: 34%; font-size: 12px; white-space: normal; }
#blueprint-asset-editor .property-row > input, #blueprint-asset-editor .property-row > select { min-width: 0; }
#blueprint-asset-editor .property-row { max-width: 760px; }
.script-component-instance { display: flex; align-items: center; margin-left: 34%; margin-bottom: 5px; font-size: 11px; }
.script-component-instance input { margin-right: 4px; }
.script-component-instance span { white-space: nowrap; }
/* 向量容器必须占据控件列，避免嵌套 flex 的自适应宽度收缩到轴标签。 */
#blueprint-asset-editor .horizontal-box { width: 64%; flex-shrink: 0; min-width: 0; }
#blueprint-asset-editor .component input { height: 24px; }
#blueprint-asset-editor .component label { display: block; }
#blueprint-asset-editor h3 { margin-top: 16px; margin-bottom: 8px; }
#blueprint-asset-editor input[type=checkbox] {
    width: 16px; height: 16px; padding: 0; flex: none; box-sizing: border-box;
}
#blueprint-asset-editor input[type=checkbox]:checked {
    decorator: image(icons/check.png); background-color: #35594e; border-color: #62a58d;
}
#blueprint-asset-save, #blueprint-asset-revert { display: none; }
#resource-model-tools, #resource-texture-tools { display: none; align-items: center; gap: 3px; }
#resource-model-tools.visible, #resource-texture-tools.visible { display: flex; }
#resource-model-info { display: none; padding: 10px 12px; border-bottom-width: 1px; border-bottom-color: #49494f; }
#resource-model-info.visible { display: block; }
#resource-model-info h3 { margin: 0 0 7px; color: #e7e7e9; }
#resource-model-info p { margin: 3px 0; color: #aeb7b2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#resource-preview-panel, #resource-details-panel {
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
}
#resource-preview-panel {
    display: flex;
    flex: 1 1 68%;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: #49494f;
    background-color: #101013;
}
#resource-details-panel {
    display: flex;
    flex: 0 1 32%;
    background-color: #2d2d31;
}
#resource-preview-surface {
    overflow: hidden;
    clip: always;
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    padding: 24px;
    box-sizing: border-box;
    border-top-width: 1px;
    border-top-color: #29292d;
}
#resource-preview-image { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#resource-texture-image { display: none; position: absolute; }
#resource-preview-path { width: 100%; flex-shrink: 0; }
#resource-preview-icon { width: 96px; height: 96px; margin-bottom: 18px; opacity: 0.8; }
#resource-preview-status { margin: 0 0 6px; color: #e7e7e9; text-align: center; }
#resource-preview-path { max-width: 90%; margin: 0; color: #92969d; text-align: center; word-break: break-all; }
#resource-json-inspector { display: block; }
#resource-json-fields { max-height: none; }
.dock-splitter {
    position: absolute;
    z-index: 2;
    background-color: #171719;
}
.dock-splitter:hover { background-color: #62a58d; }
.dock-splitter.horizontal { cursor: resize-ew; }
.dock-splitter.vertical { cursor: resize-ns; }
#dock-preview {
    display: none;
    position: absolute;
    z-index: 31;
    box-sizing: border-box;
    border-width: 2px;
    border-color: #72c6ad;
    background-color: #47997e4d;
    pointer-events: none;
}
#dock-drag-shield {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    z-index: 30;
}
#editor-status {
    display: flex;
    align-items: center;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 24px;
    padding: 0 10px;
    box-sizing: border-box;
    background-color: #222225;
    border-top-width: 1px;
    border-top-color: #49494f;
    pointer-events: auto;
}
#editor-notice { flex: 1; min-width: 0; line-height: 23px; white-space: nowrap; overflow: hidden; font-size: 11px; }
#close-dialog, #save-dialog {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #0000008c;
    pointer-events: auto;
    z-index: 50;
}
.dialog {
    position: absolute;
    left: 25%;
    top: 30%;
    width: 50%;
    padding: 18px;
    box-sizing: border-box;
    background-color: #343439;
    border-width: 1px;
    border-color: #6d6d75;
    border-radius: 4px;
}
.dialog h2 { margin-bottom: 12px; }
#close-document-name { margin-bottom: 16px; }
#workspace-save { width: 30px; height: 26px; padding: 4px; box-sizing: border-box; }
#workspace-save img { width: 16px; height: 16px; }
.save-dialog { top: 18%; left: 12%; width: 76%; max-height: 70%; }
.save-heading { display: flex; justify-content: space-between; padding: 5px 8px; border-bottom: 1px #6d6d75; }
#save-document-list { max-height: 250px; overflow-y: auto; }
.save-row { display: flex; align-items: center; min-height: 30px; padding: 4px 8px; box-sizing: border-box; border-bottom: 1px #45454b; }
.save-row input { width: 16px; height: 16px; padding: 0; margin-right: 8px; flex-shrink: 0; box-sizing: border-box; }
.save-row input:checked { decorator: image(icons/check.png); background-color: #35594e; border-color: #62a58d; }
#script-physics-trigger { width: 18px; height: 18px; flex: 0; flex-shrink: 0; padding: 0; }
#script-physics-trigger:checked { decorator: image(icons/check.png); background-color: #35594e; border-color: #62a58d; }
.script-component-actions { display: flex; justify-content: flex-end; height: 26px; }
.save-path { flex: 1; min-width: 0; white-space: normal; overflow: hidden; font-size: 12px; }
.save-state { width: 105px; flex-shrink: 0; padding-left: 8px; font-size: 11px; }
#save-document-status { margin-top: 8px; white-space: normal; max-height: 60px; overflow-y: auto; }
#resource-animation-tools { display: none; align-items: center; flex-wrap: wrap; padding: 4px; gap: 4px; }
#resource-animation-clip { width: 230px; max-width: 100%; }
#resource-animation-time { width: 160px; height: 20px; }
#resource-animation-status { font-size: 11px; white-space: normal; }
.motion-debug-toggle { display: flex; align-items: center; width: 70px; height: 24px; flex-shrink: 0; margin-right: 4px; font-size: 11px; padding: 2px; white-space: nowrap; }
.motion-debug-toggle input { width: 14px; height: 14px; margin-right: 4px; }
.motion-debug-toggle span { width: 42px; flex-shrink: 0; }
#viewport-motion-status { display: none; position: absolute; right: 8px; bottom: 8px; width: 70%; max-width: 600px; padding: 3px 4px; font-size: 11px; line-height: 14px; white-space: normal; color: #ffffff; background-color: #151519dd; pointer-events: none; }
#viewport-motion-status.motion-matching-summary { height: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* 候选表只占视口右侧，中心留给角色；短视口滚动读取固定行，不把工具条挤走。 */
#viewport-motion-matching { display: none; position: absolute; top: 42px; right: 8px; width: 46%; max-width: 460px; max-height: 60%; padding: 5px 6px; box-sizing: border-box; overflow-y: auto; overflow-x: hidden; font-size: 11px; line-height: 14px; color: #e9edef; background-color: #151519eb; border-width: 1px; border-color: #566067; pointer-events: auto; z-index: 2; }
#motion-matching-title { height: 16px; white-space: nowrap; overflow: hidden; color: #91d5bd; }
#motion-matching-database { display: none; }
.motion-matching-meta { height: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* P7 时间轴：只控制被聚焦控制器；暂停后 seek 不恢复播放，由 play 显式恢复。 */
.motion-timeline { display: flex; height: 16px; align-items: center; margin: 0 0 1px 0; }
.motion-timeline button { width: 18px; height: 14px; min-height: 0; padding: 1px 3px; margin: 0 3px 0 0; flex-shrink: 0; border-width: 0; background-color: #35413c; }
.motion-timeline button img { width: 11px; height: 11px; }
.motion-timeline input { flex: 1; min-width: 0; height: 12px; margin: 0 4px 0 0; }
.motion-replay-row { height: 15px; }
.motion-replay-toggle { display: flex; align-items: center; width: 58px; flex-shrink: 0; font-size: 11px; }
.motion-replay-toggle input { width: 12px; height: 12px; margin: 0 3px 0 0; }
#motion-replay-status { width: 70px; flex-shrink: 0; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #a0b1b9; }
#motion-timeline-status { width: 82px; flex-shrink: 0; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #a0b1b9; }
.motion-candidate { position: relative; height: 26px; box-sizing: border-box; border-top-width: 1px; border-color: #393d41; }
.motion-candidate-heading { display: flex; height: 13px; line-height: 12px; align-items: center; }
.motion-candidate-kind { width: 46px; flex-shrink: 0; color: #a0b1b9; }
.motion-candidate-clip { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.motion-candidate-time { width: 45px; flex-shrink: 0; text-align: right; white-space: nowrap; overflow: hidden; margin-right: 5px; }
.motion-candidate-costs { display: flex; height: 12px; line-height: 12px; }
.motion-candidate-costs span { width: 25%; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.motion-cost-labels { margin-top: 1px; color: #9aabb3; }
.motion-candidate-reason { width: 100px; height: 13px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #8cbcab; }
.motion-rejected .motion-candidate-reason { color: #e1b17a; }
.motion-candidate-detail { display: none; position: absolute; top: 13px; right: 0; width: 100%; padding: 4px; box-sizing: border-box; white-space: normal; word-break: break-all; color: #eeeeef; background-color: #121214; border-width: 1px; border-color: #6e6e76; pointer-events: none; z-index: 5; }
.motion-candidate:hover .motion-candidate-detail { display: block; }
.motion-query-heading { display: flex; height: 14px; }
.motion-query-heading .motion-matching-meta { flex: 1; min-width: 0; }
#motion-query-toggle { position: relative; width: 18px; height: 14px; min-height: 0; padding: 1px 3px; margin: 0; flex-shrink: 0; border-width: 0; background-color: #35413c; }
#motion-query-toggle.active { background-color: #557d69; }
#motion-query-toggle img { width: 12px; height: 12px; }
.motion-query-hint { display: none; position: absolute; right: 0; top: 14px; width: 104px; padding: 3px; background-color: #121214; color: #eeeeef; pointer-events: none; z-index: 5; }
#motion-query-toggle:hover .motion-query-hint { display: block; }
#motion-query-details { display: none; }
#viewport-motion-matching.query-expanded #motion-query-details { display: block; }
#viewport-motion-matching.query-expanded #motion-matching-rows, #viewport-motion-matching.query-expanded #motion-matching-cost-labels { display: none; }
.motion-query-identity { white-space: normal; word-break: break-all; line-height: 14px; margin-bottom: 4px; color: #a0b1b9; }
.motion-query-channel { border-top-width: 1px; border-color: #393d41; padding: 2px 0; }
.motion-query-channel-name { white-space: normal; word-break: break-all; line-height: 14px; }
.motion-query-channel-values { display: flex; height: 14px; }
.motion-query-channel-values span { width: 50%; white-space: nowrap; }
#debug-draw-popup { width: 230px; padding: 8px; }
#debug-draw-owner { width: 100%; margin: 6px 0; }
#debug-draw-categories { max-height: 190px; overflow: auto; }
.debug-draw-check { display: flex; align-items: center; min-height: 24px; }
.debug-draw-check input { width: 14px; height: 14px; margin-right: 6px; }
.debug-draw-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 6px; }
#resource-motion-features { display: none; }
#resource-motion-status { font-size: 11px; white-space: normal; }
.motion-feature-row { display: flex; justify-content: space-between; border-bottom: 1px #39393d; padding: 3px 0px; font-size: 11px; }
.motion-feature-row span:first-child { width: 76%; white-space: normal; }
