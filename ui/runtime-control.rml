<rml>
    <head>
        <title>VulkanLearn Runtime UI</title>
        <link type="text/rcss" href="runtime-control.rcss" />
    </head>
    <body data-model="game_ui">
        <div id="ui-root">
            <div id="hud">
                <div class="hud-card">
                    <div class="hud-scene">{{world_text}}</div>
                </div>
            </div>

            <div id="control-backdrop">
                <div id="control-panel">
                    <div class="panel-top-mask"></div>

                    <div class="panel-header">
                        <div class="panel-heading">
                            <h1>{{panel_title}}</h1>
                            <p>{{panel_subtitle}}</p>
                        </div>
                        <button id="close-button" class="close-button" data-event-click="close_page">{{close_label}}</button>
                    </div>

                    <div class="panel-tabs">
                        <button data-class-selected="active_section == 0" data-event-click="active_section = 0">{{tab_overview_label}}</button>
                        <button data-class-selected="active_section == 1" data-event-click="active_section = 1">{{tab_visualization_label}}</button>
                        <button data-class-selected="active_section == 2" data-event-click="active_section = 2">{{tab_post_process_label}}</button>
                        <button data-class-selected="active_section == 3" data-event-click="active_section = 3">{{tab_environment_label}}</button>
                        <button data-class-selected="active_section == 4" data-event-click="active_section = 4">{{tab_shadows_label}}</button>
                        <button data-class-selected="active_section == 5" data-event-click="active_section = 5">{{tab_scenes_label}}</button>
                        <button data-class-selected="active_section == 6" data-event-click="active_section = 6">{{tab_system_label}}</button>
                    </div>

                    <div id="control-scroll">
                        <div class="section-page" data-if="active_section == 0">
                            <h2>{{tab_overview_label}}</h2>
                            <div class="status-card">
                                <div class="status-row">
                                    <div class="status-label">{{frame_label}}</div>
                                    <div class="status-value">{{frame_value}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{fps_label}}</div>
                                    <div class="status-value">{{fps_value}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{scene_label}}</div>
                                    <div class="status-value">{{world_text}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{debug_view_label}}</div>
                                    <div class="status-value">{{debug_view_value}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{wind_profiles_label}}</div>
                                    <div class="status-value">{{wind_profiles_value}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{input_mode_label}}</div>
                                    <div class="status-value">{{input_mode_value}}</div>
                                </div>
                            </div>

                            <div class="status-card status-card-wide">
                                <div class="status-row status-row-multiline">
                                    <div class="status-label">{{hot_reload_label}}</div>
                                    <div class="status-detail">{{hot_reload_status}}</div>
                                </div>
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 1">
                            <div class="section-heading-row">
                                <h2>{{tab_visualization_label}}</h2>
                                <div class="section-current">{{debug_view_value}}</div>
                            </div>
                            <div class="debug-grid">
                                <div class="debug-group">
                                    <div class="debug-group-title">{{debug_material_group_label}}</div>
                                <button data-class-selected="debug_view_mode == 0" data-event-click="set_debug_view(0)">{{debug_full_label}}</button>
                                <button data-class-selected="debug_view_mode == 1" data-event-click="set_debug_view(1)">{{debug_base_color_label}}</button>
                                <button data-class-selected="debug_view_mode == 2" data-event-click="set_debug_view(2)">{{debug_emissive_label}}</button>
                                <button data-class-selected="debug_view_mode == 3" data-event-click="set_debug_view(3)">{{debug_normal_label}}</button>
                                <button data-class-selected="debug_view_mode == 4" data-event-click="set_debug_view(4)">{{debug_roughness_label}}</button>
                                <button data-class-selected="debug_view_mode == 5" data-event-click="set_debug_view(5)">{{debug_metallic_label}}</button>
                                <button data-class-selected="debug_view_mode == 6" data-event-click="set_debug_view(6)">{{debug_ao_label}}</button>
                                <button data-class-selected="debug_view_mode == 7" data-event-click="set_debug_view(7)">{{debug_shadow_label}}</button>
                                <button data-class-selected="debug_view_mode == 8" data-event-click="set_debug_view(8)">{{debug_direct_lighting_label}}</button>
                                <button data-class-selected="debug_view_mode == 9" data-event-click="set_debug_view(9)">{{debug_indirect_diffuse_label}}</button>
                                <button data-class-selected="debug_view_mode == 10" data-event-click="set_debug_view(10)">{{debug_indirect_specular_label}}</button>
                                <button data-class-selected="debug_view_mode == 11" data-event-click="set_debug_view(11)">{{debug_shadow_cascade_label}}</button>
                                <button data-class-selected="debug_view_mode == 12" data-event-click="set_debug_view(12)">{{debug_shading_model_label}}</button>
                                </div>
                                <div class="debug-group">
                                    <div class="debug-group-title">{{debug_sss_group_label}}</div>
                                <button data-class-selected="debug_view_mode == 13" data-event-click="set_debug_view(13)">{{debug_subsurface_weight_label}}</button>
                                <button data-class-selected="debug_view_mode == 14" data-event-click="set_debug_view(14)">{{debug_transmission_weight_label}}</button>
                                <button data-class-selected="debug_view_mode == 15" data-event-click="set_debug_view(15)">{{debug_subsurface_asset_id_label}}</button>
                                <button data-class-selected="debug_view_mode == 16" data-event-click="set_debug_view(16)">{{debug_local_subsurface_label}}</button>
                                <button data-class-selected="debug_view_mode == 17" data-event-click="set_debug_view(17)">{{debug_diffuse_before_sss_label}}</button>
                                <button data-class-selected="debug_view_mode == 18" data-event-click="set_debug_view(18)">{{debug_diffuse_after_sss_label}}</button>
                                <button data-class-selected="debug_view_mode == 19" data-event-click="set_debug_view(19)">{{debug_sss_pixel_radius_label}}</button>
                                <button data-class-selected="debug_view_mode == 20" data-event-click="set_debug_view(20)">{{debug_sss_valid_weight_label}}</button>
                                </div>
                                <div class="debug-group">
                                    <div class="debug-group-title">{{debug_hair_group_label}}</div>
                                <button data-class-selected="debug_view_mode == 21" data-event-click="set_debug_view(21)">{{debug_hair_world_tangent_label}}</button>
                                <button data-class-selected="debug_view_mode == 22" data-event-click="set_debug_view(22)">{{debug_hair_tangent_rootward_label}}</button>
                                <button data-class-selected="debug_view_mode == 23" data-event-click="set_debug_view(23)">{{debug_hair_theta_io_label}}</button>
                                <button data-class-selected="debug_view_mode == 24" data-event-click="set_debug_view(24)">{{debug_hair_delta_phi_label}}</button>
                                <button data-class-selected="debug_view_mode == 25" data-event-click="set_debug_view(25)">{{debug_hair_r_label}}</button>
                                <button data-class-selected="debug_view_mode == 26" data-event-click="set_debug_view(26)">{{debug_hair_tt_label}}</button>
                                <button data-class-selected="debug_view_mode == 27" data-event-click="set_debug_view(27)">{{debug_hair_trt_label}}</button>
                                <button data-class-selected="debug_view_mode == 28" data-event-click="set_debug_view(28)">{{debug_hair_path_length_label}}</button>
                                <button data-class-selected="debug_view_mode == 29" data-event-click="set_debug_view(29)">{{debug_hair_absorption_label}}</button>
                                <button data-class-selected="debug_view_mode == 30" data-event-click="set_debug_view(30)">{{debug_hair_coverage_label}}</button>
                                <button data-class-selected="debug_view_mode == 31" data-event-click="set_debug_view(31)">{{debug_hair_shadow_transmittance_label}}</button>
                                <button data-class-selected="debug_view_mode == 32" data-event-click="set_debug_view(32)">{{debug_hair_lut_coordinates_label}}</button>
                                <button data-class-selected="debug_view_mode == 33" data-event-click="set_debug_view(33)">{{debug_hair_primary_highlight_label}}</button>
                                <button data-class-selected="debug_view_mode == 34" data-event-click="set_debug_view(34)">{{debug_hair_secondary_highlight_label}}</button>
                                <button data-class-selected="debug_view_mode == 35" data-event-click="set_debug_view(35)">{{debug_hair_scatter_label}}</button>
                                <button data-class-selected="debug_view_mode == 36" data-event-click="set_debug_view(36)">{{debug_hair_backlit_label}}</button>
                                <button data-class-selected="debug_view_mode == 37" data-event-click="set_debug_view(37)">{{debug_hair_r_path_color_label}}</button>
                                <button data-class-selected="debug_view_mode == 38" data-event-click="set_debug_view(38)">{{debug_hair_tt_path_color_label}}</button>
                                <button data-class-selected="debug_view_mode == 39" data-event-click="set_debug_view(39)">{{debug_hair_trt_path_color_label}}</button>
                                <button data-class-selected="debug_view_mode == 40" data-event-click="set_debug_view(40)">{{debug_hair_ibl_fallback_label}}</button>
                                <button data-class-selected="debug_view_mode == 41" data-event-click="set_debug_view(41)">{{debug_hair_ms_fallback_label}}</button>
                                </div>
                                <div class="debug-group">
                                    <div class="debug-group-title">{{debug_eye_group_label}}</div>
                                    <button data-class-selected="debug_view_mode == 42" data-event-click="set_debug_view(42)">{{debug_eye_frame_label}}</button>
                                    <button data-class-selected="debug_view_mode == 43" data-event-click="set_debug_view(43)">{{debug_eye_cornea_normal_label}}</button>
                                    <button data-class-selected="debug_view_mode == 44" data-event-click="set_debug_view(44)">{{debug_eye_iris_normal_label}}</button>
                                    <button data-class-selected="debug_view_mode == 45" data-event-click="set_debug_view(45)">{{debug_eye_iris_plane_normal_label}}</button>
                                    <button data-class-selected="debug_view_mode == 46" data-event-click="set_debug_view(46)">{{debug_eye_cornea_fresnel_label}}</button>
                                    <button data-class-selected="debug_view_mode == 47" data-event-click="set_debug_view(47)">{{debug_eye_cornea_specular_label}}</button>
                                    <button data-class-selected="debug_view_mode == 48" data-event-click="set_debug_view(48)">{{debug_eye_refracted_view_direction_label}}</button>
                                    <button data-class-selected="debug_view_mode == 49" data-event-click="set_debug_view(49)">{{debug_eye_iris_hit_distance_label}}</button>
                                    <button data-class-selected="debug_view_mode == 50" data-event-click="set_debug_view(50)">{{debug_eye_iris_uv_label}}</button>
                                    <button data-class-selected="debug_view_mode == 51" data-event-click="set_debug_view(51)">{{debug_eye_valid_iris_hit_label}}</button>
                                    <button data-class-selected="debug_view_mode == 52" data-event-click="set_debug_view(52)">{{debug_eye_iris_mask_label}}</button>
                                    <button data-class-selected="debug_view_mode == 53" data-event-click="set_debug_view(53)">{{debug_eye_pupil_mask_label}}</button>
                                    <button data-class-selected="debug_view_mode == 54" data-event-click="set_debug_view(54)">{{debug_eye_limbus_mask_label}}</button>
                                    <button data-class-selected="debug_view_mode == 55" data-event-click="set_debug_view(55)">{{debug_eye_light_transmission_in_label}}</button>
                                    <button data-class-selected="debug_view_mode == 56" data-event-click="set_debug_view(56)">{{debug_eye_view_transmission_out_label}}</button>
                                    <button data-class-selected="debug_view_mode == 57" data-event-click="set_debug_view(57)">{{debug_eye_iris_direct_label}}</button>
                                    <button data-class-selected="debug_view_mode == 58" data-event-click="set_debug_view(58)">{{debug_eye_sclera_direct_label}}</button>
                                    <button data-class-selected="debug_view_mode == 59" data-event-click="set_debug_view(59)">{{debug_eye_inner_ibl_label}}</button>
                                    <button data-class-selected="debug_view_mode == 60" data-event-click="set_debug_view(60)">{{debug_eye_caustic_gain_label}}</button>
                                    <button data-class-selected="debug_view_mode == 61" data-event-click="set_debug_view(61)">{{debug_eye_inner_shadow_label}}</button>
                                    <button data-class-selected="debug_view_mode == 62" data-event-click="set_debug_view(62)">{{debug_eye_cornea_shadow_label}}</button>
                                    <button data-class-selected="debug_view_mode == 63" data-event-click="set_debug_view(63)">{{debug_eye_profile_label}}</button>
                                </div>
                                <div class="debug-group">
                                    <div class="debug-group-title">{{debug_cloth_group_label}}</div>
                                <button data-class-selected="debug_view_mode == 64" data-event-click="set_debug_view(64)">{{debug_cloth_model_label}}</button>
                                <button data-class-selected="debug_view_mode == 65" data-event-click="set_debug_view(65)">{{debug_cloth_sheen_color_label}}</button>
                                <button data-class-selected="debug_view_mode == 66" data-event-click="set_debug_view(66)">{{debug_cloth_sheen_roughness_label}}</button>
                                <button data-class-selected="debug_view_mode == 67" data-event-click="set_debug_view(67)">{{debug_cloth_charlie_d_label}}</button>
                                <button data-class-selected="debug_view_mode == 68" data-event-click="set_debug_view(68)">{{debug_cloth_neubelt_visibility_label}}</button>
                                <button data-class-selected="debug_view_mode == 69" data-event-click="set_debug_view(69)">{{debug_cloth_directional_albedo_label}}</button>
                                <button data-class-selected="debug_view_mode == 70" data-event-click="set_debug_view(70)">{{debug_cloth_base_energy_scale_label}}</button>
                                <button data-class-selected="debug_view_mode == 71" data-event-click="set_debug_view(71)">{{debug_cloth_direct_sheen_label}}</button>
                                <button data-class-selected="debug_view_mode == 72" data-event-click="set_debug_view(72)">{{debug_cloth_indirect_sheen_label}}</button>
                                <button data-class-selected="debug_view_mode == 73" data-event-click="set_debug_view(73)">{{debug_cloth_ibl_fallback_label}}</button>
                                <button data-class-selected="debug_view_mode == 80" data-event-click="set_debug_view(80)">{{debug_cloth_v2_model_label}}</button>
                                <button data-class-selected="debug_view_mode == 81" data-event-click="set_debug_view(81)">{{debug_cloth_world_tangent_label}}</button>
                                <button data-class-selected="debug_view_mode == 82" data-event-click="set_debug_view(82)">{{debug_cloth_anisotropy_label}}</button>
                                <button data-class-selected="debug_view_mode == 83" data-event-click="set_debug_view(83)">{{debug_cloth_anisotropy_cross_label}}</button>
                                <button data-class-selected="debug_view_mode == 84" data-event-click="set_debug_view(84)">{{debug_cloth_roughness_axes_label}}</button>
                                <button data-class-selected="debug_view_mode == 85" data-event-click="set_debug_view(85)">{{debug_cloth_anisotropic_charlie_d_label}}</button>
                                <button data-class-selected="debug_view_mode == 86" data-event-click="set_debug_view(86)">{{debug_cloth_visibility_label}}</button>
                                <button data-class-selected="debug_view_mode == 87" data-event-click="set_debug_view(87)">{{debug_cloth_v2_directional_albedo_label}}</button>
                                <button data-class-selected="debug_view_mode == 88" data-event-click="set_debug_view(88)">{{debug_cloth_v2_base_energy_scale_label}}</button>
                                <button data-class-selected="debug_view_mode == 89" data-event-click="set_debug_view(89)">{{debug_cloth_v2_ibl_fallback_label}}</button>
                                </div>
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 2">
                            <h2>{{tab_post_process_label}}</h2>

                            <div class="control-row tone-row">
                                <div class="control-topline">
                                    <div class="control-label">{{tone_mapping_label}}</div>
                                    <div class="control-value">{{tone_mapping_value}}</div>
                                </div>
                                <div class="control-buttons tone-buttons">
                                    <button data-class-selected="tone_mapping_mode == 0" data-event-click="tone_none">{{tone_none_label}}</button>
                                    <button data-class-selected="tone_mapping_mode == 1" data-event-click="tone_reinhard">{{tone_reinhard_label}}</button>
                                    <button data-class-selected="tone_mapping_mode == 2" data-event-click="tone_hable">{{tone_hable_label}}</button>
                                    <button data-class-selected="tone_mapping_mode == 3" data-event-click="tone_aces">{{tone_aces_label}}</button>
                                </div>
                            </div>

                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{bloom_strength_label}}</div>
                                    <div class="control-value">{{bloom_strength_value}}</div>
                                </div>
                                <input id="bloom-strength-slider" class="control-slider" type="range" min="0" max="5" step="0.01" data-value="bloom_strength" data-event-change="bloom_strength_changed" />
                            </div>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{bloom_threshold_label}}</div>
                                    <div class="control-value">{{bloom_threshold_value}}</div>
                                </div>
                                <input id="bloom-threshold-slider" class="control-slider" type="range" min="0" max="10" step="0.01" data-value="bloom_threshold" data-event-change="bloom_threshold_changed" />
                            </div>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{bloom_knee_label}}</div>
                                    <div class="control-value">{{bloom_knee_value}}</div>
                                </div>
                                <input id="bloom-knee-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="bloom_knee" data-event-change="bloom_knee_changed" />
                            </div>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{bloom_clamp_label}}</div>
                                    <div class="control-value">{{bloom_clamp_value}}</div>
                                </div>
                                <input id="bloom-clamp-slider" class="control-slider" type="range" min="0" max="100" step="0.5" data-value="bloom_clamp" data-event-change="bloom_clamp_changed" />
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 3">
                            <h2>{{tab_environment_label}}</h2>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{environment_label}}</div>
                                    <div class="control-value">{{environment_value}}</div>
                                </div>
                                <input id="environment-slider" class="control-slider" type="range" min="0" max="8" step="0.01" data-value="environment_intensity" data-event-change="environment_intensity_changed" />
                            </div>

                            <h2>{{vegetation_heading}}</h2>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{wind_strength_label}}</div>
                                    <div class="control-value">{{wind_strength_value}}</div>
                                </div>
                                <input id="speedtree-strength-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="speedtree_strength" data-event-change="speedtree_strength_changed" />
                            </div>

                            <div class="control-row gust-row">
                                <div class="control-topline">
                                    <div class="control-label">{{gusting_label}}</div>
                                    <div class="control-value">{{gusting_value}}</div>
                                </div>
                                <div class="control-buttons gust-buttons">
                                    <button data-class-selected="speedtree_gusting_enabled" data-event-click="set_speedtree_gusting(1)">{{gust_on_label}}</button>
                                    <button data-class-selected="!speedtree_gusting_enabled" data-event-click="set_speedtree_gusting(0)">{{gust_off_label}}</button>
                                    <button data-event-click="force_speedtree_gust">{{gust_once_label}}</button>
                                </div>
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 4">
                            <h2>{{tab_shadows_label}}</h2>

                            <div class="shadow-actions">
                                <button data-event-click="save_csm_to_scene">{{shadow_save_label}}</button>
                            </div>

                            <div class="control-row shadow-toggle-row">
                                <div class="control-topline">
                                    <div class="control-label">{{shadow_cast_shadows_label}}</div>
                                    <div class="control-value">{{shadow_cast_shadows_value}}</div>
                                </div>
                                <div class="control-buttons shadow-toggle-buttons">
                                    <button data-class-selected="csm_cast_shadows" data-event-click="set_csm_cast_shadows(1)">{{shadow_enable_label}}</button>
                                    <button data-class-selected="!csm_cast_shadows" data-event-click="set_csm_cast_shadows(0)">{{shadow_disable_label}}</button>
                                </div>
                            </div>

                            <div data-if="csm_cast_shadows">
                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_dynamic_distance_label}}</div>
                                        <div class="control-value">{{shadow_dynamic_distance_value}}</div>
                                    </div>
                                    <input id="shadow-dynamic-distance-slider" class="control-slider" type="range" min="5" max="1000" step="1" data-value="csm_dynamic_shadow_distance" data-event-change="csm_dynamic_shadow_distance_changed" />
                                </div>

                                <div class="control-row cascade-selector-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_dynamic_cascades_label}}</div>
                                    </div>
                                    <div class="control-buttons cascade-buttons">
                                        <button data-class-selected="csm_dynamic_shadow_cascades == 1" data-event-click="set_csm_dynamic_shadow_cascades(1)">1</button>
                                        <button data-class-selected="csm_dynamic_shadow_cascades == 2" data-event-click="set_csm_dynamic_shadow_cascades(2)">2</button>
                                        <button data-class-selected="csm_dynamic_shadow_cascades == 3" data-event-click="set_csm_dynamic_shadow_cascades(3)">3</button>
                                        <button data-class-selected="csm_dynamic_shadow_cascades == 4" data-event-click="set_csm_dynamic_shadow_cascades(4)">4</button>
                                    </div>
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_cascade_distribution_exponent_label}}</div>
                                        <div class="control-value">{{shadow_cascade_distribution_exponent_value}}</div>
                                    </div>
                                    <input id="shadow-cascade-distribution-exponent-slider" class="control-slider" type="range" min="1" max="10" step="0.1" data-value="csm_cascade_distribution_exponent" data-event-change="csm_cascade_distribution_exponent_changed" />
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_cascade_transition_fraction_label}}</div>
                                        <div class="control-value">{{shadow_cascade_transition_fraction_value}}</div>
                                    </div>
                                    <input id="shadow-cascade-transition-fraction-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="csm_cascade_transition_fraction" data-event-change="csm_cascade_transition_fraction_changed" />
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_distance_fadeout_fraction_label}}</div>
                                        <div class="control-value">{{shadow_distance_fadeout_fraction_value}}</div>
                                    </div>
                                    <input id="shadow-distance-fadeout-fraction-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="csm_shadow_distance_fadeout_fraction" data-event-change="csm_shadow_distance_fadeout_fraction_changed" />
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_bias_label}}</div>
                                        <div class="control-value">{{shadow_bias_value}}</div>
                                    </div>
                                    <input id="shadow-bias-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="csm_shadow_bias" data-event-change="csm_shadow_bias_changed" />
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_slope_bias_label}}</div>
                                        <div class="control-value">{{shadow_slope_bias_value}}</div>
                                    </div>
                                    <input id="shadow-slope-bias-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="csm_shadow_slope_bias" data-event-change="csm_shadow_slope_bias_changed" />
                                </div>

                                <div class="control-row slider-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_cascade_bias_distribution_label}}</div>
                                        <div class="control-value">{{shadow_cascade_bias_distribution_value}}</div>
                                    </div>
                                    <input id="shadow-cascade-bias-distribution-slider" class="control-slider" type="range" min="0" max="1" step="0.01" data-value="csm_shadow_cascade_bias_distribution" data-event-change="csm_shadow_cascade_bias_distribution_changed" />
                                </div>

                                <div class="control-row shadow-debug-row">
                                    <div class="control-topline">
                                        <div class="control-label">{{shadow_debug_label}}</div>
                                    </div>
                                    <div class="control-buttons shadow-toggle-buttons">
                                        <button data-class-selected="debug_view_mode == 0" data-event-click="set_debug_view(0)">{{shadow_debug_full_label}}</button>
                                        <button data-class-selected="debug_view_mode == 11" data-event-click="set_debug_view(11)">{{shadow_debug_cascades_label}}</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 5">
                            <h2>{{scene_list_title}}</h2>
                            <div class="scene-current-card">
                                <div class="scene-current-label">{{scene_label}}</div>
                                <div class="scene-current-value">{{world_text}}</div>
                                <div class="scene-list-hint">{{scene_list_hint}}</div>
                                <div class="scene-loading" data-if="scene_loading">{{scene_loading_label}}</div>
                            </div>

                            <div class="scene-list">
                                <button data-for="scene : scene_options" data-class-selected="scene.active" data-event-click="load_scene(scene.path)">
                                    <div class="scene-option-label">{{scene.label}}</div>
                                    <div class="scene-option-path">{{scene.path}}</div>
                                </button>
                                <div class="scene-empty" data-if="scene_options.size == 0">{{scene_empty_label}}</div>
                            </div>
                        </div>

                        <div class="section-page" data-if="active_section == 6">
                            <h2>{{tab_system_label}}</h2>
                            <div class="control-row slider-row">
                                <div class="control-topline">
                                    <div class="control-label">{{camera_move_speed_label}}</div>
                                    <div class="control-value">{{camera_move_speed_value}}</div>
                                </div>
                                <input id="camera-move-speed-slider" class="control-slider" type="range" min="0.5" max="100" step="0.5" data-value="camera_move_speed" data-event-change="camera_move_speed_changed" />
                            </div>
                            <div class="status-card">
                                <div class="status-row">
                                    <div class="status-label">{{locale_label}}</div>
                                    <div class="status-value">{{locale_value}}</div>
                                </div>
                                <div class="status-row">
                                    <div class="status-label">{{developer_ui_label}}</div>
                                    <div class="status-value">{{developer_ui_value}}</div>
                                </div>
                            </div>

                            <div class="system-actions">
                                <button data-class-selected="locale_value == 'en-US'" data-event-click="locale_en">English</button>
                                <button data-class-selected="locale_value == 'zh-CN'" data-event-click="locale_zh">简体中文</button>
                                <button class="wide-action" data-event-click="toggle_developer_ui">{{developer_ui_toggle_label}}</button>
                                <button class="danger-action wide-action" data-event-click="quit">{{quit_label}}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</rml>
