body {
    font-family: "Segoe UI";
    font-size: 15dp;
    color: #f4f7ff;
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

#ui-root {
    width: 100%;
    height: 100%;
}

#hud {
    position: absolute;
    left: 18dp;
    top: 18dp;
    padding: 8dp 12dp;
    background-color: #0c1222c2;
    white-space: nowrap;
}
