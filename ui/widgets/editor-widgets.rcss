div, p, h1, h2, h3, label { display: block; }
h1, h2, h3, p { margin: 0; }
h1 { font-size: 17px; font-weight: bold; }
h2 { font-size: 13px; font-weight: bold; }
h3 {
    font-size: 12px;
    font-weight: bold;
    padding: 9px 0 6px 0;
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: #414144;
    color: #a6c6ba;
}
button {
    display: inline-block;
    font-size: 12px;
    color: #e7e7e9;
    background-color: #3c3c40;
    border-width: 1px;
    border-color: #4b4b50;
    border-radius: 2px;
    padding: 4px 8px;
    min-height: 18px;
    cursor: pointer;
}
button:hover { background-color: #505057; }
button:active { background-color: #626269; }
button.selected { background-color: #2a665b; border-color: #50867a; }
button.disabled, button:disabled {
    color: #85858b;
    background-color: #303034;
    cursor: arrow;
}
input, select {
    display: inline-block;
    font-size: 12px;
    color: #f2f2f3;
    background-color: #202023;
    border-width: 1px;
    border-color: #49494f;
    padding: 4px 5px;
    height: 18px;
    min-width: 0;
}
input:focus, select:focus { border-color: #62a58d; }
select { width: 100%; height: 20px; }
selectvalue { overflow: hidden; white-space: nowrap; }
selectbox {
    background-color: #28282c;
    border-width: 1px;
    border-color: #66666d;
    max-height: 280px;
    overflow: auto;
}
option { padding: 5px; white-space: nowrap; }
option:hover, option:checked { background-color: #35594e; }
.horizontal-box { display: flex; }
.vertical-box { display: block; min-width: 0; }
.scroll-box { overflow: auto; }
/* RmlUi 的滚动条必须显式约束尺寸，否则 auto 宽度会挤掉滚动容器的内容区。 */
scrollbarvertical { width: 10px; margin-left: 2px; background-color: #202023; }
scrollbarhorizontal { height: 10px; margin-top: 2px; background-color: #202023; }
scrollbarvertical sliderbar { width: 8px; min-height: 24px; background-color: #616168; }
scrollbarhorizontal sliderbar { height: 8px; min-width: 24px; background-color: #616168; }
sliderbar:hover { background-color: #7a7a83; }
sliderbar:active { background-color: #9797a0; }
sliderarrowdec, sliderarrowinc { display: none; }
.list-item {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 2px 0;
    padding: 5px 7px;
    border-width: 0;
    background-color: transparent;
    text-align: left;
    white-space: normal;
}
.tree-row { display: flex; align-items: center; box-sizing: border-box; }
.tree-row .list-item { flex: 1; min-width: 0; width: auto; }
.tree-toggle, .tree-spacer {
    display: block;
    width: 20px;
    height: 26px;
    box-sizing: border-box;
    flex-shrink: 0;
}
.tree-toggle { padding: 3px; min-height: 0; border-width: 0; background-color: transparent; }
/* 外层宽度不能依赖 flex:1 子节点的固有尺寸，否则标签正文会被布局成零宽。 */
.document-tab { display: flex; flex-shrink: 0; width: 200px; height: 28px; }
.document-tab .list-item {
    display: flex; align-items: center; width: auto; flex: 1; min-width: 0; flex-shrink: 1;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.document-tab .tab-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.document-tab .row-icon { flex-shrink: 0; width: 16px; height: 16px; margin-right: 6px; }
.document-tab .tab-close { min-width: 0; }
.document-tab .tab-close:hover { background-color: #56565c; }
.tab-close { flex-shrink: 0; width: 24px; box-sizing: border-box; background-color: transparent; border-width: 0; padding: 4px 6px; }
.segmented, .command-row { display: flex; margin: 5px 0; }
.segmented button { flex: 1; min-width: 0; }
.command-row button { flex: 1; min-width: 0; margin-right: 4px; }
.command-row button:last-child { margin-right: 0; }
.property-row { display: flex; align-items: center; margin: 5px 0; }
.property-row label { flex: 1; min-width: 0; }
.property-row input, .property-row select { width: 42%; }
.property-info { display: flex; align-items: center; margin: 3px 0; }
.property-info label { flex: 1; min-width: 0; font-size: 11px; color: #a5a5ad; }
.property-info span { flex: 1; min-width: 0; font-size: 11px; color: #e7e7e9; word-break: break-all; }
.property-heading { display: flex; align-items: center; margin-bottom: 5px; }
.property-heading label { flex: 1; min-width: 0; white-space: normal; }
.property-heading button { font-size: 11px; padding: 2px 5px; min-height: 14px; }
.parameter { padding: 6px 0; }
.component { flex: 1; min-width: 0; padding-right: 4px; }
.component:last-child { padding-right: 0; }
.component label { font-size: 10px; color: #babac2; margin-bottom: 3px; white-space: normal; }
.component input { width: 100%; box-sizing: border-box; height: 27px; }
.muted { color: #a5a5ad; font-size: 11px; line-height: 15px; margin: 5px 0; }
.notice { color: #e5c17b; font-size: 11px; line-height: 15px; margin-top: 5px; }

/* 折叠分组：展开状态是根节点上的 collapsed class，切换不重写分组 DOM。
   箭头用基础字形并在 markup 里同时提供两种标记，RCSS 不支持 content 属性。 */
.details-section { display: block; }
.details-section-title {
    display: block;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
    font-size: 12px;
    font-weight: bold;
    color: #a6c6ba;
    background-color: transparent;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: #414144;
    border-radius: 0;
    padding: 9px 0 6px 0;
    margin-top: 6px;
    min-height: 0;
    cursor: pointer;
}
.details-section-title:hover { background-color: #2c2c30; }
.details-section .section-marker-expanded { display: inline; padding-right: 5px; }
.details-section .section-marker-collapsed { display: none; }
.details-section.collapsed .section-marker-expanded { display: none; }
.details-section.collapsed .section-marker-collapsed { display: inline; padding-right: 5px; }
.details-section.collapsed .details-section-body { display: none; }

/* input type="range" 的轨道与滑块是 RmlUi 生成的非 DOM 子元素，
   必须在这里显式给出尺寸与配色，否则沿用上面的 input 高度会把轨道压没。 */
.component input.range {
    display: block;
    width: 100%;
    box-sizing: border-box;
    height: 12px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}
.component input.range slidertrack {
    display: block;
    height: 6px;
    margin-top: 3px;
    background-color: #303034;
    border-width: 1px;
    border-color: #49494f;
}
.component input.range sliderprogress { display: block; height: 4px; background-color: #2a665b; }
.component input.range sliderbar {
    display: block;
    width: 10px;
    height: 12px;
    background-color: #c8c8cf;
    border-width: 1px;
    border-color: #6a6a72;
}
.component input.range sliderbar:hover { background-color: #e2e2e8; }
.component input.range sliderbar:active { background-color: #ffffff; }

.color-preview { display: flex; align-items: center; margin: 4px 0; }
.color-swatch {
    display: block;
    width: 46px;
    height: 16px;
    background-color: #202023;
    border-width: 1px;
    border-color: #49494f;
}
.color-hex { display: block; font-size: 11px; color: #cbcdd4; margin-left: 6px; }
