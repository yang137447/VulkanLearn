<rml>
    <head>
        <title>VulkanLearn HUD</title>
        <link type="text/rcss" href="runtime-hud.rcss" />
    </head>
    <body data-model="game_ui">
        <div id="ui-root">
            <div id="hud">
                <div>{{world_text}}</div>
                <div id="gameplay-hud" data-if="gameplay_text != ''">{{gameplay_text}}</div>
            </div>
        </div>
    </body>
</rml>
