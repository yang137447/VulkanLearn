  "cards": [
    {
      "dot": "emerald",
      "title": "提交前一切都在隔离副本里",
      "items": [
        "候选图、候选 World、运行时绑定、管线候选提交与 shader 制品都在 live 状态之外准备",
        "因此准备阶段的任何一种失败都不需要回滚：live 状态从未被触碰",
        "见 source/world/loading/worldGraphTransactionCoordinator.cpp 的 185-274 行"
      ]
    },
    {
      "dot": "rose",
      "title": "提交是一段不可失败的字节拷贝序列",
      "items": [
        "提交顺序固定：shader 制品 → 管线候选 → World 激活 → 运行时绑定 → 资源缓存",
        "提交点之后没有回滚路径，这是设计而非缺失：回滚要靠提前校验而不是事后撤销",
        "见 373-408 行与文件头 38-42 行的所有权说明"
      ]
    },
    {
      "dot": "orange",
      "title": "退休在提交之后才被激活",
      "items": [
        "旧 World / 图 / World-local 资源 / 帧灯光缓冲先登记为 prepared retirements",
        "只在 live 引用完成交换后才随 GPU epoch 退休，避免渲染线程读到已释放资源",
        "见 330-357 行的退休登记与 399-409 行的提交"
      ]
    },
    {
      "dot": "cyan",
      "title": "可注入的故障点就是这套状态机的测试面",
      "items": [
        "WorldGraphTransactionTestFaultInjection 覆盖图资源、render pass、framebuffer、descriptor、pass 材质契约、候选 World 构建、view target 预检、运行时绑定与提交前",
        "runtime test：main.exe --world-graph-transaction-test --exit-after-tests"
      ]
    }
  ]
