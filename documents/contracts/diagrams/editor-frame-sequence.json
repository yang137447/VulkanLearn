  "cards": [
    {
      "dot": "emerald",
      "title": "UI 独占输入是有意设计",
      "items": [
        "事件先交给 UI；UI 消费则游戏不接管，避免点按钮同时驱动相机",
        "视口命中判定排除视口工具条本身",
        "见 source/ui/uiSubsystem.cpp 的 HandlePlatformEvent 与 IsScenePickTarget"
      ]
    },
    {
      "dot": "orange",
      "title": "每帧重建快照，没有缓存",
      "items": [
        "两条路径都每帧发布快照：多线程走发布 + 提交帧，单线程直接 Render()",
        "因此可见性开关下一帧即上屏，不需要 World 事务",
        "见 source/engine/engineLoop.cpp:575 与 source/renderSystem.cpp:2835"
      ]
    },
    {
      "dot": "rose",
      "title": "可见性在快照构建处收口",
      "items": [
        "过滤发生在快照构建，不在渲染器分支",
        "绘制、拾取、材质实例上下文、阴影共用同一份 meshDraws",
        "见 source/world/worldSnapshotBuilder.cpp 的 mesh 与灯光循环"
      ]
    }
  ]
