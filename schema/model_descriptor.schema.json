{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/model_descriptor.schema.json",
    "title": "Model Descriptor",
    "description": "VulkanLearn 模型描述配置",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "模型描述名称，通常用于说明这个 SM 文件对应的资源。"
        },
        "type": {
            "type": "string",
            "enum": ["mesh", "speedtree", "tressfx"],
            "description": "mesh 为 Assimp，speedtree 为 SpeedTree，tressfx 为静态 TFX guide ribbon。"
        },
        "strandRadius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "tressfx 局部空间半径，使用作者坐标单位；不自动换轴或换算单位。"
        },
        "simulation": {
            "type": "object",
            "description": "tressfx guide 模拟作者参数，单位沿用项目世界契约：位置为厘米，加速度为厘米/秒²。",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "false 时使用静态中心线，不创建 CPU solver 或 GPU 模拟 buffer。"
                },
                "gravity": {
                    "type": "array",
                    "description": "重力加速度 xyz，单位厘米/秒²。",
                    "items": {"type": "number"},
                    "minItems": 3,
                    "maxItems": 3
                },
                "wind": {
                    "type": "array",
                    "description": "风加速度 xyz，单位厘米/秒²，与重力相加后进入积分。",
                    "items": {"type": "number"},
                    "minItems": 3,
                    "maxItems": 3
                },
                "damping": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Verlet 速度保留系数，作用于 (pos - prev) 差值。"
                },
                "iterations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16,
                    "description": "每帧顺序长度投影的扫描次数；GPU backend 在一次 dispatch 内展开，上限 16 避免异常值触发 TDR。"
                },
                "rootFixedPoints": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32,
                    "description": "每根 guide 从根部起固定的点数；逆质量 <= 0 的点也固定。"
                },
                "maxDt": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 0.25,
                    "description": "单帧 delta time 上限，单位秒；超出部分丢弃，不做子步进。"
                },
                "backend": {
                    "type": "string",
                    "enum": ["cpu", "gpu"],
                    "description": "cpu 为游戏线程参考 solver；gpu 为 compute dispatch，CPU 不写位置 buffer。"
                }
            },
            "additionalProperties": false
        },
        "modelDataPath": {
            "type": "string",
            "description": "原始模型数据文件相对路径，例如 'models/datas/my_mesh.obj'。"
        },
        "importOptions": {
            "type": "object",
            "description": "导入阶段选项；可限制普通模型只导入指定几何 section。",
            "properties": {
                "generateSmoothNormals": {
                    "type": "boolean"
                },
                "includedSectionNames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "skinning": {
            "type": "object",
            "properties": {
                "skeleton": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "sourceModel": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "retarget": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "clips": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "minLength": 1},
                            "path": {"type": "string", "minLength": 1},
                            "sequence": {"type": "string", "minLength": 1, "pattern": "\\.json$"}
                        },
                        "required": ["id", "path"],
                        "additionalProperties": false
                    }
                },
                "montages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "minLength": 1},
                            "path": {"type": "string", "minLength": 1, "pattern": "\\.json$"}
                        },
                        "required": ["id", "path"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["skeleton", "clips"],
            "dependencies": {
                "sourceModel": ["retarget"],
                "retarget": ["sourceModel"]
            },
            "allOf": [{
                "if": {"required": ["sourceModel"]},
                "then": {
                    "properties": {
                        "clips": {"maxItems": 0},
                        "montages": {"maxItems": 0}
                    }
                }
            }],
            "additionalProperties": false
        },
        "materialSlots": {
            "type": "array",
            "description": "按源模型材质槽顺序排列的材质实例绑定。单材质模型也使用一个数组元素。",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "VulkanLearn 侧材质槽显示名称，仅用于配置可读性和调试；运行时按数组顺序映射。"
                    },
                    "materialInstancePath": {
                        "type": "string",
                        "minLength": 1,
                        "description": "材质实例路径，例如 'materials/MI_my_mesh.json'。"
                    }
                },
                "required": [
                    "name",
                    "materialInstancePath"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "name",
        "type",
        "modelDataPath",
        "materialSlots"
    ],
    "allOf": [
        {
            "if": {"required": ["skinning"]},
            "then": {"properties": {"type": {"const": "mesh"}}}
        },
        {
            "if": {"properties": {"type": {"const": "tressfx"}}, "required": ["type"]},
            "then": {
                "required": ["strandRadius"],
                "properties": {
                    "modelDataPath": {"pattern": "\\.tfx$"},
                    "materialSlots": {"maxItems": 1},
                    "importOptions": false
                }
            }
        }
    ],
    "additionalProperties": false
}
