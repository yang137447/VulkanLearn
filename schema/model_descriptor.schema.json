{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/model_descriptor.schema.json",
    "title": "Model Descriptor",
    "description": "VulkanLearn 模型描述配置",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "模型描述名称，通常用于说明这个 SM 文件对应的资源。"
        },
        "type": {
            "type": "string",
            "enum": ["mesh", "speedtree", "tressfx"],
            "description": "mesh 为 Assimp，speedtree 为 SpeedTree，tressfx 为静态 TFX guide ribbon。"
        },
        "strandRadius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "tressfx 局部空间半径，使用作者坐标单位；不自动换轴或换算单位。"
        },
        "simulation": {
            "type": "object",
            "description": "tressfx guide 模拟作者参数，单位沿用项目世界契约：位置为厘米，加速度为厘米/秒²。",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "false 时使用静态中心线，不创建 CPU solver 或 GPU 模拟 buffer。"
                },
                "gravity": {
                    "type": "array",
                    "description": "重力加速度 xyz，单位厘米/秒²。",
                    "items": {"type": "number"},
                    "minItems": 3,
                    "maxItems": 3
                },
                "wind": {
                    "type": "array",
                    "description": "平均风加速度 xyz，单位厘米/秒²；每帧叠加有界阵风后与重力相加。",
                    "items": {"type": "number"},
                    "minItems": 3,
                    "maxItems": 3
                },
                "damping": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "60 Hz 下每步保留的速度比例；运行时映射为 TressFX 的 DampingCoeff = -ln(damping)，积分内用 exp(-DampingCoeff*dt*60)。"
                },
                "iterations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16,
                    "description": "LengthConstraintsWind pass 的长度约束迭代次数；GPU 在一次 dispatch 内展开，上限 16 避免异常值触发 TDR。"
                },
                "rootFixedPoints": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32,
                    "description": "每根 guide 从根部起固定的点数（TressFX 的 NumVerticesFromRootNoSimulation）；逆质量 <= 0 的点也不可移动。"
                },
                "maxDt": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 0.25,
                    "description": "单帧 delta time 上限，单位秒；clip 后直接作为本帧唯一 solver step 的 dt（变量步长，无 accumulator）。"
                },
                "bendStiffness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "映射到 LocalShape pass 的逐顶点 Stiffness 标量；pass 内按 TressFX 公式再乘 0.5。0 关闭局部形状约束。"
                },
                "windGust": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "阵风幅度；gust = 1 + windGust * sin(2π f t + guide 相位)，乘在四风混合结果上，有界不累积。"
                },
                "windFrequency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "阵风频率，单位 Hz；0 时相位固定。"
                },
                "globalShapeStiffness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "TressFX Integration 的 global shape 强度：把可移动点拉向 InitialPos（蒙皮/静止位置）。0 关闭，既有资产保持原外观。"
                },
                "globalShapeEffectiveRange": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "global shape 作用范围，按每根 strand 顶点数的比例；local < range * pointsPerGuide 的点才受约束。0 关闭。"
                },
                "vspCoefficient": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "TressFX VelocityShockPropagation 基础系数；0 表示关闭（Host 不录制 VSP dispatch）。"
                },
                "vspAccelThresholdMax": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 10000000,
                    "description": "VSP 伪加速度阈值，厘米/秒²；前两个点满足 |new - 2*old + old_old| 超过该值时强制系数 1。默认 5000。"
                },
                "backend": {
                    "type": "string",
                    "enum": ["cpu", "gpu"],
                    "description": "cpu 为游戏线程参考 solver；gpu 为 compute dispatch，CPU 不写位置 buffer。"
                },
                "skinning": {
                    "type": "object",
                    "description": "把发丝根点从 rest pin 改为跟随场景内源角色的骨骼。source 是同一场景的 mesh 对象名，rootBone 是该对象目标骨架的关节名；根点写入 current = previous = M * rest，其余点仍按原约束求解。",
                    "properties": {
                        "source": {
                            "type": "string",
                            "minLength": 1,
                            "description": "源角色场景对象名；解析失败是加载期硬错误。"
                        },
                        "rootBone": {
                            "type": "string",
                            "minLength": 1,
                            "description": "源角色目标骨架（SK）的关节名，大小写敏感；找不到时加载期硬错误。"
                        }
                    },
                    "required": ["source", "rootBone"],
                    "additionalProperties": false
                }
            },
            "allOf": [
                {
                    "if": {"required": ["skinning"]},
                    "then": {
                        "required": ["backend"],
                        "properties": {"backend": {"const": "gpu"}}
                    }
                }
            ],
            "additionalProperties": false
        },
        "collision": {
            "type": "object",
            "description": "tressfx guide 的解析胶囊碰撞；位置/半径使用资产局部空间厘米。",
            "properties": {
                "capsules": {
                    "type": "array",
                    "description": "按顺序应用的胶囊；a == b 表示球。空数组等价于无碰撞。",
                    "maxItems": 8,
                    "items": {
                        "type": "object",
                        "properties": {
                            "a": {
                                "type": "array",
                                "description": "胶囊起点 xyz，资产局部空间厘米。",
                                "items": {"type": "number"},
                                "minItems": 3,
                                "maxItems": 3
                            },
                            "b": {
                                "type": "array",
                                "description": "胶囊终点 xyz，资产局部空间厘米。",
                                "items": {"type": "number"},
                                "minItems": 3,
                                "maxItems": 3
                            },
                            "radius": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "description": "胶囊半径，厘米。"
                            }
                        },
                        "required": ["a", "b", "radius"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["capsules"],
            "additionalProperties": false
        },
        "modelDataPath": {
            "type": "string",
            "description": "原始模型数据文件相对路径，例如 'models/datas/my_mesh.obj'。"
        },
        "importOptions": {
            "type": "object",
            "description": "导入阶段选项；可限制普通模型只导入指定几何 section。",
            "properties": {
                "generateSmoothNormals": {
                    "type": "boolean"
                },
                "includedSectionNames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "skinning": {
            "type": "object",
            "properties": {
                "skeleton": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "sourceModel": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "retarget": {"type": "string", "minLength": 1, "pattern": "\\.json$"},
                "clips": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "minLength": 1},
                            "path": {"type": "string", "minLength": 1},
                            "sequence": {"type": "string", "minLength": 1, "pattern": "\\.json$"}
                        },
                        "required": ["id", "path"],
                        "additionalProperties": false
                    }
                },
                "montages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "minLength": 1},
                            "path": {"type": "string", "minLength": 1, "pattern": "\\.json$"}
                        },
                        "required": ["id", "path"],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["skeleton", "clips"],
            "dependencies": {
                "sourceModel": ["retarget"],
                "retarget": ["sourceModel"]
            },
            "allOf": [{
                "if": {"required": ["sourceModel"]},
                "then": {
                    "properties": {
                        "clips": {"maxItems": 0},
                        "montages": {"maxItems": 0}
                    }
                }
            }],
            "additionalProperties": false
        },
        "materialSlots": {
            "type": "array",
            "description": "按源模型材质槽顺序排列的材质实例绑定。单材质模型也使用一个数组元素。",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "VulkanLearn 侧材质槽显示名称，仅用于配置可读性和调试；运行时按数组顺序映射。"
                    },
                    "materialInstancePath": {
                        "type": "string",
                        "minLength": 1,
                        "description": "材质实例路径，例如 'materials/MI_my_mesh.json'。"
                    }
                },
                "required": [
                    "name",
                    "materialInstancePath"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "name",
        "type",
        "modelDataPath",
        "materialSlots"
    ],
    "allOf": [
        {
            "if": {"required": ["skinning"]},
            "then": {"properties": {"type": {"const": "mesh"}}}
        },
        {
            "if": {"properties": {"type": {"const": "tressfx"}}, "required": ["type"]},
            "then": {
                "required": ["strandRadius"],
                "properties": {
                    "modelDataPath": {"pattern": "\\.tfx$"},
                    "materialSlots": {"maxItems": 1},
                    "importOptions": false
                }
            }
        }
    ],
    "additionalProperties": false
}
