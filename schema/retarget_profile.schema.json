{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/retarget_profile.schema.json",
    "title": "Retarget Profile",
    "type": "object",
    "required": ["format", "sourceSkeleton", "targetSkeleton", "sourceRoot", "targetRoot", "joints"],
    "properties": {
        "format": {"const": "vl.retarget.v1"},
        "sourceSkeleton": {"type": "string", "minLength": 1},
        "targetSkeleton": {"type": "string", "minLength": 1},
        "sourceRoot": {"type": "string", "minLength": 1},
        "targetRoot": {"type": "string", "minLength": 1},
        "joints": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["source", "target"],
                "properties": {
                    "source": {"type": "string", "minLength": 1},
                    "target": {"type": "string", "minLength": 1}
                }
            }
        },
        "sourcePose": {"$ref": "#/definitions/pose"},
        "targetPose": {"$ref": "#/definitions/pose"},
        "preview": {
            "description": "Resource-root-relative editor preview references. Optional targetModelPath enables real animation preview; that SM must use this retarget profile.",
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceSkeletonPath", "targetSkeletonPath"],
            "properties": {
                "sourceSkeletonPath": {"type": "string", "minLength": 1},
                "targetSkeletonPath": {"type": "string", "minLength": 1},
                "targetModelPath": {"type": "string", "minLength": 1}
            }
        }
    },
    "definitions": {
        "pose": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rotationOffsets"],
            "properties": {
                "name": {"type": "string", "minLength": 1},
                "rotationOffsets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["joint", "rotation"],
                        "properties": {
                            "joint": {"type": "string", "minLength": 1},
                            "rotation": {
                                "description": "Unit quaternion [x,y,z,w]; reference local = bind local * offset. Root offsets are rejected by the loader.",
                                "type": "array",
                                "minItems": 4,
                                "maxItems": 4,
                                "items": {"type": "number"}
                            }
                        }
                    }
                }
            }
        }
    }
}
