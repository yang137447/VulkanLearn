{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/material_instance.schema.json",
    "title": "Material Instance",
    "description": "VulkanLearn material instance override format. MI_ files reference an M_ material definition and do not select shader pairs directly.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "const": "materialInstance"
        },
        "configHelp": {
            "type": "string"
        },
        "material": {
            "type": "string",
            "description": "Project-relative path to the referenced M_*.json material definition."
        },
        "renderStateOverrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "renderMode": {
                    "type": "string",
                    "enum": [
                        "Opaque",
                        "OpaqueClip",
                        "TransparentAlphaBlend",
                        "TransparentAdditive"
                    ]
                },
                "cullMode": {
                    "type": "string",
                    "enum": [
                        "Back",
                        "None"
                    ]
                },
                "shadingModel": {
                    "type": "string",
                    "enum": [
                        "DefaultLit",
                        "Unlit",
                        "Subsurface",
                        "PreintegratedSkin",
                        "ClearCoat",
                        "SubsurfaceProfile",
                        "TwoSidedFoliage",
                        "Hair",
                        "Cloth",
                        "Eye"
                    ],
                    "description": "Static shading model override. Top-level shadingModel is intentionally not part of MI_ files."
                }
            }
        },
        "macros": {
            "type": "object",
            "additionalProperties": {
                "type": "number"
            }
        },
        "parameters": {
            "type": "object",
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "number"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 4
                    }
                ]
            }
        },
        "textures": {
            "type": "object",
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "null"
                    }
                ]
            }
        }
    },
    "required": [
        "type",
        "material"
    ]
}
