{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/scene.schema.json",
    "title": "Scene",
    "description": "VulkanLearn 场景资产。本文件按 source/scene/validation/sceneAssetValidator.cpp 与 source/world/loading/worldBuilder.cpp 的当前行为重建：required 列表对应验证器实际强制检查的字段，enum 与约束对应 loader 实际接受的值域。凡本文件与这两处源码不一致，以源码为准并修正本文件。 对象类型定义是自包含的（不用 allOf 组合共享 name/type）：两半各自声明 additionalProperties: false 会互判对方字段为额外字段。 场景对象的额外字段被允许，与 SceneAssetValidator 的行为一致；根级仍然 additionalProperties: false，因为顶层字段由 BuildLoadPlan 显式读取。",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "显示标签；UI 场景选择器用它作为列表项文字。"
        },
        "type": {
            "type": "string",
            "const": "scene"
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "description": "必填且非空。说明这个场景是干什么的、用来验证哪篇文章或书本的哪个知识点；探针场景要写到论文的节号或图号，纯学习场景要写明它不是验证用的。SceneAssetValidator 会拒绝缺失或空串。"
        },
        "objects": {
            "type": "array",
            "description": "场景对象数组。整场景必须至少包含一个 camera 对象，否则加载被拒绝。",
            "items": {
                "oneOf": [
                    {
                        "$ref": "#/$defs/blueprintObject"
                    },
                    {
                        "$ref": "#/$defs/meshObject"
                    },
                    {
                        "$ref": "#/$defs/balloonObject"
                    },
                    {
                        "$ref": "#/$defs/glassPaneObject"
                    },
                    {
                        "$ref": "#/$defs/directionalLightObject"
                    },
                    {
                        "$ref": "#/$defs/pointLightObject"
                    },
                    {
                        "$ref": "#/$defs/spotLightObject"
                    },
                    {
                        "$ref": "#/$defs/squareAreaLightObject"
                    },
                    {
                        "$ref": "#/$defs/cameraObject"
                    },
                    {
                        "$ref": "#/$defs/environmentObject"
                    }
                ]
            }
        },
        "spawnAssets": {
            "type": "array", "maxItems": 128,
            "items": {"type": "string", "minLength": 1},
            "description": "预加载可由 C# Spawn 的蓝图资产，路径相对资源根。Scene 实例引用的蓝图资产也自动可用。"
        },
        "worldUnit": {
            "type": "string",
            "const": "cm",
            "description": "场景位置、尺寸、裁剪面和导入后的世界长度均使用厘米。"
        }
    },
    "required": [
        "name",
        "type",
        "description",
        "worldUnit",
        "objects"
    ],
    "additionalProperties": false,
    "$defs": {
        "blueprintObject": {
            "type": "object",
            "not": {"required": ["actorPath"]},
            "description": "C# 蓝图实例；组件以稳定 id/parent 构成局部 TRS 树，可选根刚体。",
            "properties": {
                "type": { "const": "blueprintInstance" },
                "name": { "type": "string", "minLength": 1 },
                "id": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\|\\u0000]+$" },
                "class": { "type": "string", "minLength": 1 },
                "blueprintPath": { "type": "string", "minLength": 1 },
                "enabled": { "type": "boolean" },
                "position": { "$ref": "#/$defs/vec3" },
                "rotation": { "$ref": "#/$defs/vec3" },
                "scale": { "$ref": "#/$defs/vec3" },
                "properties": {"$ref": "#/$defs/scriptProperties"},
                "physics": {"$ref": "#/$defs/blueprintPhysics"},
                "componentInstanceEditable": false,
                "scriptComponents": {
                    "type": "array", "maxItems": 128,
                    "items": {"$ref": "#/$defs/scriptComponent"}
                },
                "scriptComponentOverrides": {
                    "type": "object", "maxProperties": 128,
                    "propertyNames": {"minLength": 1, "pattern": "^[^/\\\\|\\u0000]+$"},
                    "additionalProperties": {"$ref": "#/$defs/scriptProperties"}
                },
                "componentOverrides": {
                    "type": "object", "maxProperties": 128,
                    "propertyNames": {"minLength": 1, "pattern": "^[^/\\\\|\\u0000]+$"},
                    "additionalProperties": {
                        "type": "object", "maxProperties": 32,
                        "properties": {
                            "position": {"$ref": "#/$defs/vec3"},
                            "rotation": {"$ref": "#/$defs/vec3"},
                            "scale": {"$ref": "#/$defs/vec3"},
                            "modelPath": {"type": "string", "minLength": 1},
                            "materialOverride": {"type": "string"},
                            "fov": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 179},
                            "near_clip": {"type": "number", "exclusiveMinimum": 0},
                            "far_clip": {"type": "number", "exclusiveMinimum": 0},
                            "autoActivate": {"type": "boolean"},
                            "priority": {"type": "integer", "minimum": -100000, "maximum": 100000},
                            "color": {"$ref": "#/$defs/vec3"},
                            "intensity": {"type": "number", "minimum": 0, "maximum": 1e12},
                            "visible": {"type": "boolean"},
                            "coneAngleInner": {"type": "number", "minimum": 0, "exclusiveMaximum": 90},
                            "coneAngleOuter": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90},
                            "targetArmLength": {"type": "number", "minimum": 0, "maximum": 100000},
                            "socketOffset": {"$ref": "#/$defs/vec3"},
                            "targetOffset": {"$ref": "#/$defs/vec3"},
                            "useCameraLagSubstepping": {"type": "boolean"},
                            "cameraLagMaxTimeStep": {"type": "number", "minimum": 0.005, "maximum": 0.5},
                            "probeRadius": {"type": "number", "minimum": 0, "maximum": 100000},
                            "doCollisionTest": {"type": "boolean"},
                            "collisionMask": {"type": "integer", "minimum": 0, "maximum": 65535},
                            "enableCameraLag": {"type": "boolean"},
                            "cameraLagSpeed": {"type": "number", "minimum": 0, "maximum": 1000},
                            "cameraLagMaxDistance": {"type": "number", "minimum": 0, "maximum": 100000},
                            "enableCameraRotationLag": {"type": "boolean"},
                            "cameraRotationLagSpeed": {"type": "number", "minimum": 0, "maximum": 1000},
                            "usePawnControlRotation": {"type": "boolean"},
                            "inheritPitch": {"type": "boolean"},
                            "inheritYaw": {"type": "boolean"},
                            "inheritRoll": {"type": "boolean"},
                            "absoluteRotation": {"type": "boolean"},
                            "rotationOffset": {"$ref": "#/$defs/vec3"},
                            "drawDebug": {"type": "boolean"},
                            "collision": {"$ref": "#/$defs/blueprintPrimitiveCollision"}
                        },
                        "additionalProperties": false
                    }
                },
                "components": {
                    "type": "array", "maxItems": 128,
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\|\\u0000]+$"},
                            "parent": {"type": "string"},
                            "type": { "enum": ["scene", "mesh", "camera", "springArm", "pointLight", "spotLight", "directionalLight"] },
                            "position": {"$ref": "#/$defs/vec3"},
                            "rotation": {"$ref": "#/$defs/vec3"},
                            "scale": {"$ref": "#/$defs/vec3"},
                            "modelPath": { "type": "string", "minLength": 1 },
                            "materialOverride": { "type": "string", "minLength": 1 },
                            "fov": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 179},
                            "near_clip": {"type": "number", "exclusiveMinimum": 0},
                            "far_clip": {"type": "number", "exclusiveMinimum": 0},
                            "autoActivate": {"type": "boolean"},
                            "priority": {"type": "integer", "minimum": -100000, "maximum": 100000},
                            "color": {"$ref": "#/$defs/vec3"},
                            "intensity": {"type": "number", "minimum": 0, "maximum": 1e12},
                            "intensityUnit": {"enum": ["lux", "cd"]},
                            "visible": {"type": "boolean"},
                            "coneAngleInner": {"type": "number", "minimum": 0, "exclusiveMaximum": 90},
                            "coneAngleOuter": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90},
                            "targetArmLength": {"type": "number", "minimum": 0, "maximum": 100000},
                            "socketOffset": {"$ref": "#/$defs/vec3"},
                            "targetOffset": {"$ref": "#/$defs/vec3"},
                            "useCameraLagSubstepping": {"type": "boolean"},
                            "cameraLagMaxTimeStep": {"type": "number", "minimum": 0.005, "maximum": 0.5},
                            "probeRadius": {"type": "number", "minimum": 0, "maximum": 100000},
                            "doCollisionTest": {"type": "boolean"},
                            "collisionMask": {"type": "integer", "minimum": 0, "maximum": 65535},
                            "enableCameraLag": {"type": "boolean"},
                            "cameraLagSpeed": {"type": "number", "minimum": 0, "maximum": 1000},
                            "cameraLagMaxDistance": {"type": "number", "minimum": 0, "maximum": 100000},
                            "enableCameraRotationLag": {"type": "boolean"},
                            "cameraRotationLagSpeed": {"type": "number", "minimum": 0, "maximum": 1000},
                            "usePawnControlRotation": {"type": "boolean"},
                            "inheritPitch": {"type": "boolean"},
                            "inheritYaw": {"type": "boolean"},
                            "inheritRoll": {"type": "boolean"},
                            "absoluteRotation": {"type": "boolean"},
                            "rotationOffset": {"$ref": "#/$defs/vec3"},
                            "drawDebug": {"type": "boolean"}
                        },
                        "required": ["type"],
                        "if": {"type": "object", "properties": {"type": {"const": "mesh"}}},
                        "then": {"required": ["modelPath"]},
                        "allOf": [
                            {"if": {"type": "object", "properties": {"type": {"enum": ["pointLight", "spotLight"]}}},
                             "then": {"type": "object", "required": ["intensityUnit"], "properties": {"intensityUnit": {"const": "cd"}}}},
                            {"if": {"type": "object", "properties": {"type": {"const": "directionalLight"}}},
                             "then": {"type": "object", "required": ["intensityUnit"], "properties": {"intensityUnit": {"const": "lux"}}}}
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["type", "name", "id", "position", "rotation", "scale", "properties"],
            "oneOf": [
                {"required": ["class"], "not": {"anyOf": [{"required": ["blueprintPath"]}, {"required": ["componentOverrides"]}, {"required": ["scriptComponentOverrides"]}]}},
                {"required": ["blueprintPath"], "not": {"anyOf": [{"required": ["class"]}, {"required": ["components"]}, {"required": ["scriptComponents"]}, {"required": ["physics"]}]}}
            ]
        },
        "scriptProperties": {
            "type": "object", "maxProperties": 128,
            "propertyNames": {"minLength": 1, "pattern": "^[^\\u0000]+$"},
            "additionalProperties": {"$ref": "#/$defs/scriptPropertyValue"}
        },
        "scriptPropertyValue": {
            "description": "C# 类型目录校验对象字段/集合元素；原生同时限制值深度16、每容器1024项及单属性4096节点。null不允许。",
            "oneOf": [
                {"type": ["number", "string", "boolean"]},
                {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/scriptPropertyValue"}},
                {"type": "object", "maxProperties": 1024, "additionalProperties": {"$ref": "#/$defs/scriptPropertyValue"}}
            ]
        },
        "scriptComponent": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\|\\u0000]+$"},
                "class": {"type": "string", "minLength": 1},
                "enabled": {"type": "boolean"},
                "properties": {"$ref": "#/$defs/scriptProperties"},
                "instanceEditable": {
                    "type": "array", "maxItems": 128, "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                }
            },
            "required": ["id", "class", "properties"],
            "additionalProperties": false
        },
        "blueprintPhysics": {
            "type": "object",
            "properties": {
                "motion": {"enum": ["static", "dynamic", "kinematic", "character"]},
                "shape": {"enum": ["box", "sphere", "capsule", "mesh", "compound"]},
                "component": {"type": "string", "minLength": 1},
                "collisionLayer": {"type": "integer", "minimum": 0, "maximum": 15},
                "collisionMask": {"type": "integer", "minimum": 0, "maximum": 65535},
                "shapes": {
                    "type": "array", "minItems": 1, "maxItems": 128,
                    "items": {
                        "type": "object",
                        "properties": {
                            "component": {"type": "string", "minLength": 1},
                            "shape": {"enum": ["box", "sphere", "capsule"]},
                            "halfExtents": {"$ref": "#/$defs/vec3"},
                            "radius": {"type": "number", "exclusiveMinimum": 0},
                            "halfHeight": {"type": "number", "exclusiveMinimum": 0}
                        },
                        "required": ["component"], "additionalProperties": false
                    }
                },
                "constraints": {
                    "type": "array", "maxItems": 32,
                    "items": {"$ref": "#/$defs/blueprintConstraint"}
                },
                "halfExtents": {"$ref": "#/$defs/vec3"},
                "radius": {"type": "number", "exclusiveMinimum": 0},
                "halfHeight": {"type": "number", "exclusiveMinimum": 0},
                "trigger": {"type": "boolean"},
                "stepHeight": {"type": "number", "minimum": 0},
                "jumpSpeed": {"type": "number", "minimum": 0},
                "maxSlopeAngle": {"type": "number", "minimum": 0, "exclusiveMaximum": 90},
                "mass": {"type": "number", "exclusiveMinimum": 0},
                "friction": {"type": "number", "minimum": 0},
                "restitution": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
        },
        "blueprintPrimitiveCollision": {
            "type": "object",
            "properties": {
                "shape": {"enum": ["box", "sphere", "capsule"]},
                "halfExtents": {"$ref": "#/$defs/vec3"},
                "radius": {"type": "number", "exclusiveMinimum": 0},
                "halfHeight": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
        },
        "blueprintConstraint": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"enum": ["fixed", "hinge"]},
                "target": {"type": "string", "minLength": 1},
                "anchor": {"$ref": "#/$defs/vec3"},
                "axis": {"$ref": "#/$defs/vec3"},
                "minAngle": {"type": "number", "minimum": -180, "maximum": 0},
                "maxAngle": {"type": "number", "minimum": 0, "maximum": 180}
            },
            "required": ["id", "type", "target", "anchor"],
            "allOf": [{"if": {"properties": {"type": {"const": "hinge"}}}, "then": {"required": ["axis"]}}],
            "additionalProperties": false
        },
        "vec3": {
            "type": "array",
            "description": "长度为 3 的数值数组。验证器拒绝长度不为 3 或含非数值项的输入。",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        },
        "nameAndType": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "type"
            ]
        },
        "meshObject": {
            "type": "object",
            "description": "网格实例。sceneObjectIdentity 在运行期用于把同一场景对象的多个 section 聚合成大纲的一行。  每个对象类型是自包含的：name 与 type 直接列出，additionalProperties: false 只出现一次。不要改成 allOf[nameAndType, ...] 的组合 —— 两半各自声明 additionalProperties: false 时会把对方的字段判为额外字段，导致没有任何对象能匹配任何分支（2026-10-11 实测过）。 验证器只读取已知字段、不拒绝额外字段（SceneAssetValidator 用 contains()/value() 读取），因此这里允许额外字段：schema 不能比代码更严，否则会拒绝引擎实际接受的场景。",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "const": "mesh"
                },
                "modelPath": {
                    "type": "string",
                    "description": "网格描述文件路径，相对 resourcePath，例如 'Common/Meshes/SM_axis.json'。"
                },
                "materialOverride": {
                    "type": "string",
                    "minLength": 1,
                    "description": "可选的实例级 MI 路径，覆盖本对象全部 section 的材质，不修改 SM 槽位或导入缓存。"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                }
            },
            "required": [
                "name",
                "type",
                "modelPath",
                "position",
                "rotation",
                "scale"
            ]
        },
        "balloonObject": {
            "type": "object",
            "description": "运行时橡皮膜气球。球壳、压力、破裂拓扑和软片都在运行时生成；materialInstance 必须是可加载的 MI 资源路径。",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "const": "balloon"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                },
                "materialInstance": {
                    "type": "string",
                    "minLength": 1
                },
                "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "thickness": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "subdivisions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                },
                "siteCount": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 64
                },
                "pressure": {
                    "type": "number",
                    "minimum": 0
                },
                "burstStrain": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "restContraction": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                },
                "seed": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "scale",
                "materialInstance",
                "radius",
                "thickness",
                "subdivisions",
                "siteCount",
                "pressure",
                "burstStrain",
                "restContraction",
                "seed"
            ]
        },
        "glassPaneObject": {
            "type": "object",
            "description": "运行时玻璃板。完整板、冲击点局部 Voronoi 碎片和落地二次碎裂都在运行时生成；width/height 是板面尺寸，thickness 是板厚，单位与场景一致。",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "const": "glassPane"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                },
                "materialInstance": {
                    "type": "string",
                    "minLength": 1
                },
                "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "thickness": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "siteCount": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 64
                },
                "seed": {
                    "type": "integer",
                    "minimum": 0
                },
                "subfracture": {
                    "type": "boolean"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "scale",
                "materialInstance",
                "width",
                "height",
                "thickness",
                "siteCount",
                "seed"
            ]
        },
        "directionalLightObject": {
            "type": "object",
            "description": "方向光。场景中第一个有效方向光成为主方向光，并被同步为程序化天空的太阳方向。  每个对象类型是自包含的：name 与 type 直接列出，additionalProperties: false 只出现一次。不要改成 allOf[nameAndType, ...] 的组合 —— 两半各自声明 additionalProperties: false 时会把对方的字段判为额外字段，导致没有任何对象能匹配任何分支（2026-10-11 实测过）。 验证器只读取已知字段、不拒绝额外字段（SceneAssetValidator 用 contains()/value() 读取），因此这里允许额外字段：schema 不能比代码更严，否则会拒绝引擎实际接受的场景。",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "const": "directionalLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/vec3"
                },
                "intensity": {
                    "type": "number",
                    "description": "无量纲辐照度系数。场景文件中不存在单位字段：源码里没有 intensityUnit 这个概念（在 source/ 全树搜索零命中）。"
                },
                "shadow": {
                    "$ref": "#/$defs/directionalShadow"
                },
                "intensityUnit": {
                    "type": "string",
                    "enum": [
                        "lux"
                    ],
                    "description": "光度单位。方向光用 lux；点/聚/面光用 cd 或 lm。校验在 ReadCanonicalLightIntensity，缺失或单位不符都会被拒绝。"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity",
                "intensityUnit"
            ],
            "additionalProperties": false
        },
        "pointLightObject": {
            "type": "object",
            "description": "每个对象类型是自包含的：name 与 type 直接列出，additionalProperties: false 只出现一次。不要改成 allOf[nameAndType, ...] 的组合 —— 两半各自声明 additionalProperties: false 时会把对方的字段判为额外字段，导致没有任何对象能匹配任何分支（2026-10-11 实测过）。 验证器只读取已知字段、不拒绝额外字段（SceneAssetValidator 用 contains()/value() 读取），因此这里允许额外字段：schema 不能比代码更严，否则会拒绝引擎实际接受的场景。",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "const": "pointLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/vec3"
                },
                "intensity": {
                    "type": "number"
                },
                "radius": {
                    "type": "number",
                    "default": 0.0,
                    "description": "可选。loader 用 node.value(\"radius\", 0.0f) 读取，缺失时为 0。验证器不要求该字段。"
                },
