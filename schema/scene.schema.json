{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/scene.schema.json",
    "title": "Scene",
    "description": "VulkanLearn 场景配置",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "const": "scene"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "worldUnit": {
            "type": "string",
            "const": "cm",
            "description": "场景位置、尺寸、裁剪面和导入后的世界长度均使用厘米。"
        },
        "objects": {
            "type": "array",
            "items": {
                "oneOf": [
                    { "$ref": "#/$defs/meshObject" },
                    { "$ref": "#/$defs/directionalLightObject" },
                    { "$ref": "#/$defs/pointLightObject" },
                    { "$ref": "#/$defs/spotLightObject" },
                    { "$ref": "#/$defs/squareAreaLightObject" },
                    { "$ref": "#/$defs/cameraObject" },
                    { "$ref": "#/$defs/environmentObject" }
                ]
            }
        }
    },
    "required": [
        "name",
        "type",
        "description",
        "worldUnit",
        "objects"
    ],
    "additionalProperties": false,
    "$defs": {
        "vec3": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        },
        "lightColor": {
            "$ref": "#/$defs/vec3",
            "description": "线性 RGB 光色，范围由运行时校验限制为 [0,1]。"
        },
        "directionalShadow": {
            "type": "object",
            "properties": {
                "castShadows": { "type": "boolean" },
                "dynamicShadowDistance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "厘米制阴影距离。Bias 与各类 fraction 仍为无量纲参数。"
                },
                "dynamicShadowCascades": { "type": "integer", "minimum": 1, "maximum": 4 },
                "cascadeDistributionExponent": { "type": "number", "minimum": 1, "maximum": 10 },
                "cascadeTransitionFraction": { "type": "number", "minimum": 0, "maximum": 1 },
                "shadowDistanceFadeoutFraction": { "type": "number", "minimum": 0, "maximum": 1 },
                "shadowBias": { "type": "number", "minimum": 0, "maximum": 1 },
                "shadowSlopeBias": { "type": "number", "minimum": 0, "maximum": 1 },
                "shadowCascadeBiasDistribution": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
        },
        "exposure": {
            "type": "object",
            "properties": {
                "mode": {
                    "enum": [
                        "ev100",
                        "physical",
                        "auto"
                    ]
                },
                "ev100": {
                    "type": "number"
                },
                "aperture": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "shutterSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "iso": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "compensation": {
                    "type": "number"
                },
                "autoMinEv100": {
                    "type": "number"
                },
                "autoMaxEv100": {
                    "type": "number"
                },
                "autoSpeedUp": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "autoSpeedDown": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "autoTargetGray": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "mode",
                "ev100",
                "aperture",
                "shutterSeconds",
                "iso",
                "compensation"
            ],
            "additionalProperties": false
        },
        "meshObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "mesh"
                },
                "modelPath": {
                    "type": "string",
                    "description": "模型描述文件路径，例如 'models/SM_xxx.json'。"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                }
            },
            "required": [
                "name",
                "type",
                "modelPath",
                "position",
                "rotation",
                "scale"
            ],
            "additionalProperties": false
        },
        "directionalLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "directionalLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/lightColor"
                },
                "intensity": {
                    "type": "number",
                    "minimum": 0
                },
                "intensityUnit": {
                    "const": "lux"
                },
                "shadow": {
                    "$ref": "#/$defs/directionalShadow"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity",
                "intensityUnit"
            ],
            "additionalProperties": false
        },
        "pointLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "pointLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/lightColor"
                },
                "intensity": {
                    "type": "number",
                    "minimum": 0
                },
                "intensityUnit": {
                    "enum": [
                        "cd",
                        "lm"
                    ]
                },
                "radius": {
                    "type": "number",
                    "minimum": 0,
                    "description": "旧字段，当前实时光照不消费；后续应迁移为有明确单位的光源几何参数。"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity",
                "intensityUnit"
            ],
            "additionalProperties": false
        },
        "spotLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "spotLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/lightColor"
                },
                "intensity": {
                    "type": "number",
                    "minimum": 0
                },
                "intensityUnit": {
                    "enum": [
                        "cd",
                        "lm"
                    ]
                },
                "radius": {
                    "type": "number",
                    "minimum": 0,
                    "description": "旧字段，当前实时光照不消费；后续应迁移为有明确单位的光源几何参数。"
                },
                "cone_angle_outer": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 90
                },
                "cone_angle_inner": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 90
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity",
                "intensityUnit",
                "cone_angle_outer",
                "cone_angle_inner"
            ],
            "additionalProperties": false
        },
        "squareAreaLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "squareAreaLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "normal": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/lightColor"
                },
                "size": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "intensity": {
                    "type": "number",
                    "minimum": 0
                },
                "intensityUnit": {
                    "enum": [
                        "cd",
                        "lm"
                    ]
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "normal",
                "color",
                "size",
                "intensity",
                "intensityUnit"
            ],
            "additionalProperties": false
        },
        "cameraObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "camera"
                },
                "fov": {
                    "type": "number"
                },
                "near_clip": {
                    "type": "number"
                },
                "far_clip": {
                    "type": "number"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                },
                "look_at": {
                    "$ref": "#/$defs/vec3"
                },
                "exposure": {
                    "$ref": "#/$defs/exposure"
                }
            },
            "required": [
                "name",
                "type",
                "fov",
                "near_clip",
                "far_clip",
                "position",
                "rotation",
                "scale",
                "exposure"
            ],
            "additionalProperties": false
        },
        "environmentObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "environment"
                },
                "environment": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "enum": [
                                "none",
                                "hdri",
                                "proceduralSky"
                            ]
                        },
                        "hdrPath": {
                            "type": "string"
                        },
                        "cubeSize": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "intensity": {
                            "type": "number",
                            "minimum": 0
                        },
                        "skyParameters": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false
                },
                "hdrPath": {
                    "type": "string"
                },
                "cubeSize": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "name",
                "type"
            ],
            "additionalProperties": false
        }
    }
}
