{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://vulkanlearn.local/schema/scene.schema.json",
    "title": "Scene",
    "description": "VulkanLearn 场景配置",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "type": {
            "type": "string",
            "const": "scene"
        },
        "objects": {
            "type": "array",
            "items": {
                "oneOf": [
                    { "$ref": "#/$defs/meshObject" },
                    { "$ref": "#/$defs/directionalLightObject" },
                    { "$ref": "#/$defs/pointLightObject" },
                    { "$ref": "#/$defs/spotLightObject" },
                    { "$ref": "#/$defs/cameraObject" },
                    { "$ref": "#/$defs/environmentObject" }
                ]
            }
        }
    },
    "required": [
        "name",
        "type",
        "objects"
    ],
    "additionalProperties": false,
    "$defs": {
        "vec3": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        },
        "meshObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "mesh"
                },
                "modelPath": {
                    "type": "string",
                    "description": "模型描述文件路径，例如 'models/SM_xxx.json'。"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                }
            },
            "required": [
                "name",
                "type",
                "modelPath",
                "position",
                "rotation",
                "scale"
            ],
            "additionalProperties": false
        },
        "directionalLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "directionalLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/vec3"
                },
                "intensity": {
                    "type": "number"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity"
            ],
            "additionalProperties": false
        },
        "pointLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "pointLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/vec3"
                },
                "intensity": {
                    "type": "number"
                },
                "radius": {
                    "type": "number",
                    "description": "当前 loader 未使用，但现有场景文件中仍有保留。"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity"
            ],
            "additionalProperties": false
        },
        "spotLightObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "spotLight"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "color": {
                    "$ref": "#/$defs/vec3"
                },
                "intensity": {
                    "type": "number"
                },
                "radius": {
                    "type": "number",
                    "description": "当前 loader 未使用，但现有场景文件中仍有保留。"
                },
                "cone_angle_outer": {
                    "type": "number"
                },
                "cone_angle_inner": {
                    "type": "number"
                }
            },
            "required": [
                "name",
                "type",
                "position",
                "rotation",
                "color",
                "intensity",
                "cone_angle_outer",
                "cone_angle_inner"
            ],
            "additionalProperties": false
        },
        "cameraObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "camera"
                },
                "fov": {
                    "type": "number"
                },
                "near_clip": {
                    "type": "number"
                },
                "far_clip": {
                    "type": "number"
                },
                "position": {
                    "$ref": "#/$defs/vec3"
                },
                "rotation": {
                    "$ref": "#/$defs/vec3"
                },
                "scale": {
                    "$ref": "#/$defs/vec3"
                }
            },
            "required": [
                "name",
                "type",
                "fov",
                "near_clip",
                "far_clip",
                "position",
                "rotation",
                "scale"
            ],
            "additionalProperties": false
        },
        "environmentObject": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "const": "environment"
                },
                "hdrPath": {
                    "type": "string"
                },
                "cubeSize": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "name",
                "type"
            ],
            "additionalProperties": false
        }
    }
}
