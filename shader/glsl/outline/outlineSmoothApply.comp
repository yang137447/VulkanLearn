#version 450
// Pass 3：归一化累加结果并写回顶点缓冲的 normal 字段。
// 累加值退化（两侧法线几乎相消）时保留原法线，避免壳塌陷。
#include "outlineSmoothContract.glsl"

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer VertFloats { float vf[]; };
layout(set = 0, binding = 1, std430) buffer RepIndex { uint rep[]; };
layout(set = 0, binding = 2, std430) buffer Accum { int accum[]; };
layout(set = 0, binding = 3, std140) uniform Params { SmoothParams params; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.vertexCount) return;

    uint slot = rep[i] * 3u;
    vec3 sum = vec3(accum[slot], accum[slot + 1u], accum[slot + 2u]);
    float len = length(sum);
    if (len <= 1e-3) return;              // 退化：保留源法线

    vec3 n = sum / len;
    uint base = i * params.strideFloats + 3u;   // 3..5 = normal
    vf[base + 0u] = n.x;
    vf[base + 1u] = n.y;
    vf[base + 2u] = n.z;
}
