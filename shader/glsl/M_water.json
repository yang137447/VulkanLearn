                    "name": "red",
                    "description": "deep-water linear red",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                },
                "y": {
                    "name": "green",
                    "description": "deep-water linear green",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                },
                "z": {
                    "name": "blue",
                    "description": "deep-water linear blue",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                }
            },
            "description": "grazing/fresnel-off water color"
