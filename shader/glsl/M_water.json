        "u_waterShallowColor": {
            "type": "vec3",
            "default": [
                0.012,
                0.055,
                0.085
            ],
            "channels": {
                "x": {
                    "name": "red",
                    "description": "fresnel-on linear red",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                },
                "y": {
                    "name": "green",
                    "description": "fresnel-on linear green",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                },
                "z": {
                    "name": "blue",
                    "description": "fresnel-on linear blue",
                    "range": {
                        "min": 0.0,
                        "max": 1.0
                    }
                }
            },
            "description": "fresnel-on water color"
        },
