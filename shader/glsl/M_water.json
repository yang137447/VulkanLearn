        },
        "u_waterSpecular": {
            "type": "float",
            "default": 0.25,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "dielectric specular scale; 0.25 gives F0=0.02, the water IOR 1.333 value"
        }
