{
    "name": "M_glassRefraction",
    "type": "material",
    "shadingModel": "Unlit",
    "shaderEvaluation": {
        "vertex": "M_glassRefraction.vertex.glsl",
        "surface": "M_glassRefraction.surface.glsl"
    },
    "features": {
        "modifiesMeshPosition": false
    },
    "renderStates": {
        "renderMode": "TransparentAlphaBlend",
        "cullMode": "Back"
    },
    "macros": {},
    "parameters": {
        "u_glassTint": {
            "type": "color",
            "default": [0.62, 0.82, 0.9, 1.0],
            "channels": {
                "x": {
                    "name": "red",
                    "description": "linear glass tint red",
                    "range": { "min": 0, "max": 1 }
                },
                "y": {
                    "name": "green",
                    "description": "linear glass tint green",
                    "range": { "min": 0, "max": 1 }
                },
                "z": {
                    "name": "blue",
                    "description": "linear glass tint blue",
                    "range": { "min": 0, "max": 1 }
                },
                "w": {
                    "name": "reserved",
                    "description": "unused; opacity is authored separately",
                    "range": { "min": 0, "max": 1 }
                }
            },
            "description": "linear tint applied to the refracted scene color"
        },
        "u_opacity": {
            "type": "float",
            "default": 0.9,
            "range": { "min": 0, "max": 1 },
            "description": "glass surface coverage; the refracted sample already contains the background"
        },
        "u_refractionStrength": {
            "type": "float",
            "default": 1.0,
            "range": { "min": 0, "max": 4 },
            "description": "screen-space scale of the physically projected refraction offset"
        },
        "u_ior": {
            "type": "float",
            "default": 1.45,
            "range": { "min": 1, "max": 2.5 },
            "description": "index of refraction; 1 is air and 1.45 is typical glass"
        },
        "u_roughness": {
            "type": "float",
            "default": 0.08,
            "range": { "min": 0, "max": 1 },
            "description": "screen-space refraction softness; 0 is a single tap"
        },
        "u_thickness": {
            "type": "float",
            "default": 18,
            "range": { "min": 0, "max": 500 },
            "description": "approximate glass thickness in world centimeters"
        },
        "u_backgroundNormalStrength": {
            "type": "float",
            "default": 0.35,
            "range": { "min": 0, "max": 1 },
            "description": "G-buffer background normal perturbation applied to the refraction offset"
        }
    },
    "textures": {}
}
