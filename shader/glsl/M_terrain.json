{
    "name": "M_terrain",
    "type": "material",
    "shadingModel": "DefaultLit",
    "renderStates": {
        "renderMode": "Opaque",
        "cullMode": "Back"
    },
    "macros": {},
    "parameters": {
        "u_uvScale": {
            "type": "float",
            "default": 64.0,
            "range": {
                "min": 0.1,
                "max": 1024.0
            },
            "description": "terrain UV tiling factor applied to all three texture arrays"
        },
        "u_pageTableSize": {
            "type": "float",
            "default": 32.0,
            "range": {
                "min": 1.0,
                "max": 32.0
            },
            "description": "global page table side in tiles; terrain texCoord1 carries the per-terrain page origin"
        },
        "u_pageResolution": {
            "type": "float",
            "default": 128.0,
            "range": {
                "min": 16.0,
                "max": 512.0
            },
            "description": "atlas page resolution in texels; atlas side = u_pageTableSize * u_pageResolution"
        },
        "u_debugMode": {
            "type": "float",
            "default": 0.0,
            "range": {
                "min": 0.0,
                "max": 5.0
            },
            "description": "0 = shaded terrain, 1 = top-4 weights, 2 = top-4 layer indices, 3 = blended albedo, 4 = VT physical page, 5 = VT mip (4/5 only affect layer-mode 1)"
        },
        "u_terrainLayerMode": {
            "type": "float",
            "default": 0.0,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "0 = legacy layerAlbedo/Normal/Pbr array fast path, 1 = layer-page-table/atlas virtual-texture path"
        },
        "u_layerPageResolution": {
            "type": "float",
            "default": 128.0,
            "range": {
                "min": 16.0,
                "max": 512.0
            },
            "description": "VT layer page resolution in texels; must match TerrainLayerPageManager::PageResolution"
        },
        "u_layerAtlasResolution": {
            "type": "float",
            "default": 4096.0,
            "range": {
                "min": 1024.0,
                "max": 8192.0
            },
            "description": "VT layer atlas slice side in texels; L2 creates 4096x4096 slices"
        },
        "u_layerPagesPerAtlasSlice": {
            "type": "float",
            "default": 1024.0,
            "range": {
                "min": 1.0,
                "max": 4096.0
            },
            "description": "physical layer pages packed into one atlas array slice (32x32 tiles)"
        },
        "u_layerTilesPerAtlasSide": {
            "type": "float",
            "default": 32.0,
            "range": {
                "min": 1.0,
                "max": 64.0
            },
            "description": "tile count per atlas slice side; physicalPage -> tileX/tileY"
        },
        "u_layerMaxMip": {
            "type": "float",
            "default": 6.0,
            "range": {
                "min": 0.0,
                "max": 6.0
            },
            "description": "maximum VT layer page-table mip; per-layer effective max is derived from catalog pagesPerSide"
        },
        "u_layerForceMip": {
            "type": "float",
            "default": -1.0,
            "range": {
                "min": -1.0,
                "max": 6.0
            },
            "description": "-1 = auto mip from derivatives; 0..6 = console debug override (terrainlayer forcemip) applied to mode 1 only"
        },
        "u_detailUvScale": {
            "type": "float",
            "default": 6.0,
            "range": {
                "min": 1.0,
                "max": 32.0
            },
            "description": "near-field detail sampling multiplier relative to the base layer UV"
        },
        "u_detailFadeStartM": {
            "type": "float",
            "default": 40.0,
            "range": {
                "min": 0.0,
                "max": 5000.0
            },
            "description": "camera distance in meters where near-field detail starts fading out"
        },
        "u_detailFadeEndM": {
            "type": "float",
            "default": 160.0,
            "range": {
                "min": 1.0,
                "max": 8000.0
            },
            "description": "camera distance in meters where near-field detail has fully faded out"
        },
        "u_detailStrength": {
            "type": "float",
            "default": 0.35,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "near-field detail albedo and normal blend strength"
        },
        "u_macroUvScale": {
            "type": "float",
            "default": 0.15,
            "range": {
                "min": 0.01,
                "max": 1.0
            },
            "description": "macro variation sampling multiplier relative to the base layer UV; far below 1 for large-scale breakup"
        },
        "u_macroStrength": {
            "type": "float",
            "default": 0.25,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "macro albedo luma modulation strength used to suppress distant tiling"
        },
        "u_globalOriginCm": {
            "type": "vec2",
            "default": [
                -201600.0,
                -201600.0
            ],
            "channels": {
                "x": {
                    "name": "originX",
                    "description": "world X of the global map's lower-left corner in cm",
                    "range": {
                        "min": -10000000.0,
                        "max": 10000000.0
                    }
                },
                "y": {
                    "name": "originZ",
                    "description": "world Z of the global map's lower-left corner in cm",
                    "range": {
                        "min": -10000000.0,
                        "max": 10000000.0
                    }
                }
            },
            "description": "world-space origin of the non-tiling global colour/mask maps"
        },
        "u_globalSizeCm": {
            "type": "float",
            "default": 403200.0,
            "range": {
                "min": 1.0,
                "max": 100000000.0
            },
            "description": "world-space side length covered by the global maps in cm"
        },
        "u_globalColourWeight": {
            "type": "float",
            "default": 0.55,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "how strongly the macro colour map tints the tiling albedo (hue only, brightness preserved)"
        },
        "u_globalColourWeightNear": {
            "type": "float",
            "default": 0.15,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "macro colour weight close to the camera; keeps tiling detail readable"
        },
        "u_globalFadeStartM": {
            "type": "float",
            "default": 40.0,
            "range": {
                "min": 0.0,
                "max": 8000.0
            },
            "description": "camera distance in metres where the macro colour starts fading in"
        },
        "u_globalFadeEndM": {
            "type": "float",
            "default": 400.0,
            "range": {
                "min": 1.0,
                "max": 20000.0
            },
            "description": "camera distance in metres where the macro colour reaches its full weight"
        },
        "u_globalAoStrength": {
            "type": "float",
            "default": 1.0,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "multiplier for the global AO channel"
        },
        "u_globalWetnessStrength": {
            "type": "float",
            "default": 0.6,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "wetness influence on roughness and albedo darkening"
        },
        "u_heightBlendStrength": {
            "type": "float",
            "default": 3.0,
            "range": {
                "min": 0.0,
                "max": 8.0
            },
            "description": "top-4 height-blend sharpening; 0 reproduces pure linear weights"
        },
        "u_terrainWeightMapMode": {
            "type": "float",
            "default": 0.0,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "0 = top-4 IDs from the baked ID/weight atlas; 1 = continuous per-layer weight array"
        }
    },
    "textures": {
        "layerTable": {
            "type": "sampler2D",
            "default": null
        },
        "pageTable": {
            "type": "sampler2D",
            "default": null
        },
        "layerIds": {
            "type": "sampler2D",
            "default": null
        },
        "layerWeights": {
            "type": "sampler2D",
            "default": null
        },
        "layerAlbedo": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerNormal": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerPbr": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerPageTable0": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable1": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable2": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable3": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable4": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable5": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerPageTable6": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerAlbedoAtlas": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "layerNormalAtlas": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "layerPbrAtlas": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "layerHeight": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "globalColour": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "globalMasks": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerWeightMaps": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        }
    },
    "shaderEvaluation": {
        "vertex": "M_terrain.vertex.glsl",
        "surface": "M_terrain.surface.glsl"
    }
}
