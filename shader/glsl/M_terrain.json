{
    "name": "M_terrain",
    "type": "material",
    "shadingModel": "DefaultLit",
    "renderStates": {
        "renderMode": "Opaque",
        "cullMode": "Back"
    },
    "macros": {"VL_TERRAIN_TESSELLATION": 0},
    "parameters": {
        "u_compositedResolution": {
            "type": "vec2",
            "default": [1024.0, 1024.0],
            "channels": {
                "x": {
                    "name": "width",
                    "description": "virtual mip zero width in texels",
                    "range": {"min": 1.0, "max": 8192.0}
                },
                "y": {
                    "name": "height",
                    "description": "virtual mip zero height in texels",
                    "range": {"min": 1.0, "max": 8192.0}
                }
            },
            "description": "virtual mip zero extent of this terrain surface"
        },
        "u_compositedMaxMip": {
            "type": "float",
            "default": 0.0,
            "description": "last virtual mip of the composited surface"
        },
        "u_compositedRepeat": {
            "type": "float",
            "default": 0.0,
            "description": "surface boundary addressing: zero clamps and one repeats"
        },
        "u_compositedNormalRG": {
            "type": "float",
            "default": 0.0,
            "description": "renderer-owned normal encoding"
        },
        "u_uvScale": {
            "type": "float",
            "default": 64.0,
            "range": {
                "min": 0.1,
                "max": 1024.0
            },
            "description": "terrain UV tiling factor applied to all three texture arrays"
        },
        "u_pageTableSize": {
            "type": "float",
            "default": 32.0,
            "range": {
                "min": 1.0,
                "max": 32.0
            },
            "description": "global page table side in tiles; terrain texCoord1 carries the per-terrain page origin"
        },
        "u_pageResolution": {
            "type": "float",
            "default": 128.0,
            "range": {
                "min": 16.0,
                "max": 512.0
            },
            "description": "atlas page resolution in texels; atlas side = u_pageTableSize * u_pageResolution"
        },
        "u_debugMode": {
            "type": "float",
            "default": 0.0,
            "range": {
                "min": 0.0,
                "max": 5.0
            },
            "description": "0 = shaded terrain, 1 = top-4 weights, 2 = top-4 layer indices, 3 = blended albedo, 4 = composite residency, 5 = composite target mip"
        },
        "u_layerDisplacementScale": {
            "type": "float",
            "default": 1.0,
            "range": {
                "min": 0.0,
                "max": 8.0
            },
            "description": "每层 displacementM 的全局倍率"
        },
        "u_detailUvScale": {
            "type": "float",
            "default": 12.0,
            "range": {
                "min": 1.0,
                "max": 32.0
            },
            "description": "near-field detail sampling multiplier relative to the base layer UV"
        },
        "u_detailFadeStartM": {
            "type": "float",
            "default": 40.0,
            "range": {
                "min": 0.0,
                "max": 5000.0
            },
            "description": "camera distance in meters where near-field detail starts fading out"
        },
        "u_detailFadeEndM": {
            "type": "float",
            "default": 160.0,
            "range": {
                "min": 1.0,
                "max": 8000.0
            },
            "description": "camera distance in meters where near-field detail has fully faded out"
        },
        "u_detailStrength": {
            "type": "float",
            "default": 0.35,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "near-field detail albedo and normal blend strength"
        },
        "u_terrainTessRadiusM": {
            "type": "float",
            "default": 60.0,
            "range": {
                "min": 0.0,
                "max": 500.0
            },
            "description": "camera radius in metres where tessellation displacement fades to the undivided mesh"
        },
        "u_terrainTessMax": {
            "type": "float",
            "default": 8.0,
            "range": {
                "min": 1.0,
                "max": 32.0
            },
            "description": "maximum quad-patch tessellation factor at the camera; outer factors still match on shared edges"
        },
        "u_terrainTessTargetPixels": {
            "type": "float",
            "default": 4.0,
            "range": {
                "min": 1.0,
                "max": 16.0
            },
            "description": "screen-space target edge length in pixels; larger values reduce distant tessellation"
        },
        "u_macroUvScale": {
            "type": "float",
            "default": 0.15,
            "range": {
                "min": 0.01,
                "max": 1.0
            },
            "description": "macro variation sampling multiplier relative to the base layer UV; far below 1 for large-scale breakup"
        },
        "u_macroStrength": {
            "type": "float",
            "default": 0.25,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "macro albedo luma modulation strength used to suppress distant tiling"
        },
        "u_globalOriginCm": {
            "type": "vec2",
            "default": [
                -201600.0,
                -201600.0
            ],
            "channels": {
                "x": {
                    "name": "originX",
                    "description": "world X of the global map's lower-left corner in cm",
                    "range": {
                        "min": -10000000.0,
                        "max": 10000000.0
                    }
                },
                "y": {
                    "name": "originZ",
                    "description": "world Z of the global map's lower-left corner in cm",
                    "range": {
                        "min": -10000000.0,
                        "max": 10000000.0
                    }
                }
            },
            "description": "world-space origin of the non-tiling global colour/mask maps"
        },
        "u_globalSizeCm": {
            "type": "float",
            "default": 403200.0,
            "range": {
                "min": 1.0,
                "max": 100000000.0
            },
            "description": "world-space side length covered by the global maps in cm"
        },
        "u_globalColourWeight": {
            "type": "float",
            "default": 0.55,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "how strongly the macro colour map tints the tiling albedo (hue only, brightness preserved)"
        },
        "u_globalColourWeightNear": {
            "type": "float",
            "default": 0.15,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "macro colour weight close to the camera; keeps tiling detail readable"
        },
        "u_globalFadeStartM": {
            "type": "float",
            "default": 40.0,
            "range": {
                "min": 0.0,
                "max": 8000.0
            },
            "description": "camera distance in metres where the macro colour starts fading in"
        },
        "u_globalFadeEndM": {
            "type": "float",
            "default": 400.0,
            "range": {
                "min": 1.0,
                "max": 20000.0
            },
            "description": "camera distance in metres where the macro colour reaches its full weight"
        },
        "u_globalAoStrength": {
            "type": "float",
            "default": 1.0,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "multiplier for the global AO channel"
        },
        "u_globalWetnessStrength": {
            "type": "float",
            "default": 0.6,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "wetness influence on roughness and albedo darkening"
        },
        "u_heightBlendStrength": {
            "type": "float",
            "default": 3.0,
            "range": {
                "min": 0.0,
                "max": 8.0
            },
            "description": "top-4 height-blend sharpening; 0 reproduces pure linear weights"
        },
        "u_terrainWeightMapMode": {
            "type": "float",
            "default": 0.0,
            "range": {
                "min": 0.0,
                "max": 1.0
            },
            "description": "0 = top-4 IDs from the baked ID/weight atlas; 1 = continuous per-layer weight array"
        }
    },
    "textures": {
        "compositedPageTable": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "compositedAlbedo": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "compositedNormal": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "compositedOrm": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "terrainHeightAtlas": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "terrainHeightLayerMap": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "terrainLayerSourceMap": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerTable": {
            "type": "sampler2D",
            "default": null
        },
        "pageTable": {
            "type": "sampler2D",
            "default": null
        },
        "layerIds": {
            "type": "sampler2D",
            "default": null
        },
        "layerWeights": {
            "type": "sampler2D",
            "default": null
        },
        "layerAlbedo": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerNormal": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerPbr": {
            "type": "sampler2DArray",
            "default": null
        },
        "layerHeight": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        },
        "globalColour": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "globalMasks": {
            "type": "sampler2D",
            "default": "Common/Textures/T_TerrainLayerPageTablePlaceholder.json"
        },
        "layerWeightMaps": {
            "type": "sampler2DArray",
            "default": "Common/Textures/T_TerrainLayerArrayPlaceholder.json"
        }
    },
    "shaderEvaluation": {
        "vertex": "M_terrain.vertex.glsl",
        "surface": "M_terrain.surface.glsl"
    }
}
