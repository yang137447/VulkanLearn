#version 450

// TressFXSimulationLengthConstraintsWind.usf -> LengthConstraintsWindAndCollision
// 的长度/风部分（源 shader 的 SDF 碰撞不在此 pass，VL 的胶囊投影是额外 pass）。
// 一个 invocation 处理一根 strand，串行执行；dispatch = ceil(guideCount / 64)。
//
// 与源实现的 groupshared 布局不同：TressFX 把同一 workgroup 的多根 strand 交错
// 放进 SharedPos，每根 strand 仍是单线程顺序执行的。VL 按 strand 独立串行，等价，
// 但少了同组内 strand 的并行度。偶数边/奇数边的分组和先后顺序保持不变：
// 每组内部的边互不共享顶点，因此组内串行与并行结果相同。
#include "tressfxSimCommon.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 1, std430) buffer CurrentPositions
{
    vec4 positions[];
} currentPositions;

layout(set = 0, binding = 2, std430) buffer PreviousPositions
{
    vec4 positions[];
} previousPositions;

// 第 i 项是 i -> i+1 的静止长度，末项 0（TressFX 的 GuidesRestLengthBuffer）。
layout(set = 0, binding = 5, std430) readonly buffer RestLengths
{
    float lengths[];
} restLengths;

// TressFX 的 ClampPositionDelta = 0.3 m；VL 使用厘米，对应 30 cm。
const float TressfxClampPositionDeltaCm = 30.0;

void main()
{
    uint guide = gl_GlobalInvocationID.x;
    if (guide >= params.counts.y)
        return;

    uint pointsPerGuide = TressfxPointsPerGuide();
    uint root = guide * pointsPerGuide;
    uint rootFixedPoints = TressfxRootFixedPoints();
    float dt = params.controls.x;

    // 风：源实现只在 Wind0 非零时启用；四路锥形风由 Host 逐帧生成。
    if (dot(params.wind0.xyz, params.wind0.xyz) > 0.0)
    {
        vec3 wind = TressfxCombinedWind(guide);
        for (uint local = rootFixedPoints; local + 1u < pointsPerGuide; ++local)
        {
            uint point = root + local;
            // v 是未归一化的段向量 pos_i - pos_{i+1}，与 TressFX 一致：
            // Force = -cross(cross(v, w), v)，结果带 |v|² 量纲且垂直于段。
            //
            // 单位适配：TressFX 在米制下积分，VL 的位置/段向量是厘米。
            // WindMagnitude 是力标量而非风速，两种单位取同一个数：三叉积的厘米
            // 结果是米结果的 1e4 倍，而厘米位移是米位移的 100 倍，故乘 1e-2。
            // 乘 1e-2 后作者幅值与 UE 属性直接可比；段长平方量纲必须保留。
            vec3 v = currentPositions.positions[point].xyz
                - currentPositions.positions[point + 1u].xyz;
            vec3 force = -cross(cross(v, wind), v) * 1.0e-2;
            currentPositions.positions[point].xyz += force * dt * dt;
        }
    }

    // TressFX 偶数边/奇数边分组的位置约束迭代。
    uint evenEdgeCount = pointsPerGuide / 2u;
    uint oddEdgeCount = (pointsPerGuide - 1u) / 2u;
    for (uint iteration = 0; iteration < params.counts.x; ++iteration)
    {
        for (uint edge = 0; edge < evenEdgeCount; ++edge)
        {
            uint point = root + 2u * edge;
            vec4 pos0 = currentPositions.positions[point];
            vec4 pos1 = currentPositions.positions[point + 1u];
            TressfxApplyDistanceConstraint(pos0, pos1, restLengths.lengths[point]);
            currentPositions.positions[point] = pos0;
            currentPositions.positions[point + 1u] = pos1;
        }
        for (uint edge = 0; edge < oddEdgeCount; ++edge)
        {
            uint point = root + 2u * edge + 1u;
            vec4 pos0 = currentPositions.positions[point];
            vec4 pos1 = currentPositions.positions[point + 1u];
            TressfxApplyDistanceConstraint(pos0, pos1, restLengths.lengths[point]);
            currentPositions.positions[point] = pos0;
            currentPositions.positions[point + 1u] = pos1;
        }
    }

    // 速度 clamp：不改当前位置，只在超限时重写 previous 位置。
    float maxDelta = TressfxClampPositionDeltaCm;
    for (uint local = 0; local < pointsPerGuide; ++local)
    {
        uint point = root + local;
        vec4 pos = currentPositions.positions[point];
        vec4 old = previousPositions.positions[point];
        vec3 delta = pos.xyz - old.xyz;
        float speedSquared = dot(delta, delta);
        if (speedSquared > maxDelta * maxDelta)
        {
            delta *= maxDelta * maxDelta / speedSquared;
            previousPositions.positions[point] = vec4(pos.xyz - delta, pos.w);
        }
    }
}
