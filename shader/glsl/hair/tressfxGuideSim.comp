#version 450

// TressFX guide 模拟 kernel：一个 invocation 独占一整根 guide，在 invocation 内按
// CPU VL::Hair::GuideSimulation::Substep 的顺序完成一次固定步积分、长度投影与弯曲约束。
// - 每根 guide 的点在同一个 invocation 内顺序读写，等价于 CPU 的 Gauss-Seidel 顺序，
//   因此相邻点之间不需要跨 invocation barrier。
// - guide 之间没有共享状态，64 根/workgroup（local_size_x=64）；dispatch 为
//   ceil(guideCount / 64)，由 Host 侧 HairSimulationPass 计算。Host 按固定步 accumulator
//   决定本帧 dispatch 次数，每次 dispatch 都传同一个 frame-start simulationTime。
// - 取舍：并行度低于 TressFX 原实现的“每点一个线程 + 多次独立的 constraint dispatch”，
//   但 guide 数量在数百到数千时已足够填满 workgroup；当 guide 数量显著增长时再评估
//   拆分为多点 kernel。当前不做该拆分，是为了让 CPU/GPU 的约束顺序可以直接对照。
// - 坐标与加速度沿用 CPU solver：位置为厘米，dt 为秒，gravity/wind 为厘米/秒²。
layout(local_size_x = 64) in;

// set 0 是独立 compute pipeline 自己的 descriptor layout，与 graphics Object Set 2 无关。
layout(std140, set = 0, binding = 0) uniform SimulationParams
{
    // xyz = 平均重力；w 未使用。
    vec4 gravity;
    // xyz = 平均风；w 未使用。每 guide 叠加有界阵风。
    vec4 wind;
    // x = fixedStep, y = damping, z = pointsPerGuide, w = rootFixedPoints。
    vec4 controls;
    // x = iterations, y = guideCount, z = pointCount, w = 对齐保留。
    uvec4 counts;
    // x = bendStiffness, y = windGust, z = windFrequency, w = frame-start simulationTime。
    vec4 motion;
} params;

// 与 graphics 绑定共用同一份 current positions（per-object SSBO，vec4.xyz=位置, w=1）。
layout(set = 0, binding = 1, std430) buffer CurrentPositions
{
    vec4 positions[];
} currentPositions;

// Verlet 的上一帧位置；同样按 vec4 存储，w 保持 1。
layout(set = 0, binding = 2, std430) buffer PreviousPositions
{
    vec4 positions[];
} previousPositions;

// 静止中心线；w 是导入的逆质量，所以 kernel 不需要额外的质量数组。
layout(set = 0, binding = 3, std430) readonly buffer RestPositions
{
    vec4 positions[];
} restPositions;

// 复刻 CPU GuideSimulation::IsFixed：根部固定点数以内的点，以及逆质量 <= 0 的点。
bool IsFixed(uint localPoint, float inverseMass)
{
    return localPoint < uint(params.controls.w) || inverseMass <= 0.0;
}

void main()
{
    // 最后一个 workgroup 可能超出 guide 数，只有这个边界检查，避免越界 dispatch；
    // 其余数据由资产校验和 CPU 侧维度检查保证。
    uint guide = gl_GlobalInvocationID.x;
    if (guide >= params.counts.y)
        return;

    // Host 的 accumulator 只在累计到 fixedStep 后才 dispatch，因此这里直接用 dt，
    // 不再对 maxDt 做 clamp；maxDt 只限制每帧进入 accumulator 的壁钟增量。
    float dt = params.controls.x;
    float dt2 = dt * dt;
    float damping = params.controls.y;
    uint pointsPerGuide = uint(params.controls.z);
    uint base = guide * pointsPerGuide;

    // 有界阵风：gust = 1 + windGust * sin(2π f t + guide * goldenRatio)。
    // t 在本帧所有子步之间不变，因此阵风是帧粒度的；|gust| <= 1 + windGust。
    float phase = float(guide) * 0.6180339;
    float gust = 1.0 + params.motion.y *
        sin(6.283185307179586 * params.motion.z * params.motion.w + phase);
    vec3 acceleration = params.gravity.xyz + params.wind.xyz * gust;

    // 第一段：Verlet 积分。固定点每个子步都从 rest 复位 current 与 previous。
    for (uint local = 0; local < pointsPerGuide; ++local)
    {
        uint point = base + local;
        if (IsFixed(local, restPositions.positions[point].w))
        {
            vec3 rest = restPositions.positions[point].xyz;
            currentPositions.positions[point] = vec4(rest, 1.0);
            previousPositions.positions[point] = vec4(rest, 1.0);
            continue;
        }
        vec3 current = currentPositions.positions[point].xyz;
        vec3 velocity = (current - previousPositions.positions[point].xyz) * damping;
        previousPositions.positions[point] = vec4(current, 1.0);
        currentPositions.positions[point] =
            vec4(current + velocity + acceleration * dt2, 1.0);
    }

    // 第二段：每次 iteration 先按 CPU ProjectLengthsForGuide 做长度投影，再按
    // ProjectBendForGuide 做局部形状约束；两者都从根到梢顺序读写同一份 positions。
    for (uint iteration = 0; iteration < params.counts.x; ++iteration)
    {
        for (uint local = 0; local + 1 < pointsPerGuide; ++local)
        {
            uint a = base + local;
            uint b = a + 1;
            vec3 delta = currentPositions.positions[b].xyz -
                currentPositions.positions[a].xyz;
            float deltaLength = length(delta);
            float restLength = length(restPositions.positions[b].xyz -
                restPositions.positions[a].xyz);
            // 与 CPU 相同：退化段（重合点或零静止长度）不参与投影。
            if (deltaLength <= 1.0e-6 || restLength <= 1.0e-6)
                continue;
            float inverseMassA = IsFixed(local, restPositions.positions[a].w)
                ? 0.0 : restPositions.positions[a].w;
            float inverseMassB = IsFixed(local + 1, restPositions.positions[b].w)
                ? 0.0 : restPositions.positions[b].w;
            float weight = inverseMassA + inverseMassB;
            if (weight <= 0.0)
                continue;
            vec3 correction = delta * ((deltaLength - restLength) / deltaLength);
            if (inverseMassA > 0.0)
                currentPositions.positions[a].xyz +=
                    correction * (inverseMassA / weight);
            if (inverseMassB > 0.0)
                currentPositions.positions[b].xyz -=
                    correction * (inverseMassB / weight);
        }

        float bendStiffness = params.motion.x;
        if (bendStiffness > 0.0)
        {
            for (uint local = 1; local + 1 < pointsPerGuide; ++local)
            {
                uint a = base + local - 1;
                uint b = base + local;
                uint c = base + local + 1;
                if (IsFixed(local, restPositions.positions[b].w))
                    continue;
                // 保存 rest 局部曲率而不是拉成直线：target 把作者曲率偏移平移到
                // 当前邻居中点上，约束只抵抗形状变化，不引入绝对位置。
                vec3 restOffset = restPositions.positions[b].xyz -
                    0.5 * (restPositions.positions[a].xyz +
                        restPositions.positions[c].xyz);
                vec3 target = 0.5 * (currentPositions.positions[a].xyz +
                    currentPositions.positions[c].xyz) + restOffset;
                currentPositions.positions[b].xyz +=
                    (target - currentPositions.positions[b].xyz) * bendStiffness;
            }
        }
    }
}
