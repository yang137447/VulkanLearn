#version 450

// 胶囊碰撞：TressFX 5.0 的 guide shader 不包含这条路径（SDF/胶囊在别的阶段），
// 这是 VL 在长度约束 pass 之后追加的显式 pass，与 Port 前单 kernel 的碰撞公式相同。
// 一个 invocation 处理一根 strand；dispatch = ceil(guideCount / 64)。
// - 只改 current positions，不改 previous，因此不产生速度冲量（无摩擦、接触偏黏）。
// - 固定点跳过：不可移动点在 integration pass 写 w = 0。
// - 胶囊按作者顺序逐个应用，重叠区域结果取决于该顺序。
#include "tressfxSimCommon.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 1, std430) buffer CurrentPositions
{
    vec4 positions[];
} currentPositions;

layout(set = 0, binding = 7, std430) readonly buffer GuideColliders
{
    GuideCollider colliders[];
} guideColliders;

// x=胶囊碰撞前最大穿透深度（厘米，正数），y=SDF；uint 位模式供 atomicMax。
layout(set = 0, binding = 16, std430) buffer PenetrationStats
{
    uint stats[];
} penetrationStats;

void main()
{
    uint guide = gl_GlobalInvocationID.x;
    if (guide >= params.counts.y)
        return;

    uint pointsPerGuide = TressfxPointsPerGuide();
    uint root = guide * pointsPerGuide;
    for (uint colliderIndex = 0; colliderIndex < params.counts.w; ++colliderIndex)
    {
        vec4 colliderA = guideColliders.colliders[colliderIndex].a;
        vec3 a = colliderA.xyz;
        vec3 b = guideColliders.colliders[colliderIndex].b.xyz;
        float radius = colliderA.w;
        vec3 ab = b - a;
        float denom = dot(ab, ab);
        for (uint local = 0; local < pointsPerGuide; ++local)
        {
            uint point = root + local;
            vec4 pos = currentPositions.positions[point];
            if (!TressfxIsMovable(pos.w))
                continue;
            // a == b 时 denom 为 0，退化为球心 a。
            float t = denom > 0.0 ? clamp(dot(pos.xyz - a, ab) / denom, 0.0, 1.0) : 0.0;
            vec3 closest = a + t * ab;
            vec3 delta = pos.xyz - closest;
            float distance = length(delta);
            if (distance < radius)
            {
                // 投影前记录真正进入胶囊内部的深度；投影后应为 0。
                atomicMax(penetrationStats.stats[0],
                    floatBitsToUint(radius - distance));
                // 与 CPU DegenerateCapsuleNormal 相同：点在轴线上时取与轴垂直的
                // 确定性方向（axis 非 Y 向用 cross(axis,+Y)，否则 cross(axis,+X)；
                // a==b 的球使用 +Y）。
                vec3 normal;
                if (distance > 1.0e-6)
                {
                    normal = delta / distance;
                }
                else
                {
                    float axisLength = length(ab);
                    if (axisLength <= 1.0e-6)
                    {
                        normal = vec3(0.0, 1.0, 0.0);
                    }
                    else
                    {
                        vec3 unitAxis = ab / axisLength;
                        vec3 reference = abs(unitAxis.y) < 0.9
                            ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                        normal = normalize(cross(unitAxis, reference));
                    }
                }
                pos.xyz = closest + normal * radius;
                currentPositions.positions[point] = pos;
            }
        }
    }
}
