        },
        "u_reloadAlternateTexture": {
            "type": "sampler2D",
            "default": "textures/T_UV_Checker.json"
        },
        "u_zReloadRetiredTexture": {
            "type": "sampler2D",
            "default": "textures/T_Viking_Room.json"
        }
