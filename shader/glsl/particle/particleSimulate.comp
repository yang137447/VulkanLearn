#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "particleCommon.glsl"
#include "particleStorageRW.glsl"

// 轻量 PCG hash：同一 index 在时间推进后得到不连续随机流，
// 避免 CPU 维护逐粒子随机种子 buffer。
uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float Random(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word & 0x00ffffffu) / 16777215.0;
}

// 3D value noise：整数格点哈希 + smoothstep 三线性插值。
// 粒子力不需要可平铺噪声，固定格点哈希足以保证同一时间步的确定性。
float HashNoiseLattice(ivec3 cell)
{
    uint hash = uint(cell.x) * 0x8da6b343u;
    hash ^= uint(cell.y) * 0xd8163841u;
    hash ^= uint(cell.z) * 0xcb1ab31fu;
    return float(Hash(hash) & 0x00ffffffu) / 16777215.0;
}

float ValueNoise3D(vec3 position)
{
    vec3 cell = floor(position);
    vec3 fraction = fract(position);
    fraction = fraction * fraction * (3.0 - 2.0 * fraction);
    ivec3 base = ivec3(cell);

    float n000 = HashNoiseLattice(base + ivec3(0, 0, 0));
    float n100 = HashNoiseLattice(base + ivec3(1, 0, 0));
    float n010 = HashNoiseLattice(base + ivec3(0, 1, 0));
    float n110 = HashNoiseLattice(base + ivec3(1, 1, 0));
    float n001 = HashNoiseLattice(base + ivec3(0, 0, 1));
    float n101 = HashNoiseLattice(base + ivec3(1, 0, 1));
    float n011 = HashNoiseLattice(base + ivec3(0, 1, 1));
    float n111 = HashNoiseLattice(base + ivec3(1, 1, 1));

    return mix(
        mix(mix(n000, n100, fraction.x),
            mix(n010, n110, fraction.x),
            fraction.y),
        mix(mix(n001, n101, fraction.x),
            mix(n011, n111, fraction.x),
            fraction.y),
        fraction.z);
}

// curl noise 由一个三分量势场求旋度得到。三个分量使用不同固定偏移，
// 避免同一噪声值在三轴上产生相关运动；这里用有限差分近似偏导。
vec3 CurlNoisePotential(vec3 position)
{
    vec3 offsetX = vec3(0.0, 0.0, 0.0);
    vec3 offsetY = vec3(37.1, 11.7, 71.3);
    vec3 offsetZ = vec3(83.9, 47.5, 19.1);
    return vec3(
        ValueNoise3D(position + offsetX),
        ValueNoise3D(position + offsetY),
        ValueNoise3D(position + offsetZ));
}

vec3 CurlNoiseForce(vec3 position)
{
    float strength = frame.curlParams.x;
    float frequency = frame.curlParams.y;
    // 关闭状态直接返回，避免每帧为未启用的模块支付噪声与差分开销。
    if (strength <= 0.0 || frequency <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 samplePosition = position * frequency +
        vec3(0.0, 0.0, frame.simulation.z * frame.curlParams.z);
    const float epsilon = 0.01;
    vec3 x0 = CurlNoisePotential(samplePosition - vec3(epsilon, 0.0, 0.0));
    vec3 x1 = CurlNoisePotential(samplePosition + vec3(epsilon, 0.0, 0.0));
    vec3 y0 = CurlNoisePotential(samplePosition - vec3(0.0, epsilon, 0.0));
    vec3 y1 = CurlNoisePotential(samplePosition + vec3(0.0, epsilon, 0.0));
    vec3 z0 = CurlNoisePotential(samplePosition - vec3(0.0, 0.0, epsilon));
    vec3 z1 = CurlNoisePotential(samplePosition + vec3(0.0, 0.0, epsilon));
    vec3 curl = vec3(
        (y1.z - y0.z) - (z1.y - z0.y),
        (z1.x - z0.x) - (x1.z - x0.z),
        (x1.y - x0.y) - (y1.x - y0.x));
    return curl * (strength / (2.0 * epsilon));
}

// 涡旋：绕 axis 的切向力，径向中心是世界空间发射器原点或局部空间原点。
// falloff 随到轴心距离线性衰减到半径外 0，axis 与径向平行时切向未定义，
// 直接跳过，避免 normalize(0) 产生 NaN。
vec3 VortexForce(vec3 position)
{
    float strength = frame.vortexParams.x;
    float radius = frame.vortexParams.y;
    if (strength <= 0.0 || radius <= 0.0)
    {
        return vec3(0.0);
    }
    float axisLength = length(frame.vortexAxis.xyz);
    if (axisLength <= 1.0e-6)
    {
        return vec3(0.0);
    }
    vec3 axis = frame.vortexAxis.xyz / axisLength;
    vec3 center = frame.shape.z > 0.5
        ? vec3(0.0)
        : frame.localToWorld[3].xyz;
    vec3 radial = position - center;
    float distance = length(radial);
    if (distance <= 1.0e-6)
    {
        return vec3(0.0);
    }
    float falloff = clamp(1.0 - distance / radius, 0.0, 1.0);
    vec3 tangent = cross(axis, radial);
    float tangentLength = length(tangent);
    if (falloff <= 0.0 || tangentLength <= 1.0e-6)
    {
        return vec3(0.0);
    }
    return tangent / tangentLength * (strength * falloff);
}

// 点吸引子：向 attractorPosition 的径向力，使用 1 / (1 + (d/r)^2) 衰减。
vec3 AttractorForce(vec3 position)
{
    float strength = frame.attractorParams.x;
    float radius = frame.attractorParams.y;
    if (strength <= 0.0 || radius <= 0.0)
    {
        return vec3(0.0);
    }
    vec3 offset = frame.attractorPosition.xyz - position;
    float distance = length(offset);
    if (distance <= 1.0e-6)
    {
        return vec3(0.0);
    }
    float ratio = distance / radius;
    float falloff = 1.0 / (1.0 + ratio * ratio);
    return offset / distance * (strength * falloff);
}

// 世界空间解析碰撞：粒子球与无限平面/轴对齐 AABB/线段胶囊。
// 与 source/particles/particleCollision.h 的 CPU 镜像保持同一套公式。
void ResolveCollision(
    inout vec3 position,
    inout vec3 velocity,
    inout float age,
    float lifetime)
{
    int collisionType = int(frame.collisionParams.x + 0.5);
    if (collisionType == 0)
    {
        return;
    }

    float bounce = clamp(frame.collisionParams.y, 0.0, 1.0);
    float friction = clamp(frame.collisionParams.z, 0.0, 1.0);
    float radius = max(frame.collisionParams.w, 0.0);
    bool hit = false;

    if (collisionType == 1)
    {
        vec3 normal = frame.collisionPlane.xyz;
        float distance =
            dot(position, normal) - frame.collisionPlane.w - radius;
        if (distance < 0.0)
        {
            position -= normal * distance;
            float normalSpeed = dot(velocity, normal);
            if (normalSpeed < 0.0)
            {
                vec3 normalVelocity = normal * normalSpeed;
                vec3 tangentVelocity = velocity - normalVelocity;
                velocity = tangentVelocity * (1.0 - friction) -
                    normalVelocity * bounce;
            }
            hit = true;
        }
    }
    else if (collisionType == 2)
    {
        vec3 expandedMin = frame.collisionBoxMin.xyz - vec3(radius);
        vec3 expandedMax = frame.collisionBoxMax.xyz + vec3(radius);
        if (any(lessThan(position, expandedMin)) ||
            any(greaterThan(position, expandedMax)))
        {
            return;
        }

        int axis = 0;
        bool minimumSide = true;
        float best = 3.402823466e+38;
        for (int candidate = 0; candidate < 3; ++candidate)
        {
            float toMinimum = position[candidate] - expandedMin[candidate];
            float toMaximum = expandedMax[candidate] - position[candidate];
            if (toMinimum < best)
            {
                best = toMinimum;
                axis = candidate;
                minimumSide = true;
            }
            if (toMaximum < best)
            {
                best = toMaximum;
                axis = candidate;
                minimumSide = false;
            }
        }

        vec3 normal = vec3(0.0);
        if (minimumSide)
        {
            position[axis] = expandedMin[axis];
            normal[axis] = -1.0;
        }
        else
        {
            position[axis] = expandedMax[axis];
            normal[axis] = 1.0;
        }

        float normalSpeed = dot(velocity, normal);
        vec3 normalVelocity = normal * normalSpeed;
        vec3 tangentVelocity = velocity - normalVelocity;
        float reflectedNormalSpeed = normalSpeed < 0.0
            ? -bounce * normalSpeed
            : normalSpeed;
        velocity = tangentVelocity * (1.0 - friction) +
            normal * reflectedNormalSpeed;
        hit = true;
    }
    else if (collisionType == 3)
    {
        // 胶囊：把 p 投影到线段 AB 得到最近点，再按球-球推出。
        // A/B 重合时 t=0，退化为球。
        vec3 a = frame.collisionCapsuleA.xyz;
        vec3 segment = frame.collisionCapsuleB.xyz - a;
        float segmentLengthSquared = dot(segment, segment);
        float t = 0.0;
        if (segmentLengthSquared > 1.0e-12)
        {
            t = clamp(
                dot(position - a, segment) / segmentLengthSquared,
                0.0,
                1.0);
        }
        vec3 closest = a + segment * t;
        float surfaceDistance =
            max(frame.collisionParams2.y, 0.0) + radius;
        vec3 offset = position - closest;
        float distance = length(offset);
        if (distance < surfaceDistance)
        {
            // 圆心恰在轴线上时方向未定义；沿用 +Y 稳定轴避免 NaN。
            vec3 normal = distance > 1.0e-6
                ? offset / distance
                : vec3(0.0, 1.0, 0.0);
            position = closest + normal * surfaceDistance;

            float normalSpeed = dot(velocity, normal);
            if (normalSpeed < 0.0)
            {
                vec3 normalVelocity = normal * normalSpeed;
                vec3 tangentVelocity = velocity - normalVelocity;
                velocity = tangentVelocity * (1.0 - friction) -
                    normalVelocity * bounce;
            }
            hit = true;
        }
    }

    if (hit && frame.collisionBoxMin.w > 0.5)
    {
        age = lifetime;
    }
}

// 在发射器局部空间按 shapeParams.x 的 shape code 生成 spawn 位置。
// 所有圆盘/圆柱/圆锥的 XZ 径向采样都用 sqrt(u) 半径保证面积均匀；
// sphere 用 cbrt(u) 保证体积均匀；box 三轴独立均匀采样。
// 坐标约定：cone/cylinder 沿 +Y 展开，cylinder 居中于原点；disc/ring
// 位于 XZ 平面 y=0；ring 的半径在 [innerRadius, radius] 内按面积插值。
vec3 SampleSpawnPosition(inout uint randomState)
{
    const float twoPi = 6.28318530718;
    int shapeType = int(frame.shapeParams.x + 0.5);
    float radius = max(frame.shape.x, 0.0);
    float height = max(frame.shapeParams.y, 0.0);
    float innerRadius = clamp(frame.shapeParams.z, 0.0, radius);

    if (shapeType == 0)
    {
        // 球体体积采样：方向均匀，半径按 cbrt 分布，避免粒子堆在球心。
        float cosTheta = 1.0 - 2.0 * Random(randomState);
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        float phi = twoPi * Random(randomState);
        vec3 direction = vec3(
            sinTheta * cos(phi),
            cosTheta,
            sinTheta * sin(phi));
        return direction *
            (radius * pow(Random(randomState), 1.0 / 3.0));
    }
    if (shapeType == 1)
    {
        // box：三轴在 [-extent, +extent] 内独立均匀采样。
        vec3 extent = max(frame.shapeExtent.xyz, vec3(0.0));
        return vec3(
            (Random(randomState) * 2.0 - 1.0) * extent.x,
            (Random(randomState) * 2.0 - 1.0) * extent.y,
            (Random(randomState) * 2.0 - 1.0) * extent.z);
    }

    // 其余形状先采样极角，再按各自的高度/半径规则展开 XZ 圆盘。
    float phi = twoPi * Random(randomState);
    vec2 radialDirection = vec2(cos(phi), sin(phi));
    if (shapeType == 2)
    {
        // cone：沿 +Y 从 0 到 height，横截面半径线性收缩到 0；
        // 每个高度层内部仍按 sqrt(u) 做面积均匀采样。
        float t = Random(randomState);
        float layerRadius = radius * (1.0 - t);
        return vec3(
            radialDirection.x * layerRadius * sqrt(Random(randomState)),
            height * t,
            radialDirection.y * layerRadius * sqrt(Random(randomState)));
    }
    if (shapeType == 3)
    {
        // cylinder：沿 +Y 居中于 [-height/2, +height/2]。
        float layerRadius = radius * sqrt(Random(randomState));
        return vec3(
            radialDirection.x * layerRadius,
            height * (Random(randomState) - 0.5),
            radialDirection.y * layerRadius);
    }
    if (shapeType == 4)
    {
        // disc：XZ 平面 y=0，半径按 sqrt(u) 面积均匀。
        float discRadius = radius * sqrt(Random(randomState));
        return vec3(
            radialDirection.x * discRadius,
            0.0,
            radialDirection.y * discRadius);
    }
    // ring：半径在 [innerRadius, radius] 内按面积均匀，等价于对 r² 线性
    // 插值后开方；radius=0 时结果退化为原点，不产生 NaN。
    float innerSquared = innerRadius * innerRadius;
    float outerSquared = radius * radius;
    float ringRadius =
        sqrt(mix(innerSquared, outerSquared, Random(randomState)));
    return vec3(
        radialDirection.x * ringRadius,
        0.0,
        radialDirection.y * ringRadius);
}

void SpawnParticle(
    uint index,
    inout Particle particle,
    inout uint randomState,
    bool prewarm)
{
    vec3 localPosition = SampleSpawnPosition(randomState);
    vec3 localVelocity = mix(
        frame.velocityMinLifetimeMin.xyz,
        frame.velocityMaxLifetimeMax.xyz,
        vec3(Random(randomState),
             Random(randomState),
             Random(randomState)));

    float lifetime = mix(
        frame.velocityMinLifetimeMin.w,
        frame.velocityMaxLifetimeMax.w,
        Random(randomState));
    bool burst = frame.shape.y > 0.5;
    float age = (prewarm && !burst)
        ? Random(randomState) * lifetime * 0.95
        : 0.0;

    // localSpace=true 时粒子状态保存在发射器局部空间，spawn 不做变换；
    // gravity/drag 也按局部空间作者化并在局部空间积分。其余发射器保持
    // 原来的世界空间模拟，只有顶点阶段才做 billboard 处理。
    bool localSpace = frame.shape.z > 0.5;
    vec3 simulationPosition = localSpace
        ? localPosition
        : (frame.localToWorld * vec4(localPosition, 1.0)).xyz;
    vec3 simulationVelocity = localSpace
        ? localVelocity
        : mat3(frame.localToWorld) * localVelocity;

    // prewarm: 根据随机年龄把粒子积分到“已经存在 age 秒”的状态，
    // 避免首帧整池粒子挤在发射球附近。运行时每帧仍走下面的半隐式积分。
    // 解析解：dv/dt = g - k v
    //   v(t) = g/k + (v0 - g/k) * e^{-kt}
    //   p(t) = g/k * t + (v0 - g/k) * (1 - e^{-kt}) / k
    if (prewarm && age > 0.0)
    {
        vec3 gravity = frame.gravityDrag.xyz;
        float drag = max(frame.gravityDrag.w, 0.0);
        if (drag <= 1.0e-5)
        {
            simulationPosition +=
                simulationVelocity * age + 0.5 * gravity * age * age;
            simulationVelocity += gravity * age;
        }
        else
        {
            vec3 terminal = gravity / drag;
            float decay = exp(-drag * age);
            simulationPosition += terminal * age +
                (simulationVelocity - terminal) * (1.0 - decay) / drag;
            simulationVelocity =
                terminal + (simulationVelocity - terminal) * decay;
        }
    }

    // 资产校验拒绝 localSpace + collision；这里仍显式跳过，保证局部
    // 坐标不会被误当成世界坐标求交。
    if (!localSpace)
    {
        ResolveCollision(
            simulationPosition,
            simulationVelocity,
            age,
            lifetime);
    }

    particle.positionAge = vec4(
        simulationPosition,
        age);
    particle.velocityLife = vec4(
        simulationVelocity,
        lifetime);
    // 新生成（含 prewarm）的历史点全部等于生成位置：首帧 ribbon 会退化成
    // 零长度条带，随后由每帧的历史右移逐渐拉开。
    particle.history0 = particle.positionAge;
    particle.history1 = particle.positionAge;
    particle.history2 = particle.positionAge;
    particleBuffer.particles[index] = particle;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint count =
        uint(particleBuffer.particles.length());
    if (index >= count)
    {
        return;
    }

    uint randomState = Hash(
        index * 0x9e3779b9u ^
        uint(frame.simulation.z * 1000.0) ^
        uint(frame.simulation.w > 0.5 ? 0x51ed270bu : 0u));

    Particle particle = particleBuffer.particles[index];
    if (frame.simulation.w > 0.5)
    {
        // 首帧预热只填稳态存活量：spawnRate * 平均寿命；burst 仍整池喷发。
        // spawnRate=0 的连续发射器预热后保持全池死亡，不能凭空填满。
        bool burst = frame.shape.y > 0.5;
        if (!burst)
        {
            float averageLifetime = 0.5 *
                (frame.velocityMinLifetimeMin.w +
                 frame.velocityMaxLifetimeMax.w);
            // screenParams.z 是未经过 LOD 缩放的作者 spawnRate；
            // LOD 只改连续发射。
            uint target = uint(clamp(
                frame.screenParams.z * averageLifetime,
                0.0, float(count)));
            if (index >= target)
            {
                particle.positionAge = vec4(0.0);
                particle.velocityLife = vec4(0.0);
                particle.history0 = vec4(0.0);
                particle.history1 = vec4(0.0);
                particle.history2 = vec4(0.0);
                particleBuffer.particles[index] = particle;
                return;
            }
        }
        SpawnParticle(index, particle, randomState, true);
        return;
    }

    // burst 重触发：interval>0 时跨周期整池重生；非跨周期帧保持粒子状态，
    // 已死亡的粒子不会复活。interval<=0 继续沿用一次性 burst 语义。
    bool burstEmitter = frame.shape.y > 0.5;
    float burstInterval = frame.burstParams.x;
    if (burstEmitter && burstInterval > 0.0)
    {
        float time = frame.simulation.z;
        float previousTime =
            max(time - frame.simulation.y, 0.0);
        if (floor(time / burstInterval) >
            floor(previousTime / burstInterval))
        {
            SpawnParticle(
                index,
                particle,
                randomState,
                false);
            return;
        }
    }

    if (!IsParticleAlive(particle))
    {
        // 一次性 burst 只在 prewarm 帧整池喷发；粒子死亡后保持死亡。
        // interval>0 的 burst 已在上面处理跨周期重触发，同样不补发。
        if (burstEmitter)
        {
            return;
        }
        // 发射预算按整池大小归一化；只有死亡粒子参与抽样，
        // 因此稳态存活数约为 spawnRate * averageLifetime。
        float spawnChance = clamp(
            frame.simulation.x * frame.simulation.y /
                max(float(count), 1.0),
            0.0,
            1.0);
        if (Random(randomState) < spawnChance)
        {
            SpawnParticle(
                index,
                particle,
                randomState,
                false);
        }
        return;
    }

    float deltaSeconds = frame.simulation.y;
    particle.positionAge.w += deltaSeconds;
    if (particle.positionAge.w >= particle.velocityLife.w)
    {
        particle.positionAge.w = particle.velocityLife.w;
        particleBuffer.particles[index] = particle;
        return;
    }

    // 历史右移必须在积分之前：history0 记录本帧起点，当前位置经过积分后
    // 成为下一帧的 history0。死亡分支不更新历史，避免把尸体位置写进条带。
    particle.history2 = particle.history1;
    particle.history1 = particle.history0;
    particle.history0 = particle.positionAge;

    // 模拟空间积分：世界空间发射器使用世界坐标；localSpace 发射器使用
    // 局部坐标，重力与 drag 也按局部空间解释。
    // CCD 按一帧扫过的距离拆分子步，最多 8 步；每个子步使用 dt/steps
    // 的重力与指数 drag，保持总时间一致（子步近似）。
    int collisionType = int(frame.collisionParams.x + 0.5);
    bool ccd = frame.collisionParams2.x > 0.5 && collisionType != 0;
    int steps = 1;
    if (ccd)
    {
        float stepDistance = max(frame.collisionParams.w, 0.5);
        float swept = length(particle.velocityLife.xyz) * deltaSeconds;
        steps = int(clamp(ceil(swept / stepDistance), 1.0, 8.0));
    }
    float stepSeconds = deltaSeconds / float(steps);
    float damping = exp(-frame.gravityDrag.w * stepSeconds);
    vec3 position = particle.positionAge.xyz;
    vec3 velocity = particle.velocityLife.xyz;
    float age = particle.positionAge.w;
    float lifetime = particle.velocityLife.w;
    for (int step = 0; step < steps; ++step)
    {
        // 所有力都在模拟空间累加；localSpace 发射器不会把局部位置误当
        // 世界位置。drag 作为最后的指数阻尼统一作用于重力、风、curl、
        // 涡旋和吸引子产生的速度增量。
        vec3 force = frame.gravityDrag.xyz + frame.wind.xyz;
        force += CurlNoiseForce(position);
        force += VortexForce(position);
        force += AttractorForce(position);
        velocity += force * stepSeconds;
        velocity *= damping;
        position += velocity * stepSeconds;
        ResolveCollision(
            position,
            velocity,
            age,
            lifetime);
        if (age >= lifetime)
        {
            break;
        }
    }
    particle.positionAge = vec4(position, age);
    particle.velocityLife = vec4(velocity, lifetime);
    particleBuffer.particles[index] = particle;
}
