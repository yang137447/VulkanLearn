#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "particleSoftDepth.glsl"

layout(set = 0, binding = 0) uniform sampler2D sceneDepth;
layout(set = 0, binding = 1, r32f) uniform image2D softDepthOut;

layout(std140, set = 0, binding = 2) uniform SoftDepthParams
{
    mat4 invProjection;
    // x = depth-aware blur tolerance (cm), y/z/w reserved.
    vec4 params;
} softDepthParams;

void main()
{
    ivec2 outputSize = imageSize(softDepthOut);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= outputSize.x || coord.y >= outputSize.y)
    {
        return;
    }

    vec2 outputExtent = vec2(outputSize);
    vec2 uv = (vec2(coord) + 0.5) / max(outputExtent, vec2(1.0));
    vec2 sceneSize = vec2(textureSize(sceneDepth, 0));
    vec2 texel = 1.0 / max(sceneSize, vec2(1.0));
    float tolerance = max(softDepthParams.params.x, 1.0);

    float center = ParticleViewDepthFromDeviceDepth(
        texture(sceneDepth, uv).r,
        softDepthParams.invProjection);
    float weightedDepth = 0.0;
    float totalWeight = 0.0;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            vec2 sampleUv = clamp(
                uv + vec2(x, y) * texel,
                vec2(0.0),
                vec2(1.0));
            float depth = ParticleViewDepthFromDeviceDepth(
                texture(sceneDepth, sampleUv).r,
                softDepthParams.invProjection);
            float weight = exp(-abs(depth - center) / tolerance);
            weightedDepth += depth * weight;
            totalWeight += weight;
        }
    }
    float filtered = totalWeight > 1.0e-6
        ? weightedDepth / totalWeight
        : center;
    imageStore(softDepthOut, coord, vec4(filtered, 0.0, 0.0, 0.0));
}
