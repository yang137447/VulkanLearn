{
    "name": "M_gaspGrid",
    "type": "material",
    "shadingModel": "DefaultLit",
    "shaderEvaluation": {"vertex": "M_gaspGrid.vertex.glsl", "surface": "M_gaspGrid.surface.glsl"},
    "features": {"modifiesMeshPosition": false},
    "renderStates": {"renderMode": "Opaque", "cullMode": "Back"},
    "macros": {"OBJECT_ALIGNED": 1, "DIFFERENT_TOP_COLORS": 0, "DETAILED_SURFACE": 1},
    "parameters": {
        "u_surfaceColor": {
            "type": "color", "default": [0.121569, 0.121569, 0.121569, 1],
            "description": "UE M_Grid Surface Color in linear space",
            "channels": {
                "x": {"name": "red", "description": "linear red", "range": {"min": 0, "max": 1}},
                "y": {"name": "green", "description": "linear green", "range": {"min": 0, "max": 1}},
                "z": {"name": "blue", "description": "linear blue", "range": {"min": 0, "max": 1}},
                "w": {"name": "alpha", "description": "source color alpha", "range": {"min": 0, "max": 1}}
            }
        },
        "u_gridColor": {
            "type": "color", "default": [1, 1, 1, 1],
            "description": "UE M_Grid Grid Color and grid coverage multiplier",
            "channels": {
                "x": {"name": "red", "description": "linear red", "range": {"min": 0, "max": 1}},
                "y": {"name": "green", "description": "linear green", "range": {"min": 0, "max": 1}},
                "z": {"name": "blue", "description": "linear blue", "range": {"min": 0, "max": 1}},
                "w": {"name": "coverage", "description": "grid color alpha controls grid coverage", "range": {"min": 0, "max": 1}}
            }
        },
        "u_topSurfaceColor": {
            "type": "color", "default": [0.048, 0.048, 0.048, 1],
            "description": "UE M_Grid alternate upward-facing surface color",
            "channels": {
                "x": {"name": "red", "description": "linear red", "range": {"min": 0, "max": 1}},
                "y": {"name": "green", "description": "linear green", "range": {"min": 0, "max": 1}},
                "z": {"name": "blue", "description": "linear blue", "range": {"min": 0, "max": 1}},
                "w": {"name": "alpha", "description": "source color alpha", "range": {"min": 0, "max": 1}}
            }
        },
        "u_topGridColor": {
            "type": "color", "default": [0.167708, 0.167708, 0.167708, 1],
            "description": "UE M_Grid alternate upward-facing grid color",
            "channels": {
                "x": {"name": "red", "description": "linear red", "range": {"min": 0, "max": 1}},
                "y": {"name": "green", "description": "linear green", "range": {"min": 0, "max": 1}},
                "z": {"name": "blue", "description": "linear blue", "range": {"min": 0, "max": 1}},
                "w": {"name": "coverage", "description": "upward-facing grid coverage multiplier", "range": {"min": 0, "max": 1}}
            }
        },
        "u_gridSizes": {
            "type": "vec3", "default": [100, 200, 200], "description": "three UE grid repeat sizes in centimeters",
            "channels": {
                "x": {"name": "grid1", "description": "Grid 1 Size in cm", "range": {"min": 0.001, "max": 1000000}},
                "y": {"name": "grid2", "description": "Grid 2 Size in cm", "range": {"min": 0.001, "max": 1000000}},
                "z": {"name": "grid3", "description": "Grid 3 Size in cm", "range": {"min": 0.001, "max": 1000000}}
            }
        },
        "u_detailScales": {
            "type": "vec3", "default": [512, 512, 512], "description": "paint color, roughness and normal repeat sizes in centimeters",
            "channels": {
                "x": {"name": "albedo", "description": "Albedo_Scale in cm", "range": {"min": 0.001, "max": 1000000}},
                "y": {"name": "roughness", "description": "Roughness Scale in cm", "range": {"min": 0.001, "max": 1000000}},
                "z": {"name": "normal", "description": "Normal Scale in cm", "range": {"min": 0.001, "max": 1000000}}
            }
        },
        "u_roughness": {
            "type": "vec4", "default": [0.4, 0.8, 1, 0.5], "description": "UE M_Grid roughness graph parameters",
            "channels": {
                "x": {"name": "minimum", "description": "Min Roughness", "range": {"min": 0, "max": 1}},
                "y": {"name": "maximum", "description": "Max Roughness", "range": {"min": 0, "max": 1}},
                "z": {"name": "strength", "description": "Roughness Strength, also non-detailed fallback", "range": {"min": 0, "max": 1}},
                "w": {"name": "contrast", "description": "Roughness Contrast exponent", "range": {"min": 0.001, "max": 100}}
            }
        },
        "u_normalStrength": {"type": "float", "default": 1, "description": "UE M_Grid scales tangent normal XY only", "range": {"min": 0, "max": 10}},
        "u_specular": {"type": "float", "default": 0.05, "description": "UE Base Specular", "range": {"min": 0, "max": 1}},
        "u_projectionX": {
            "type": "vec4", "default": [1, 0, 0, 0], "description": "normalized UE local X axis in VL world, and bounds-origin projection in cm",
            "channels": {
                "x": {"name": "axisX", "description": "VL world X component", "range": {"min": -1, "max": 1}},
                "y": {"name": "axisY", "description": "VL world Y component", "range": {"min": -1, "max": 1}},
                "z": {"name": "axisZ", "description": "VL world Z component", "range": {"min": -1, "max": 1}},
                "w": {"name": "origin", "description": "dot of source primitive bounds origin and this axis in cm", "range": {"min": -10000000, "max": 10000000}}
            }
        },
        "u_projectionY": {
            "type": "vec4", "default": [0, 0, 1, 0], "description": "normalized UE local Y axis in VL world, and bounds-origin projection in cm",
            "channels": {
                "x": {"name": "axisX", "description": "VL world X component", "range": {"min": -1, "max": 1}},
                "y": {"name": "axisY", "description": "VL world Y component", "range": {"min": -1, "max": 1}},
                "z": {"name": "axisZ", "description": "VL world Z component", "range": {"min": -1, "max": 1}},
                "w": {"name": "origin", "description": "dot of source primitive bounds origin and this axis in cm", "range": {"min": -10000000, "max": 10000000}}
            }
        },
        "u_projectionZ": {
            "type": "vec4", "default": [0, 1, 0, 0], "description": "normalized UE local Z axis in VL world, and bounds-origin projection in cm",
            "channels": {
                "x": {"name": "axisX", "description": "VL world X component", "range": {"min": -1, "max": 1}},
                "y": {"name": "axisY", "description": "VL world Y component", "range": {"min": -1, "max": 1}},
                "z": {"name": "axisZ", "description": "VL world Z component", "range": {"min": -1, "max": 1}},
                "w": {"name": "origin", "description": "dot of source primitive bounds origin and this axis in cm", "range": {"min": -10000000, "max": 10000000}}
            }
        }
    },
    "textures": {
        "grid1Map": {"type": "sampler2D", "default": null},
        "grid2Map": {"type": "sampler2D", "default": null},
        "grid3Map": {"type": "sampler2D", "default": null},
        "paintColorMap": {"type": "sampler2D", "default": null},
        "paintRoughnessMap": {"type": "sampler2D", "default": null},
        "paintNormalMap": {"type": "sampler2D", "default": null}
    }
}
