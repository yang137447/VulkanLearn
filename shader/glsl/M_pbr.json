{
    "name": "M_pbr",
    "type": "material",
    "shadingModel": "DefaultLit",
    "shaderEvaluation": {
        "vertex": "M_pbr.vertex.glsl",
        "surface": "M_pbr.surface.glsl"
    },
    "features": {
        "modifiesMeshPosition": false
    },
    "renderStates": {
        "renderMode": "Opaque",
        "cullMode": "Back"
    },
    "macros": {
        "USE_ALBEDO_MAP": 0,
        "USE_NORMAL_MAP": 0,
        "USE_PBR_MAP": 0,
        "USE_EMISSION_MAP": 0
    },
    "parameters": {
        "u_alphaClipThreshold": {
            "type": "float",
            "default": 0.5,
            "range": {"min": 0.0, "max": 1.0}
        },
        "u_tintColor": {
            "type": "vec4",
            "default": [1.0, 1.0, 1.0, 1.0],
            "channels": {
                "x": {"name": "red", "description": "red channel", "range": {"min": 0.0, "max": 1.0}},
                "y": {"name": "green", "description": "green channel", "range": {"min": 0.0, "max": 1.0}},
                "z": {"name": "blue", "description": "blue channel", "range": {"min": 0.0, "max": 1.0}},
                "w": {"name": "opacity", "description": "opacity channel", "range": {"min": 0.0, "max": 1.0}}
            }
        },
        "u_pbrFactors": {
            "type": "vec4",
            "default": [0.5, 0.0, 1.0, 0.0],
            "channels": {
                "x": {"name": "roughness", "description": "roughness channel", "range": {"min": 0.0, "max": 1.0}},
                "y": {"name": "metallic", "description": "metallic channel", "range": {"min": 0.0, "max": 1.0}},
                "z": {"name": "ambientOcclusion", "description": "ambient occlusion channel", "range": {"min": 0.0, "max": 1.0}},
                "w": {"name": "reserved", "description": "reserved channel", "range": {"min": 0.0, "max": 0.0}}
            }
        },
        "u_emissiveStrength": {
            "type": "float",
            "default": 1.0,
            "range": {"min": 0.0, "max": 4.0}
        }
    },
    "textures": {
        "albedoMap": {
            "type": "sampler2D",
            "default": null
        },
        "normalMap": {
            "type": "sampler2D",
            "default": null
        },
        "pbrParamMap": {
            "type": "sampler2D",
            "default": null
        },
        "emissionMap": {
            "type": "sampler2D",
            "default": null
        }
    }
