{
    "name": "M_terrainFeedback",
    "type": "material",
    "shadingModel": "Unlit",
    "renderStates": {
        "renderMode": "Opaque",
        "cullMode": "Back"
    },
    "macros": {},
    "parameters": {
        "u_pageTableSize": {
            "type": "float",
            "default": 32.0,
            "range": {"min": 1.0, "max": 32.0},
            "description": "coverage page table side; matches TerrainPageManager::PageTableSize"
        },
        "u_frameTag": {
            "type": "float",
            "default": 1.0,
            "range": {"min": 1.0, "max": 255.0},
            "description": "submitted epoch tag; zero is reserved for invalid feedback"
        },
        "u_pageResolution": {
            "type": "float",
            "default": 128.0,
            "range": {"min": 16.0, "max": 512.0},
            "description": "coverage page resolution; matches TerrainPageManager::PageResolution"
        },
        "u_feedbackScaleX": {
            "type": "float",
            "default": 1.0,
            "range": {"min": 0.1, "max": 64.0},
            "description": "main view width divided by feedback width"
        },
        "u_feedbackScaleY": {
            "type": "float",
            "default": 1.0,
            "range": {"min": 0.1, "max": 64.0},
            "description": "main view height divided by feedback height"
        }
    },
    "textures": {}
}
