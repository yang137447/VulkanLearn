{
    "name": "M_bloomPrefilter",
    "type": "material",
    "shadingModel": "Unlit",
    "renderStates": {
        "renderMode": "Opaque",
        "cullMode": "Back"
    },
    "macros": {},
    "parameters": {
        "u_bloomPrefilterParams": {
            "type": "vec4",
            "default": [
                1,
                0.5,
                12,
                1
            ],
            "description": "exposed-space bloom threshold, knee, firefly clamp, and runtime camera exposure scale",
            "channels": {
                "x": {
                    "name": "threshold",
                    "description": "bloom luminance threshold after camera exposure",
                    "range": {
                        "min": 0,
                        "max": 1
                    }
                },
                "y": {
                    "name": "knee",
                    "description": "bloom soft-knee width after camera exposure",
                    "range": {
                        "min": 0,
                        "max": 1
                    }
                },
                "z": {
                    "name": "firefliesClamp",
                    "description": "bright-pixel luminance clamp after camera exposure",
                    "range": {
                        "min": 0,
                        "max": 12
                    }
                },
                "w": {
                    "name": "exposureScale",
                    "description": "runtime camera exposure scale; overwritten from the active camera",
                    "range": {
                        "min": 0,
                        "max": 1e30
                    }
                }
            }
        },
        "u_exposureSettings": {
            "type": "vec4",
            "default": [
                0,
                0,
                0,
                0
            ],
            "description": "auto exposure enable flag and reserved exposure controls",
            "channels": {
                "x": { "name": "autoExposureEnabled", "description": "automatic exposure enable flag", "range": { "min": 0, "max": 1 } },
                "y": { "name": "reservedY", "description": "reserved exposure control", "range": { "min": 0, "max": 1 } },
                "z": { "name": "reservedZ", "description": "reserved exposure control", "range": { "min": 0, "max": 1 } },
                "w": { "name": "reservedW", "description": "reserved exposure control", "range": { "min": 0, "max": 1 } }
            }
        }
    },
    "textures": {}
}
