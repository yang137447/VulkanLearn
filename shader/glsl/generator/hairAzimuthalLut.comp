#version 450

// Hair Azimuthal LUT 只在 GPU 生成。CPU host 仅提交 contract 参数，避免生产 texel
// 与 CPU reference 形成两条无法追踪的数值 source of truth。
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2DArray outHairAzimuthalLut;

layout(std430, set = 0, binding = 1) readonly buffer GenerationParameters
{
    // x=IOR, y=fiberRadius(m)，zw 在 kernel v2 中保留给后续预滤波合同。
    vec4 contract;
} generationParameters;

const float PI = 3.14159265358979323846;
const float HALF_PI = 1.57079632679489661923;
const float ROOT_HEIGHT_LIMIT = 0.9999;
const float ROOT_RESIDUAL_TOLERANCE = 0.002;
const float ROOT_DUPLICATE_TOLERANCE = 0.001;
const float NUMERICAL_EPSILON = 1.0e-6;
const int ROOT_SEARCH_SAMPLE_COUNT = 129;
const int ROOT_REFINE_ITERATION_COUNT = 12;
const int MAX_ROOT_COUNT = 4;

float WrapAngle(float angle)
{
    return angle - 2.0 * PI * floor((angle + PI) / (2.0 * PI));
}

float HairFresnel(float cosineIncident, float relativeIor)
{
    float cosine = abs(clamp(cosineIncident, -1.0, 1.0));
    float sine = sqrt(max(1.0 - cosine * cosine, 0.0));
    float transmittedSine = sine / relativeIor;
    if (transmittedSine >= 1.0)
    {
        return 1.0;
    }
    float transmittedCosine = sqrt(max(1.0 - transmittedSine * transmittedSine, 0.0));
    float parallel =
        (relativeIor * cosine - transmittedCosine) /
        (relativeIor * cosine + transmittedCosine);
    float perpendicular =
        (cosine - relativeIor * transmittedCosine) /
        (cosine + relativeIor * transmittedCosine);
    return clamp(0.5 * (parallel * parallel + perpendicular * perpendicular), 0.0, 1.0);
}

float ComputePathAngle(uint path, float height, float thetaD, float ior)
{
    float effectiveCosine = cos(thetaD);
    float effectiveIor = sqrt(max(
        ior * ior - sin(thetaD) * sin(thetaD),
        NUMERICAL_EPSILON)) / effectiveCosine;
    float incidentGamma = asin(clamp(height, -1.0, 1.0));
    float transmittedGamma = asin(clamp(height / effectiveIor, -1.0, 1.0));
    float pathIndex = float(path);
    return 2.0 * pathIndex * transmittedGamma -
        2.0 * incidentGamma + pathIndex * PI;
}

float ComputeResidual(
    uint path,
    float height,
    float thetaD,
    float deltaPhi,
    float ior)
{
    return WrapAngle(ComputePathAngle(path, height, thetaD, ior) - deltaPhi);
}

float RefineRoot(
    uint path,
    float thetaD,
    float deltaPhi,
    float ior,
    float lowerHeight,
    float upperHeight)
{
    float lowerResidual = ComputeResidual(
        path, lowerHeight, thetaD, deltaPhi, ior);
    for (int iteration = 0; iteration < ROOT_REFINE_ITERATION_COUNT; ++iteration)
    {
        float middleHeight = 0.5 * (lowerHeight + upperHeight);
        float middleResidual = ComputeResidual(
            path, middleHeight, thetaD, deltaPhi, ior);
        if (abs(middleResidual) <= ROOT_RESIDUAL_TOLERANCE)
        {
            return middleHeight;
        }
        if (lowerResidual * middleResidual <= 0.0)
        {
            upperHeight = middleHeight;
        }
        else
        {
            lowerHeight = middleHeight;
            lowerResidual = middleResidual;
        }
    }
    return 0.5 * (lowerHeight + upperHeight);
}

float EvaluatePathDerivative(
    uint path,
    float height,
    float thetaD,
    float ior)
{
    float stepSize = 1.0e-4;
    float lowerHeight = max(-ROOT_HEIGHT_LIMIT, height - stepSize);
    float upperHeight = min(ROOT_HEIGHT_LIMIT, height + stepSize);
    return (
        ComputePathAngle(path, upperHeight, thetaD, ior) -
        ComputePathAngle(path, lowerHeight, thetaD, ior)) /
        (upperHeight - lowerHeight);
}

float EvaluateInterfaceWeight(uint path, float thetaD, float ior)
{
    float surfaceFresnel = HairFresnel(cos(thetaD), ior);
    if (path == 0u)
    {
        return surfaceFresnel;
    }
    if (path == 1u)
    {
        return (1.0 - surfaceFresnel) * (1.0 - surfaceFresnel);
    }
    float internalCosine = sqrt(max(
        1.0 - sin(thetaD) * sin(thetaD) / (ior * ior),
        0.0));
    float internalFresnel = HairFresnel(internalCosine, 1.0 / ior);
    return (1.0 - surfaceFresnel) *
        (1.0 - surfaceFresnel) * internalFresnel;
}

float EvaluatePathLength(
    uint path,
    float height,
    float thetaD,
    float ior,
    float fiberRadius)
{
    if (path == 0u)
    {
        return 0.0;
    }
    float effectiveCosine = max(cos(thetaD), 1.0e-4);
    float effectiveIor = sqrt(max(
        ior * ior - sin(thetaD) * sin(thetaD),
        NUMERICAL_EPSILON)) / effectiveCosine;
    float transmittedHeight = height / effectiveIor;
    float chordCosine = sqrt(max(
        1.0 - transmittedHeight * transmittedHeight,
        0.0));
    float baseChord = 2.0 * fiberRadius * chordCosine;
    return path == 1u ? baseChord : baseChord + 4.0 * fiberRadius * chordCosine;
}

void AccumulateRoot(
    uint path,
    float rootHeight,
    float thetaD,
    float ior,
    float fiberRadius,
    inout float response,
    inout float weightedPathLength,
    inout float azimuthalWeightSum,
    inout float interfaceWeightSum,
    inout float derivativeSum)
{
    float derivative = abs(EvaluatePathDerivative(
        path, rootHeight, thetaD, ior));
    if (derivative <= NUMERICAL_EPSILON)
    {
        return;
    }
    float azimuthalWeight = 1.0 / max(derivative, 1.0e-4);
    float interfaceWeight = EvaluateInterfaceWeight(path, thetaD, ior);
    float pathLength = EvaluatePathLength(
        path, rootHeight, thetaD, ior, fiberRadius);
    response += interfaceWeight * azimuthalWeight;
    weightedPathLength += pathLength * azimuthalWeight;
    azimuthalWeightSum += azimuthalWeight;
    interfaceWeightSum += interfaceWeight * azimuthalWeight;
    derivativeSum += derivative;
}

void main()
{
    ivec3 coordinate = ivec3(gl_GlobalInvocationID);
    ivec3 lutSize = imageSize(outHairAzimuthalLut);
    if (coordinate.x >= lutSize.x ||
        coordinate.y >= lutSize.y ||
        coordinate.z >= lutSize.z)
    {
        return;
    }

    // X 以 deltaPhi repeat；Y 仍保留 8 个 roughness slice，但 kernel v2 的
    // root/Jacobian oracle 不再用经验高斯替代真实方位根，各 slice 共享同一响应。
    float deltaPhi = (float(coordinate.x) + 0.5) /
        float(lutSize.x) * 2.0 * PI - PI;
    uint thetaDIndex = uint(coordinate.y) % 64u;
    float thetaD = (float(thetaDIndex) + 0.5) /
        64.0 * 2.0 * HALF_PI - HALF_PI;
    uint path = uint(coordinate.z);
    float ior = generationParameters.contract.x;
    float fiberRadius = generationParameters.contract.y;

    float response = 0.0;
    float weightedPathLength = 0.0;
    float azimuthalWeightSum = 0.0;
    float interfaceWeightSum = 0.0;
    float derivativeSum = 0.0;
    int rootCount = 0;
    float lastRootHeight = -2.0;
    float previousHeight = -ROOT_HEIGHT_LIMIT;
    float previousResidual = ComputeResidual(
        path, previousHeight, thetaD, deltaPhi, ior);

    for (int sampleIndex = 1;
        sampleIndex < ROOT_SEARCH_SAMPLE_COUNT && rootCount < MAX_ROOT_COUNT;
        ++sampleIndex)
    {
        float currentHeight = -ROOT_HEIGHT_LIMIT +
            2.0 * ROOT_HEIGHT_LIMIT * float(sampleIndex) /
                float(ROOT_SEARCH_SAMPLE_COUNT - 1);
        float currentResidual = ComputeResidual(
            path, currentHeight, thetaD, deltaPhi, ior);
        bool nearRoot = abs(currentResidual) <= ROOT_RESIDUAL_TOLERANCE;
        bool crossedRoot = previousResidual * currentResidual < 0.0;
        if (nearRoot || crossedRoot)
        {
            float rootHeight = nearRoot
                ? currentHeight
                : RefineRoot(
                    path,
                    thetaD,
                    deltaPhi,
                    ior,
                    previousHeight,
                    currentHeight);
            if (abs(rootHeight - lastRootHeight) > ROOT_DUPLICATE_TOLERANCE)
            {
                AccumulateRoot(
                    path,
                    rootHeight,
                    thetaD,
                    ior,
                    fiberRadius,
                    response,
                    weightedPathLength,
                    azimuthalWeightSum,
                    interfaceWeightSum,
                    derivativeSum);
                lastRootHeight = rootHeight;
                ++rootCount;
            }
        }
        previousHeight = currentHeight;
        previousResidual = currentResidual;
    }

    float pathLength = azimuthalWeightSum > 0.0
        ? weightedPathLength / azimuthalWeightSum
        : 0.0;
    float interfaceWeight = azimuthalWeightSum > 0.0
        ? interfaceWeightSum / azimuthalWeightSum
        : 0.0;
    float averageDerivative = rootCount > 0
        ? derivativeSum / float(rootCount)
        : 0.0;
    imageStore(
        outHairAzimuthalLut,
        coordinate,
        vec4(response, pathLength, interfaceWeight, averageDerivative));
}
