#version 450
#include "../common/defines.glsl"
#include "../common/cubemapFace.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inEquirectHdr;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray outCubemap;

vec2 DirectionToUv(vec3 dir)
{
    // 方向向量转经纬度 UV，用原始 equirect HDR 做采样。
    float phi = atan(dir.z, dir.x);
    float theta = acos(clamp(dir.y, -1.0, 1.0));

    vec2 uv;
    uv.x = phi / (2.0 * PI) + 0.5;
    uv.y = theta / PI;
    uv.x = fract(uv.x);
    uv.y = clamp(uv.y, 0.0, 1.0);
    return uv;
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    int faceIndex = int(gl_GlobalInvocationID.z);
    ivec3 cubeSize = imageSize(outCubemap);

    if (pixelCoord.x >= cubeSize.x || pixelCoord.y >= cubeSize.y || faceIndex >= cubeSize.z)
    {
        return;
    }

    // 每个 invocation 负责 cubemap 某个 face 的一个 texel。
    vec3 dir = GetDirectionFromFace(pixelCoord, cubeSize.xy, faceIndex);
    vec2 uv = DirectionToUv(dir);
    vec4 hdrColor = textureLod(inEquirectHdr, uv, 0.0);

    imageStore(outCubemap, ivec3(pixelCoord, faceIndex), hdrColor);
}
